<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.6.0" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />
    <!-- bUnit renders the Blazor components (Chat.razor et al.) from the referenced Shared assembly,
         so the UI layer — the day-divider/timestamps, the send flow into the converged ChatService —
         has component-level coverage, not just service-level. -->
    <PackageReference Include="bunit" Version="1.40.0" />
  </ItemGroup>

  <ItemGroup>
    <!-- bUnit brings AngleSharp 1.2.0, which has an mXSS advisory fixed in 1.5.0. Named directly so the
         fixed one wins: a test project is the one place a DOM parser is actually asked to parse markup,
         and a suppression would have left it parsing with the hole in it. -->
    <PackageReference Include="AngleSharp" Version="1.8.3" />
  </ItemGroup>

  <!--
    Deliberately references only the platform-neutral half of the sample. Anything worth a test
    belongs on this side of the line: the wire framing, the envelopes, the state machines. A platform
    head should hold nothing but the calls into that platform's radio APIs — which is what keeps an
    iOS head possible later without re-deriving the protocol, and what makes any of it testable at
    all on a build server with no phone attached.
  -->
  <ItemGroup>
    <ProjectReference Include="..\AetherNet.Sample.Shared\AetherNet.Sample.Shared.csproj" />
    <!-- The mesh implementation moved to src/AetherNet.Mesh (referenced transitively via Shared);
         expose it project-wide so the tests resolve the relocated types. -->
    <Using Include="AetherNet.Mesh" />
  </ItemGroup>

  <!--
    The pages over the service. The app's pages are tested against AetherNetService's own classes, run in this test's
    process behind the menu (Fakes/ServiceInProcess.cs). The service's tests bring the service, and the fakes those page
    tests build it from.
  -->
  <ItemGroup>
    <ProjectReference Include="..\..\..\tests\AetherNetNodeService.Host.Tests\AetherNetNodeService.Host.Tests.csproj" />
  </ItemGroup>

  <!--
    The app keeps copies of the package's data types in the package's own namespaces (its cache layer), so the service's
    assemblies come in under the alias "service": without it the same name would mean two types here.
  -->
  <Target Name="ServiceUnderItsOwnAlias" BeforeTargets="FindReferenceAssembliesForReferences;ResolveReferences">
    <ItemGroup>
      <ReferencePath Condition="$([System.String]::Copy('%(Filename)').StartsWith('AetherNet')) and '%(Filename)' != 'AetherNet.Sample.Shared'">
        <Aliases>service</Aliases>
      </ReferencePath>
    </ItemGroup>
  </Target>

</Project>
