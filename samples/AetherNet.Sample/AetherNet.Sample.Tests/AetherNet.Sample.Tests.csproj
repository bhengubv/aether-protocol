<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.12.0" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />
    <!-- bUnit renders the Blazor components (Chat.razor et al.) from the referenced Shared assembly,
         so the UI layer — the day-divider/timestamps, the send flow into the converged ChatService —
         has component-level coverage, not just service-level. -->
    <PackageReference Include="bunit" Version="1.40.0" />
  </ItemGroup>

  <ItemGroup>
    <NuGetAuditSuppress Include="https://github.com/advisories/GHSA-2m69-gcr7-jv3q" />
    <!-- Test-only transitive deps of bUnit (AngleSharp DOM parser, SourceLink git task). Moderate
         advisories, never shipped in the app — this is the test project. -->
    <NuGetAuditSuppress Include="https://github.com/advisories/GHSA-pgww-w46g-26qg" />
    <NuGetAuditSuppress Include="https://github.com/advisories/GHSA-23fw-v26w-5fgq" />
  </ItemGroup>

  <!--
    Deliberately references only the platform-neutral half of the sample. Anything worth a test
    belongs on this side of the line: the wire framing, the envelopes, the state machines. A platform
    head should hold nothing but the calls into that platform's radio APIs — which is what keeps an
    iOS head possible later without re-deriving the protocol, and what makes any of it testable at
    all on a build server with no phone attached.
  -->
  <ItemGroup>
    <ProjectReference Include="..\AetherNet.Sample.Shared\AetherNet.Sample.Shared.csproj" />
  </ItemGroup>

</Project>
