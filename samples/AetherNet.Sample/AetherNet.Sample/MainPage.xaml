<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:local="clr-namespace:AetherNet.Sample"
             xmlns:shared="clr-namespace:AetherNet.Sample.Shared;assembly=AetherNet.Sample.Shared"
             x:Class="AetherNet.Sample.MainPage"
             BackgroundColor="{AppThemeBinding Light=#ffffff, Dark=#000000}">

    <BlazorWebView x:Name="blazorWebView" HostPage="wwwroot/index.html">
        <BlazorWebView.RootComponents>
            <RootComponent Selector="#app" ComponentType="{x:Type shared:Routes}" />
        </BlazorWebView.RootComponents>
    </BlazorWebView>

</ContentPage>
