<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- allowBackup is false because the identity is sealed by a key that lives in the Keystore and is
         destroyed on uninstall. Android's backup restores the sealed blob but cannot restore the key,
         so a restored device comes back holding an identity nothing on it can ever open — and the node
         correctly refuses to mint over a sealed identity, which leaves the app unable to start at all.
         Watched on a P30 Lite 2026-08-15: two uninstalls, and a blob with a 1970 timestamp and the old
         key name kept reappearing. Backing up an identity is only meaningful with the recovery phrase
         that regenerates it, never by copying bytes the device can no longer decrypt. -->
    <application android:networkSecurityConfig="@xml/network_security_config" android:allowBackup="false" android:fullBackupContent="false" android:dataExtractionRules="@xml/data_extraction_rules" android:icon="@mipmap/appicon" android:roundIcon="@mipmap/appicon_round" android:supportsRtl="true" />
    <!-- Android 11 and later hide other apps unless an app says which ones it talks to. Aether talks to one:
         AetherNetService, by its bind action. Without this Android reported it as not installed and blocked
         the bind ("AppsFilter … BLOCKED") — invisible on the Android 10 P30, total on an Android 16 phone. -->
    <queries>
        <package android:name="com.bhengubv.aethernetservice" />
        <intent>
            <action android:name="com.bhengubv.aethernet.service.BIND" />
        </intent>
        <!-- Huawei's App launch page, opened for AetherNetService from Settings: a phone short of memory stops it,
             and only this lets the phone start it again. -->
        <package android:name="com.huawei.systemmanager" />
    </queries>
    <!-- Getting AetherNetService onto the phone ends at Android's own installer prompt; this is what lets us reach it. -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- The phone's own fingerprint sheet before the recovery words are shown (AndroidOwnerCheck). Granted at
         install, nothing to ask; without it Android refuses the sheet. -->
    <uses-permission android:name="android.permission.USE_BIOMETRIC" />

    <!-- NFC (tap-to-pair, Touch My Blood).

         Host card emulation is what lets this phone answer a tap from a phone with nothing installed
         — it presents itself as an NFC Forum Type 4 Tag, which every handset already knows how to
         read. Both are required="false": a phone without the hardware simply does not offer the
         feature, and is never shown a capability its silicon lacks. The radios — Wi-Fi Direct, Wi-Fi
         Aware, Bluetooth, LoRa — and what keeps them up are AetherNetService's, and its manifest holds
         their permissions. -->
    <uses-permission android:name="android.permission.NFC" />
    <uses-feature android:name="android.hardware.nfc" android:required="false" />
    <uses-feature android:name="android.hardware.nfc.hce" android:required="false" />

    <!-- Voice and video notes, recorded here, and the page's own camera and microphone for the picture in a call.
         The call's sound is AetherNetService's. Not required: a phone with no microphone is still a perfectly
         good mesh node. -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />
    <uses-feature android:name="android.hardware.microphone" android:required="false" />

    <!-- Video notes. The camera is only opened by the recording screen, for as long as that screen is
         on top, and is handed straight to MediaRecorder — no frame ever passes through this app. Not
         required: a phone with no camera can still send and play voice notes, and is still a perfectly
         good mesh node. -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-feature android:name="android.hardware.camera" android:required="false" />
    <uses-feature android:name="android.hardware.camera.front" android:required="false" />
    <uses-feature android:name="android.hardware.camera.autofocus" android:required="false" />
</manifest>