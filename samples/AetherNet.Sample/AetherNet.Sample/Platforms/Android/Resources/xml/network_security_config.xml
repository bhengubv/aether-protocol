<?xml version="1.0" encoding="utf-8" ?>
<!--
  Cleartext to this device and nowhere else.

  Video frames do not go through the Blazor JavaScript bridge any more. They go over a WebSocket to a
  server inside this very app, on the loopback interface, because the bridge is a single message
  channel shared with every other interop call and with Blazor's own rendering — measured at about
  four frames a second on a Redmi Note 9 before it saturated.

  Android refuses cleartext by default from API 28, which is right, and the WebView enforced it:
  net::ERR_CLEARTEXT_NOT_PERMITTED. This permits it for 127.0.0.1 alone. Nothing leaves the handset
  over that connection — it does not touch a network interface at all — and every other destination
  stays exactly as strict as it was.
-->
<network-security-config>
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">127.0.0.1</domain>
        <domain includeSubdomains="false">localhost</domain>
    </domain-config>
</network-security-config>
