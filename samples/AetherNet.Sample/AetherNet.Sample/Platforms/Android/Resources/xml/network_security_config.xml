<?xml version="1.0" encoding="utf-8" ?>
<!--
  Cleartext policy.

  Casting is an open-LAN feature: UPnP/DLNA is plain HTTP over the local network — a device description at
  http://<ip>/desc.xml, AVTransport SOAP control, and the media stream itself. Android's network security
  config has no CIDR, so it cannot scope cleartext to "the local network only"; permitting those local
  HTTP calls means permitting cleartext at the base level.

  That is acceptable here because everything that carries meaning — mesh messaging, calls, shared content —
  is already sealed at the APP layer (the Signal ratchet) before it touches any transport. Cleartext
  therefore exposes only what casting deliberately shares on your own Wi-Fi, never a conversation.

  The loopback video path (a 127.0.0.1 WebSocket carrying call frames, kept off the Blazor bridge) is
  unchanged and listed explicitly.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="true" />
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">127.0.0.1</domain>
        <domain includeSubdomains="false">localhost</domain>
    </domain-config>
</network-security-config>
