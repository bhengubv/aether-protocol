<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <base href="/" />
    <ResourcePreloader />
    <!-- No Bootstrap: Aether has its own design system in app.css, and Bootstrap's generic class
         names (.row, .card, .btn, .nav) silently override ours. Kept both heads identical. -->
    <link rel="stylesheet" href="_content/AetherNet.Sample.Shared/app.css" />
    <link rel="stylesheet" href="AetherNet.Sample.Web.styles.css" />
    <ImportMap />
    <link rel="icon" type="image/png" href="_content/AetherNet.Sample.Shared/favicon.png" />
    <HeadOutlet @rendermode="InteractiveServer" />
</head>

<body>
    <Routes @rendermode="InteractiveServer" />
    <ReconnectModal />
    <script src="@Assets["_framework/blazor.web.js"]"></script>
</body>

</html>
