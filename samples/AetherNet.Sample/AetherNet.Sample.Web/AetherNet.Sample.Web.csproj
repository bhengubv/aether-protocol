<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\AetherNet.Sample.Shared\AetherNet.Sample.Shared.csproj" />
    <!-- The mesh implementation moved to src/AetherNet.Mesh (referenced transitively via Shared);
         expose it project-wide so Program.cs and the Web components resolve the relocated types. -->
    <Using Include="AetherNet.Mesh" />
  </ItemGroup>

</Project>