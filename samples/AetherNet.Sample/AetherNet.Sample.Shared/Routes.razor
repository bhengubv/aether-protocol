@using AetherNet.Sample.Shared.Cache
@using AetherNet.Sample.Shared.Data
@using AetherNet.Sample.Shared.Pages
@using AetherNet.Sample.Shared.Services
@using AetherNetNodeService.Client
@using Microsoft.Extensions.DependencyInjection
@implements IDisposable
@inject WarmUpService Warm
@inject AetherStore Store
@inject IServiceCall Line
@inject IJSRuntime JS
@inject IServiceProvider Services

@*  The warm-up is not a page, and this is where that stops being a lie.

    It used to be a route. Every launch landed on "/", which is Home, which is drawn inside MainLayout
    — so before anything could decide the app was cold, Blazor had to activate that layout, and
    activating it constructs everything it injects: the database, chat, calls, contacts, video. Only
    then did MainLayout's own gate run and redirect to the warm-up screen.

    Which is backwards. That construction IS the work the warm-up screen exists to stand in front of,
    so the screen could not appear until the wait it covers for was already over. What a person saw
    was the boot animation vanish and a second or more of empty app-coloured screen.

    So the state comes above the router: while the app is cold there is no routing at all, and no
    layout to activate. It also closes the case a start-path could not — an aether:// link from a QR
    scan or an NFC tap enters cold on some other route, and would have hit exactly the same wall.  *@
@*  Imported by name above rather than written as <Pages.Warming />. Razor resolves a tag to a
    component only if the name is in scope, and when it is not it emits the tag as literal HTML
    instead — no error, no warning, a clean build and a blank screen. That cost a deploy.  *@
@*  And above the warm-up, AetherNetService: on a phone that has Aether alone, it is fetched first. Only where the
    platform registers the steps (Android); elsewhere the node runs in-process and there is nothing to fetch.  *@
@if (_install is { Step: not NodeInstallStep.Installed })
{
    <GetAetherNetService Flow="_install" />
}
else if (!Line.IsConnected)
{
    @*  On the device, and not reached yet. Everything below asks AetherNetService what to show, so nothing below can
        be drawn until it answers: said plainly, with the way to try again when it does not.  *@
    <div role="status" style="min-height: 100vh; display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 16px; padding: 24px; background: var(--bg); color: var(--ink); text-align: center;">
        <p style="margin: 0; font-weight: 700;">@(_unreached ?? "Reaching AetherNetService…")</p>
        @if (_unreached is not null)
        {
            <button class="about" @onclick="ReachAsync">Try again</button>
        }
    </div>
}
else if (!Warm.IsWarm)
{
    <Warming />
}
else
{
    <Router AppAssembly="typeof(Layout.MainLayout).Assembly" NotFoundPage="typeof(Pages.NotFound)">
        <Found Context="routeData">
            <RouteView RouteData="routeData" DefaultLayout="typeof(Layout.MainLayout)" />
            <FocusOnNavigate RouteData="routeData" Selector="h1" />
        </Found>
    </Router>
}

@code {
    /// <summary>
    /// Put the chosen theme on the document before the app is drawn.
    /// </summary>
    /// <remarks>
    /// Settings stamped <c>data-theme</c> when you pressed the button and nothing read it back, so a
    /// choice survived until the next launch and no further. This is the root component, so it is the
    /// first place with both the store and a JavaScript runtime — and it runs while the warm-up screen
    /// is still up, which is before there is anything themed to see.
    /// </remarks>
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender && Line.IsConnected) await ThemeAsync();

        // Lost after it was reached — AetherNetService stopped, or the phone stopped it — and not tried since: reach
        // it again. After a try that failed, the person says when to try again.
        if (!Line.IsConnected && !_reaching && _unreached is null && _install is null or { Step: NodeInstallStep.Installed })
            _ = ReachAsync();
    }

    // The choice is kept by AetherNetService, so it is read once the app has reached it.
    private async Task ThemeAsync()
    {
        try { await JS.InvokeVoidAsync("aetherTheme", Store.GetSetting(SetupKeys.Theme) ?? "system"); }
        catch { }
    }

    /// <summary>Getting AetherNetService onto the phone, where the platform has that; null where it does not.</summary>
    private NodeInstallFlow? _install;

    /// <summary>Why AetherNetService could not be reached, the last time it was tried; null while trying.</summary>
    private string? _unreached;

    private bool _reaching;

    protected override void OnInitialized()
    {
        Warm.Changed += OnChanged;
        Line.Connected += OnConnected;

        _install = Services.GetService<NodeInstallFlow>();
        if (_install is null)
        {
            _ = ReachAsync();
            return;
        }

        _install.Changed += OnInstallChanged;
        _ = LookAsync(_install);
    }

    /// <summary>
    /// Is it there? Until that is answered nothing behind starts. A look that cannot be made is no reason to stop the
    /// app: it carries on, and says what is wrong where it would have anyway.
    /// </summary>
    private async Task LookAsync(NodeInstallFlow install)
    {
        try
        {
            await install.CheckAsync();
        }
        catch (Exception)
        {
            install.Changed -= OnInstallChanged;
            _install = null;
            await ReachAsync();
        }
    }

    // On the device now, whether it was there already or was just installed: reach it.
    private void OnInstallChanged()
    {
        if (_install is { Step: NodeInstallStep.Installed } && !Line.IsConnected) _ = ReachAsync();
        OnChanged();
    }

    private async Task ReachAsync()
    {
        if (_reaching) return;
        _reaching = true;
        _unreached = null;
        try
        {
            await InvokeAsync(StateHasChanged);
            await Line.ConnectAsync();
        }
        catch (Exception ex)
        {
            _unreached = $"AetherNetService did not answer: {ex.Message}";
            await InvokeAsync(StateHasChanged);
        }
        finally
        {
            _reaching = false;
        }
    }

    // Reached, the first time or again after AetherNetService came back: the person's look first, then the app.
    private void OnConnected() => _ = InvokeAsync(async () =>
    {
        _unreached = null;
        await ThemeAsync();
        StateHasChanged();
    });

    private void OnChanged() => _ = InvokeAsync(StateHasChanged);

    public void Dispose()
    {
        Warm.Changed -= OnChanged;
        Line.Connected -= OnConnected;
        if (_install is not null) _install.Changed -= OnInstallChanged;
    }
}
