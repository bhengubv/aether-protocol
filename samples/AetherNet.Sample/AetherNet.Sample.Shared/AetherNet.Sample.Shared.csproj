<Project Sdk="Microsoft.NET.Sdk.Razor">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Components.Web" Version="10.0.0" />
    <!-- The device database: identity, contacts, settings (see Data/AetherStore.cs). -->
    <PackageReference Include="Microsoft.Data.Sqlite" Version="9.0.0" />
    <PackageReference Include="SQLitePCLRaw.bundle_e_sqlite3" Version="2.1.11" />
    <!-- QR generation only (MIT). Scanning is the phone's own camera app via the aether:// scheme —
         no camera permission, no scanning SDK, nothing from Google Play Services. -->
    <PackageReference Include="QRCoder" Version="1.6.0" />
    <!-- Opus, in pure managed C# (BSD-3-Clause). The protocol library deliberately ships no codec —
         IVoiceCodec is a seam the host fills — and this is what fills it here. Managed rather than a
         native libopus build because it needs no NDK toolchain, no per-ABI artefacts, and no second
         package: one APK, same as every other radio in this app. -->
    <PackageReference Include="Concentus" Version="2.2.2" />
  </ItemGroup>

  <!-- Carried inside the assembly as well as served from wwwroot, because the same bytes are needed
       two ways: linked by the app's own pages, and embedded into a page handed to a phone that has no
       internet at all. One file on disk, two deliveries.

       The typefaces are SIL Open Font License 1.1 (Instrument Serif, Newsreader) — the licence text
       ships beside them in wwwroot/fonts/OFL-1.1.txt, as the licence requires. -->
  <!-- CVE-2025-6965 / GHSA-2m69-gcr7-jv3q: SQLite < 3.50.2, reachable only by executing
       attacker-controlled SQL. SQLitePCLRaw has not shipped a patched bundle yet. This app runs only
       internal, fully-parameterized SQL over local device data. Same justification as
       AetherNet.Map.Sqlite / AetherNet.Content.Sqlite; TRACKED to bump when a patched bundle ships. -->
  <ItemGroup>
    <NuGetAuditSuppress Include="https://github.com/advisories/GHSA-2m69-gcr7-jv3q" />
  </ItemGroup>

  <!-- The AetherNet reference protocol (same four projects the console demo consumes).
       The Shared RCL is referenced by both heads, so the MAUI app and the Web app
       both get the live protocol with no per-head re-wiring. -->
  <ItemGroup>
    <ProjectReference Include="../../../src/AetherNet.Core/AetherNet.Core.csproj" />
    <ProjectReference Include="../../../src/AetherNet.Messaging/AetherNet.Messaging.csproj" />
    <ProjectReference Include="../../../src/AetherNet.Security/AetherNet.Security.csproj" />
    <ProjectReference Include="../../../src/AetherNet.Transport/AetherNet.Transport.csproj" />
    <!-- AetherView: the whole mesh-web as a library — model, renderer, editor, deck, wire. This app
         merely hosts it, and fills its two seams (ICardStore, IMeshLink) with a phone's answers. -->
    <ProjectReference Include="../../../src/AetherNet.Browser/AetherNet.Browser.csproj" />
    <!-- The mesh-web: content-addressed Cards + the aether:// resolver (pulls in AetherNet.Content). -->
    <ProjectReference Include="../../../src/AetherNet.Cards/AetherNet.Cards.csproj" />
    <ProjectReference Include="../../../src/AetherNet.Content/AetherNet.Content.csproj" />
    <!-- Durable content store, so hosted and collected cards survive a restart. -->
    <ProjectReference Include="../../../src/AetherNet.Content.Sqlite/AetherNet.Content.Sqlite.csproj" />
    <!-- 1:1 voice: the call state machine, signalling schema and jitter buffer. -->
    <ProjectReference Include="../../../src/AetherNet.Voice/AetherNet.Voice.csproj" />
    <!-- The Lab's "Content & files" demos drive these in-process. BitTorrent + its mesh gateway
         (/lab/torrents), the FMHY catalogue (/lab/fmhy), and the Forge package cache (/lab/forge).
         AetherNet.Content is already referenced above and backs /lab/files. -->
    <ProjectReference Include="../../../src/AetherNet.BitTorrent/AetherNet.BitTorrent.csproj" />
    <ProjectReference Include="../../../src/AetherNet.BitTorrent.Gateway/AetherNet.BitTorrent.Gateway.csproj" />
    <ProjectReference Include="../../../src/AetherNet.Fmhy/AetherNet.Fmhy.csproj" />
    <ProjectReference Include="../../../src/AetherNet.Forge/AetherNet.Forge.csproj" />
    <!-- The Lab's "Resilience & safety" screens drive these two Phase-2 extensions live in-process:
         erasure-coded distributed backup (/lab/vault) and witness-co-signed Proof-of-Location
         (/lab/location-proof). SOS and store-and-forward live in AetherNet.Core (already referenced). -->
    <ProjectReference Include="../../../src/AetherNet.Vault/AetherNet.Vault.csproj" />
    <ProjectReference Include="../../../src/AetherNet.Cartography/AetherNet.Cartography.csproj" />
    <!-- The economy layer, surfaced by the /lab demo pages. Market carries the offline P2P
         marketplace + escrow and the Proof-of-Vicinity anti-Sybil trust graph (it pulls in
         AetherNet.Space and AetherNet.Vault transitively); Tipping carries the on-device
         SDPKT-settled tipping trio (TippingService, AetherRewardService, TipperQoSService).
         The mesh TipPacket and PoV exchange primitives themselves already live in the
         AetherNet.Security / AetherNet.Core references above. -->
    <ProjectReference Include="../../../src/AetherNet.Market/AetherNet.Market.csproj" />
    <ProjectReference Include="../../../src/AetherNet.Tipping/AetherNet.Tipping.csproj" />
    <!-- The Lab's "Civic & local-first" screens drive these two Phase-2 extensions live in-process:
         geo-pinned community noticeboards (/lab/breadcrumbs) and the offline collaborative
         neighbourhood-map CRDT (/lab/map). Referenced directly so the map's CRDT toolkit and geohash
         are first-class here, not leaned on transitively. -->
    <ProjectReference Include="../../../src/AetherNet.Space/AetherNet.Space.csproj" />
    <ProjectReference Include="../../../src/AetherNet.Map/AetherNet.Map.csproj" />
    <!-- The Lab's "Live & media" screens drive AetherNet.Streaming live in-process: segment-based
         live broadcast with adaptive bitrate (/lab/broadcast), host-driven watch-together sync
         (/lab/watch-together), and full-mesh→SFU group video call-control plus 1:1 video negotiation
         (/lab/group-video). Push-to-talk audio and screen-share video (/lab/ptt-screenshare) ride the
         shared media-frame codec in AetherNet.Core, which is already referenced above. -->
    <ProjectReference Include="../../../src/AetherNet.Streaming/AetherNet.Streaming.csproj" />
  </ItemGroup>

</Project>
