<Project Sdk="Microsoft.NET.Sdk.Razor">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <!-- The mesh implementation moved to src/AetherNet.Mesh; expose it project-wide so the many
         Services/*.cs and .razor consumers resolve the relocated types without a per-file using. -->
    <Using Include="AetherNet.Mesh" />
  </ItemGroup>

  <ItemGroup>
    <!-- The menu: every request the app can make of AetherNetService, and every push it sends back. The same file
         the service is built from, so the two can never disagree about a number. -->
    <Compile Include="../../../src/AetherNetNodeService.Ipc/NodeOp.cs" Link="Cache/NodeOp.cs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Components.Web" Version="10.0.0" />
  </ItemGroup>

  <!-- No AetherNet package: the app is a thin client. Everything its pages show comes from AetherNetService through the
       menu above; the browser's scripts and typefaces are the app's own, in the app's wwwroot at
       _content/AetherNet.Browser/, the address its pages have always used. -->

</Project>
