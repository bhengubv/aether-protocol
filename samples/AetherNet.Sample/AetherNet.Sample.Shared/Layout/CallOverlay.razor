@using AetherNet.Sample.Shared.Services
@using AetherNet.Voice.Models
@implements IDisposable
@inject CallService Calls

@*
    The call, full screen, over everything.

    A call used to be a strip at the top of a chat. That is enough to prove the audio works and not
    enough to use: no way to tell how long you have been talking, no way to mute, no way to get the
    phone off the loudspeaker. Every other phone on earth gives you those three, so their absence is
    not minimalism, it is a missing feature.
*@
@if (Calls.Current is { State: CallState.Connected } && Calls.IsMinimised)
{
    @* Put away, not ended. A slim bar so the call is never something you have lost. *@
    <button class="call-bar" @onclick="Restore">
        <span class="cb-dot"></span>
        <span class="cb-who">@Peer</span>
        <span class="cb-time"><CallDuration Idle="Connected" /></span>
        <span class="cb-back">Tap to return</span>
    </button>
}
else if (Calls.Current is { } call && call.State is CallState.Outgoing or CallState.Incoming or CallState.Connected)
{
    <div class="call-screen @(call.State == CallState.Incoming ? "is-ringing" : null)">
        @* With a camera on, the picture IS the screen — it is drawn on native surfaces behind this
           overlay, so everything but the controls has to get out of its way. Painting the usual
           avatar and background over it would hide the very thing the call is now for. *@
        @* Only once connected: minimising a call that is still ringing would hide the only thing
           there is to act on. *@
        @if (call.State == CallState.Connected)
        {
            <button class="call-min" @onclick="Minimise" aria-label="Minimise the call" title="Minimise">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M6 9l6 6 6-6"/></svg>
            </button>
        }

        <div class="call-who @(ShowingVideo ? "hidden" : null)">
            <div class="call-av" style="background:@TagPalette.For(Peer)">@TagPalette.Initial(Peer)</div>
            <div class="call-tag">@Peer</div>
            <div class="call-state"><CallDuration Idle="@Waiting(call)" /></div>
        </div>

        @if (call.State == CallState.Connected)
        {
            <div class="call-actions">
                <button class="cbtn @(Calls.IsMuted ? "on" : null)" @onclick="ToggleMute"
                        title="@(Calls.IsMuted ? "Unmute" : "Mute")">
                    @if (Calls.IsMuted)
                    {
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round"><path d="M3 3l18 18"/><path d="M9 9v3a3 3 0 0 0 5.1 2.1"/><path d="M15 10V5a3 3 0 0 0-6 0v1"/><path d="M19 10a7 7 0 0 1-1.8 4.7M5 10a7 7 0 0 0 11 5.7"/></svg>
                    }
                    else
                    {
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round"><rect x="9" y="2" width="6" height="12" rx="3"/><path d="M5 10a7 7 0 0 0 14 0"/><path d="M12 17v5"/></svg>
                    }
                    <span>@(Calls.IsMuted ? "Muted" : "Mute")</span>
                </button>

                @if (Calls.CanSwitchSpeaker)
                {
                    <button class="cbtn @(Calls.SpeakerphoneOn ? "on" : null)" @onclick="ToggleSpeaker"
                            title="@(Calls.SpeakerphoneOn ? "Switch to earpiece" : "Switch to speaker")">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round"><path d="M4 9v6h4l5 4V5L8 9H4z"/>@if (Calls.SpeakerphoneOn) {<path d="M16.5 8.5a5 5 0 0 1 0 7M19 6a8.5 8.5 0 0 1 0 12"/>}</svg>
                        <span>@(Calls.SpeakerphoneOn ? "Speaker" : "Earpiece")</span>
                    </button>
                }

                @* The camera is only offered on a radio that can carry it. On a link that cannot,
                   video does not degrade — it freezes and takes the working audio down with it, so
                   the button says why rather than disappearing without explanation. *@
                <button class="cbtn @(Calls.VideoOn ? "on" : null)"
                        disabled="@(!Calls.CanSendVideo && !Calls.VideoOn)"
                        @onclick="ToggleVideo"
                        title="@(Calls.CanSendVideo || Calls.VideoOn
                            ? (Calls.VideoOn ? "Turn the camera off" : "Turn the camera on")
                            : Calls.CannotSendVideoReason)">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M23 7l-7 5 7 5V7z" /><rect x="1" y="5" width="15" height="14" rx="2" />
                        @if (!Calls.VideoOn) { <path d="M3 3l18 18" /> }
                    </svg>
                    <span>@(Calls.VideoOn ? "Camera on" : "Camera")</span>
                </button>

                @if (Calls.VideoOn)
                {
                    <button class="cbtn" @onclick="Flip" title="Front or back camera">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round"><path d="M17 2l4 4-4 4" /><path d="M3 11V9a4 4 0 0 1 4-4h14" /><path d="M7 22l-4-4 4-4" /><path d="M21 13v2a4 4 0 0 1-4 4H3" /></svg>
                        <span>Flip</span>
                    </button>
                }
            </div>
        }

        <div class="call-end @(call.State == CallState.Connected ? "connected" : null)">
            @if (call.State == CallState.Incoming)
            {
                <button class="cend answer" @onclick="Answer">Answer</button>
                <button class="cend decline" @onclick="Decline">Decline</button>
            }
            else
            {
                <button class="cend decline wide" @onclick="HangUp">Hang up</button>
            }
        </div>
    </div>
}

@code {
    private string Peer => Calls.PeerTag ?? "";

    protected override void OnInitialized() => Calls.Changed += OnChanged;

    /// <summary>
    /// Redraw when something about the call actually changes — NOT on a clock.
    ///
    /// <para>
    /// The running time used to tick here, re-rendering the whole screen once a second for the whole
    /// call. In Blazor an <c>@@onclick</c> is dispatched by a handler id that a re-render replaces, so
    /// a tap landing in the same instant as a tick was silently dropped. The duration now lives in
    /// <c>CallDuration</c>, which re-renders alone, and the buttons here are built once and left
    /// alone.
    /// </para>
    /// </summary>
    private void OnChanged() => _ = InvokeAsync(() =>
    {
        // A new call must never open behind the minimised bar of the last one.
        if (Calls.Current is null) _connectedAt = null;
        else if (Calls.Current is { State: CallState.Connected } && _connectedAt is null)
            _connectedAt = DateTime.UtcNow;

        StateHasChanged();
    });

    /// <summary>
    /// Put the call away without ending it.
    ///
    /// <para>
    /// The call keeps running — that is what the foreground service is for — and a bar stays on
    /// screen to get back to it. Without this the call screen was a trap: it covered everything for
    /// as long as the call lasted, and the only way out of it was to hang up.
    /// </para>
    /// </summary>
    private void Minimise() => Calls.SetMinimised(true);

    private void Restore() => Calls.SetMinimised(false);

    private static string Waiting(VoiceCallSession call) => call.State switch
    {
        CallState.Outgoing => "Calling…",
        CallState.Incoming => "is calling",
        CallState.Connected => "Connected",
        _ => "",
    };

    private void ToggleMute() => Calls.SetMuted(!Calls.IsMuted);

    /// <summary>
    /// Turn the camera on or off. Failing to start leaves the voice call untouched — a camera that
    /// will not open must never take a working call down with it.
    /// </summary>
    private async Task ToggleVideo() => await Calls.SetVideoAsync(!Calls.VideoOn);

    private void Flip() => Calls.SwitchCamera();

    /// <summary>True when either camera is on, and there is therefore a picture behind this.</summary>
    private bool ShowingVideo => Calls.VideoOn || Calls.TheirVideoOn;
    private void ToggleSpeaker() => Calls.SpeakerphoneOn = !Calls.SpeakerphoneOn;

    /// <summary>
    /// When this call connected here, so <see cref="HangUp"/> can ignore the tap that answered it.
    /// </summary>
    private DateTime? _connectedAt;

    /// <summary>
    /// How long Hang up ignores taps after a call connects.
    ///
    /// <para>
    /// Measured on device: the Answer button on the incoming screen sat at the same pixels as Hang up
    /// on the connected screen that replaces it. Answering therefore put a destructive control
    /// directly under a finger that was already there — and a call answered at 19:50:53 ended at
    /// 19:50:54, by the answerer, for no reason anyone could see.
    /// </para>
    ///
    /// <para>
    /// The layout no longer overlaps, which is the real fix. This is the belt: a lingering finger, a
    /// touch bounce, or an impatient second tap must not end a call somebody just took. Deliberately
    /// short — a call must always be endable, and this only ever swallows a tap that arrived before a
    /// human could have decided to send it.
    /// </para>
    /// </summary>
    private static readonly TimeSpan Settle = TimeSpan.FromMilliseconds(900);

    private Task Answer() => Calls.AnswerAsync();
    private Task Decline() => Calls.DeclineAsync();

    private Task HangUp()
    {
        if (_connectedAt is { } at && DateTime.UtcNow - at < Settle) return Task.CompletedTask;
        return Calls.HangUpAsync();
    }

    public void Dispose()
    {
        Calls.Changed -= OnChanged;
    }
}

<style>
    .call-min {
        position: absolute; top: 18px; left: 14px;
        appearance: none; border: none; background: transparent; color: var(--ink-2);
        width: 44px; height: 44px; border-radius: 50%; cursor: pointer;
        display: flex; align-items: center; justify-content: center;
    }
    .call-min svg { width: 26px; height: 26px; }
    .call-min:active { background: var(--surface-2); }

    /* The minimised call. Pinned above the tab bar so it is always reachable and never in the way. */
    .call-bar {
        position: fixed; left: 0; right: 0; bottom: 0; z-index: 950;
        appearance: none; border: none; cursor: pointer; width: 100%;
        display: flex; align-items: center; gap: 10px;
        padding: 11px 16px calc(11px + env(safe-area-inset-bottom, 0px));
        background: var(--brand); color: #fff; font-size: 0.9rem;
    }
    .cb-dot { width: 8px; height: 8px; border-radius: 50%; background: #fff; animation: cbpulse 1.6s ease-in-out infinite; }
    @@keyframes cbpulse { 0%, 100% { opacity: 1; } 50% { opacity: 0.3; } }
    .cb-who { font-family: var(--mono); font-weight: 700; }
    .cb-time { font-variant-numeric: tabular-nums; opacity: 0.9; }
    .cb-back { margin-left: auto; opacity: 0.85; }

    /* Over everything, including the tab bar — a call is the only thing happening while it happens. */
    .call-screen {
        position: fixed; inset: 0; z-index: 900;
        background: var(--bg);
        display: flex; flex-direction: column; align-items: center;
        padding: 12vh 24px 8vh;
    }

    .call-who { display: flex; flex-direction: column; align-items: center; gap: 14px; flex: 1 1 auto; }

    /* The picture is drawn on a native surface BEHIND this page, so with a camera on the screen has
       to become transparent — not merely have its avatar hidden. A solid background here would be a
       solid background over the video. The controls keep their own backdrop so they stay readable
       against whatever the camera happens to be pointing at. */
    .call-screen:has(.call-who.hidden) { background: transparent; }

    /* Transparent is not enough on its own: the call screen sits over the app, and the app is what
       was actually being seen instead of the video — the chat list, painted over the camera. The whole
       stack has to get out of the way, all the way down to the page itself, or the picture stays
       hidden behind whatever the person happened to have open. */
    html:has(.call-who.hidden),
    body:has(.call-who.hidden),
    .app:has(.call-who.hidden) { background: transparent; }

    .app:has(.call-who.hidden) > .appbar,
    .app:has(.call-who.hidden) > .viewport,
    .app:has(.call-who.hidden) > .tabbar { visibility: hidden; }
    .call-who.hidden { visibility: hidden; }
    .call-screen:has(.call-who.hidden) .call-actions,
    .call-screen:has(.call-who.hidden) .call-end {
        background: rgba(0, 0, 0, 0.45); border-radius: 18px; padding: 10px 14px; backdrop-filter: blur(6px);
    }
    .call-av {
        width: 108px; height: 108px; border-radius: 50%;
        display: flex; align-items: center; justify-content: center;
        color: #fff; font-weight: 750; font-size: 2.6rem;
    }
    .call-tag { font-family: var(--mono); font-size: 1.35rem; font-weight: 700; color: var(--ink); }
    .call-state { font-size: 1rem; color: var(--ink-2); font-variant-numeric: tabular-nums; }

    /* A ringing call breathes, so it reads as waiting rather than stuck. */
    .is-ringing .call-av { animation: callpulse 1.6s ease-in-out infinite; }
    @@keyframes callpulse {
        0%, 100% { box-shadow: 0 0 0 0 var(--brand-tint); }
        50%      { box-shadow: 0 0 0 18px transparent; }
    }

    /* Sized to the narrowest phone we ship to, not to the widest.
       Four fixed 96px buttons plus their padding wants 582px; a 360px phone has 360, so Mute ran off
       one edge and Flip off the other the moment turning the camera on added a fourth. Nothing said
       so — the row simply overflowed, and two controls became unreachable. */
    .call-actions {
        display: flex; gap: 8px; margin-bottom: 8vh;
        max-width: 100%; justify-content: center; flex-wrap: wrap;
    }
    .cbtn {
        appearance: none; border: 1px solid var(--line); background: var(--surface);
        color: var(--ink-2); border-radius: 18px; padding: 12px 8px;
        flex: 1 1 68px; min-width: 0; max-width: 100px;
        display: flex; flex-direction: column; align-items: center; gap: 6px;
        font-size: 0.78rem; font-weight: 650; cursor: pointer;
    }
    .cbtn svg { width: 24px; height: 24px; flex: none; }
    .cbtn span { text-align: center; line-height: 1.15; }
    .cbtn.on { background: var(--brand-tint); border-color: var(--brand); color: var(--brand); }
    .cbtn:active { transform: scale(0.97); }

    /* Answer and Hang up belong to different screens that replace each other, so they must never
       occupy the same pixels — answering would otherwise leave a finger resting on Hang up. The
       connected screen's control sits well below where the ringing screen's pair was. */
    .call-end.connected { transform: translateY(42px); }
    .call-end { display: flex; gap: 16px; }
    .cend {
        appearance: none; border: none; border-radius: 999px;
        padding: 16px 30px; font-size: 1rem; font-weight: 700; color: #fff; cursor: pointer;
    }
    .cend.wide { padding-left: 52px; padding-right: 52px; }
    .answer { background: #1f9d55; }
    .decline { background: #c0392b; }
    .cend:active { transform: scale(0.98); }
</style>
