@page "/watch"
@using AetherNet.Sample.Shared.Services
@using AetherNet.Streaming.Models
@implements IAsyncDisposable
@inject WatchService Watch
@inject AttachmentService Attachments
@inject NavigationManager Nav
@inject IJSRuntime JS

<PageTitle>Aether — watch together</PageTitle>

<div class="wt">
    <header class="wt-head">
        <button class="wt-back" @onclick="Leave" aria-label="Leave">Leave</button>
        <span class="wt-title">@(_session?.Title ?? "Watch together")</span>
        <span class="wt-role">@(Watch.IsHost ? "You're hosting" : "Following")</span>
    </header>

    @if (_session is null)
    {
        <div class="wt-empty">Nothing to watch.</div>
    }
    else if (_source is null)
    {
        <div class="wt-empty">Loading the video…</div>
    }
    else
    {
        <video id="watch-video" class="wt-video" src="@_source" controls playsinline></video>
        @if (!Watch.IsHost)
        {
            <div class="wt-hint">The host controls playback — you're in sync with them.</div>
        }

        <div class="wt-reactions">
            @foreach (var e in Reactions)
            {
                <button class="wt-react" @onclick="() => React(e)">@e</button>
            }
        </div>
    }

    @if (_floating.Count > 0)
    {
        <div class="wt-floats">
            @foreach (var f in _floating) { <span class="wt-float">@f</span> }
        </div>
    }
</div>

@code {
    private static readonly string[] Reactions = { "😂", "❤️", "😮", "👏", "🔥" };
    private const string ModulePath = "./_content/AetherNet.Sample.Shared/js/aether-watch.js";

    private WatchSession? _session;
    private string? _source;
    private string? _loadedHash;
    private DotNetObjectReference<WatchTogether>? _self;
    private IJSObjectReference? _mod;
    private bool _bound;
    private readonly List<string> _floating = new();

    protected override void OnInitialized()
    {
        _session = Watch.Current;
        if (_session is null) { Nav.NavigateTo(""); return; }
        Watch.Changed += OnChanged;
        Watch.Synced += OnSynced;
        Watch.Reacted += OnReacted;
    }

    private void OnChanged() => _ = InvokeAsync(() =>
    {
        _session = Watch.Current;
        if (_session is null) Nav.NavigateTo("");   // the room closed
        else StateHasChanged();
    });

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_session is null) return;
        _mod ??= await JS.InvokeAsync<IJSObjectReference>("import", ModulePath);

        // Load the shared video once — by the content hash both phones already hold.
        if (_source is null && _loadedHash != _session.ContentRootHash)
        {
            _loadedHash = _session.ContentRootHash;
            var bytes = await Attachments.GetAsync(_session.ContentRootHash);
            if (bytes is not null)
            {
                _source = "data:video/mp4;base64," + Convert.ToBase64String(bytes);
                StateHasChanged();   // render the <video>, then bind on the next pass
                return;
            }
        }

        // The host reports its own controls; a follower only ever applies what arrives, so only the host
        // binds — no feedback loop between the two.
        if (_source is not null && Watch.IsHost && !_bound && _mod is not null)
        {
            _self ??= DotNetObjectReference.Create(this);
            _bound = await _mod.InvokeAsync<bool>("bind", "watch-video", _self);
        }
    }

    // A sync arrived from the host — a follower brings its element into line with it.
    private void OnSynced(WatchSession s)
    {
        _session = s;
        if (!Watch.IsHost && _mod is not null)
            _ = _mod.InvokeVoidAsync("apply", "watch-video", s.PositionMs, s.IsPlaying);
        _ = InvokeAsync(StateHasChanged);
    }

    /// <summary>The host drove the element — put it on the mesh for the followers.</summary>
    [JSInvokable]
    public async Task OnHostAction(string kind, long positionMs)
    {
        switch (kind)
        {
            case "play": await Watch.PlayAsync(positionMs); break;
            case "pause": await Watch.PauseAsync(positionMs); break;
            case "seek": await Watch.SeekAsync(positionMs); break;
        }
    }

    private async Task React(string emoji)
    {
        var pos = _mod is not null ? await _mod.InvokeAsync<long>("positionMs", "watch-video") : 0;
        await Watch.ReactAsync(emoji, pos);
        Show(emoji);
    }

    private void OnReacted(WatchReactionPayload r) => _ = InvokeAsync(() => Show(r.Reaction));

    private void Show(string emoji)
    {
        _floating.Add(emoji);
        StateHasChanged();
        _ = Task.Delay(2000).ContinueWith(_ => InvokeAsync(() =>
        {
            if (_floating.Count > 0) _floating.RemoveAt(0);
            StateHasChanged();
        }));
    }

    private async Task Leave()
    {
        await Watch.LeaveAsync();
        Nav.NavigateTo("");
    }

    public async ValueTask DisposeAsync()
    {
        Watch.Changed -= OnChanged;
        Watch.Synced -= OnSynced;
        Watch.Reacted -= OnReacted;
        try
        {
            if (_mod is not null)
            {
                await _mod.InvokeVoidAsync("unbind", "watch-video");
                await _mod.DisposeAsync();
            }
        }
        catch { /* the WebView may already be gone */ }
        _self?.Dispose();
    }
}

<style>
    .wt { position: fixed; inset: 0; background: #000; color: #fff; z-index: 50; display: flex;
        flex-direction: column; }
    .wt-head { flex: 0 0 auto; display: flex; align-items: center; gap: 12px;
        padding: max(env(safe-area-inset-top), 28px) 16px 12px; }
    .wt-back { appearance: none; background: transparent; border: 1px solid rgba(255,255,255,.4);
        color: #fff; border-radius: 10px; padding: 8px 14px; font-weight: 700; cursor: pointer; }
    .wt-title { font-weight: 800; font-size: 1.05rem; flex: 1 1 auto; min-width: 0;
        overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
    .wt-role { font-size: 0.8rem; opacity: .8; }

    .wt-empty { flex: 1 1 auto; display: flex; align-items: center; justify-content: center; opacity: .8; }
    .wt-video { width: 100%; flex: 1 1 auto; min-height: 0; object-fit: contain; background: #000; }
    .wt-hint { text-align: center; font-size: 0.8rem; opacity: .75; padding: 8px; }

    .wt-reactions { flex: 0 0 auto; display: flex; gap: 8px; justify-content: center;
        padding: 12px 12px max(env(safe-area-inset-bottom), 20px); }
    .wt-react { appearance: none; border: none; background: rgba(255,255,255,.12); border-radius: 999px;
        font-size: 1.5rem; width: 54px; height: 54px; cursor: pointer; }

    .wt-floats { position: absolute; right: 20px; bottom: 100px; display: flex; flex-direction: column-reverse;
        gap: 6px; pointer-events: none; }
    .wt-float { font-size: 2rem; animation: wt-rise 2s ease-out forwards; }
    @@keyframes wt-rise { from { opacity: 0; transform: translateY(10px); } 20% { opacity: 1; }
        to { opacity: 0; transform: translateY(-40px); } }
</style>
