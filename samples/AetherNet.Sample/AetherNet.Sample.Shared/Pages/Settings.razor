@page "/settings"
@using AetherNet.Sample.Shared.Data
@using AetherNet.Sample.Shared.Services
@inject IIdentityService Me
@inject IJSRuntime JS
@inject ProxyDirectory Proxies
@inject ChatService Chat
@inject NavigationManager Nav
@inject AetherStore Store
@inject IAppTheme Shell
@implements IDisposable

<PageTitle>Aether — you</PageTitle>

<div class="you">
    <div class="profile">
        <span class="pav">@Initial</span>
        <div class="pinfo">
            <input class="pname pname-edit" @bind="_name" @bind:event="oninput" @onchange="SaveName"
                   placeholder="Your name" maxlength="40" aria-label="Your display name" />
            <button class="ptag" @onclick="CopyTag">@(_copied ? "Copied ✓" : Me.AetherTag)</button>
        </div>
    </div>

    <section class="group">
        <div class="glabel">Appearance</div>
        <div class="seg">
            <button class="seg-btn @(_theme == "light" ? "on" : null)" @onclick='() => SetTheme("light")'>Light</button>
            <button class="seg-btn @(_theme == "dark" ? "on" : null)" @onclick='() => SetTheme("dark")'>Dark</button>
            <button class="seg-btn @(_theme == "system" ? "on" : null)" @onclick='() => SetTheme("system")'>System</button>
        </div>
    </section>

    @* The second leg, in the only place it can honestly live: a switch the person owns. Carrying
       somebody else's traffic spends their battery and their data bundle, so it is never on quietly. *@
    <section class="group">
        <div class="glabel">Relay for your Circle</div>
        <button class="about" @onclick="ToggleGateway" disabled="@_busy">
            <span class="about-body">
                <span class="about-t">@(Proxies.IsGateway ? "This phone is relaying" : "Relay for your Circle")</span>
                <span class="about-s">@GatewayDetail</span>
            </span>
            <span class="chev">@(Proxies.IsGateway ? "on" : "off")</span>
        </button>
    </section>

    @* Handing somebody the app with no store in the middle. It goes to people you have already added,
       because a stranger you can hand a forty-megabyte package to is a stranger with your attention. *@
    <section class="group">
        <div class="glabel">You</div>

        @* Sits above sharing on purpose: the card is what a stranger reads at the moment they are
           handed the app, so it is worth writing before you go looking for somebody to hand it to. *@
        <button class="about" @onclick="@(() => Nav.NavigateTo("/meshweb?mine=1"))">
            <span class="about-body">
                <span class="about-t">Your pages</span>
                <span class="about-s">what this phone puts on AetherNet — your tag is the domain</span>
            </span>
            <span class="chev">→</span>
        </button>
    </section>

    <section class="group">
        <div class="glabel">Share Aether</div>
        @if (Chat.CanShareApp)
        {
            @* The one that works on somebody who has nothing. Everything below it goes to people you
               have already added, which is no use at all to the friend who is not on Aether yet. *@
            <button class="about" @onclick="@(() => Nav.NavigateTo("/share"))">
                <span class="about-body">
                    <span class="about-t">Touch My Blood</span>
                    <span class="about-s">give Aether to a friend next to you — they need nothing on their phone</span>
                </span>
                <span class="chev">→</span>
            </button>

            @foreach (var contact in Chat.MutualContacts)
            {
                <button class="about" @onclick="() => ShareWith(contact)" disabled="@_busy">
                    <span class="about-body">
                        <span class="about-t">Send Aether to @contact</span>
                        <span class="about-s">@ShareSize — over the mesh, no app store</span>
                    </span>
                    <span class="chev">→</span>
                </button>
            }
            @if (Chat.MutualContacts.Count == 0)
            {
                <div class="about"><span class="about-body">
                    <span class="about-t">Nobody to share with yet</span>
                    <span class="about-s">add someone first — then you can hand them the app</span>
                </span></div>
            }
        }
        else
        {
            <div class="about"><span class="about-body">
                <span class="about-t">Not available on this phone</span>
                <span class="about-s">@Chat.CannotShareAppReason</span>
            </span></div>
        }
    </section>

    <section class="group">
        <div class="glabel">About</div>
        <a class="about" href="https://github.com/bhengubv/aether-protocol" target="_blank" rel="noopener">
            <span class="about-body">
                <span class="about-t">Aether runs on AetherNet</span>
                <span class="about-s">an open, serverless mesh protocol</span>
            </span>
            <span class="chev">↗</span>
        </a>
    </section>
</div>

@code {
    private bool _busy;
    private string? _shareNote;
    private bool _copied;

    private string GatewayDetail => _shareNote
        ?? (Proxies.IsGateway ? "your Circle can reach each other through this phone"
            : Proxies.Best is { } via ? $"currently relaying through {via}"
            : "lets people with no data reach each other through yours");

    private string ShareSize => Chat.AppShareSizeBytes > 0
        ? $"{Chat.AppShareSizeBytes / (1024 * 1024)} MB"
        : "the app itself";

    protected override void OnInitialized()
    {
        Proxies.Changed += OnChanged;
        _theme = Store.GetSetting(SetupKeys.Theme) ?? "system";
        _name = Store.GetAccount().DisplayName;
    }

    private void OnChanged() => _ = InvokeAsync(StateHasChanged);

    public void Dispose() => Proxies.Changed -= OnChanged;

    private async Task ToggleGateway()
    {
        _busy = true;
        try { await Chat.SetRelayingAsync(!Proxies.IsGateway); }
        finally { _busy = false; }
    }

    private async Task ShareWith(string tag)
    {
        _busy = true;
        try
        {
            _shareNote = await Chat.ShareAppAsync(tag)
                ? $"sending Aether to {tag}"
                : "could not start the share";
        }
        finally { _busy = false; }
    }

    /// <summary>
    /// What the person chose, read back from the store rather than assumed.
    /// </summary>
    /// <remarks>
    /// This was a field initialised to "system" and never loaded, so the buttons showed System on
    /// every visit no matter what had been picked — and the choice itself lasted exactly as long as
    /// the page did.
    /// </remarks>
    private string _theme = "system";

    /// <summary>Your chosen display name — loaded from the account, persisted on change. Local only.</summary>
    private string? _name;

    /// <summary>The avatar glyph: the initial of your name if you have set one, else of your tag.</summary>
    private string Initial
    {
        get
        {
            var source = !string.IsNullOrWhiteSpace(_name) ? _name!.Trim() : Me.AetherTag;
            return string.IsNullOrEmpty(source) ? "?" : source[..1].ToUpperInvariant();
        }
    }

    /// <summary>Persist the chosen name and its initial avatar. Never sent anywhere — the tag is the identity.</summary>
    private void SaveName() => Store.SaveAccount(_name?.Trim() ?? string.Empty, Initial);

    private async Task CopyTag()
    {
        try { await JS.InvokeVoidAsync("navigator.clipboard.writeText", Me.AetherTag); } catch { }
        _copied = true;
    }

    private async Task SetTheme(string theme)
    {
        _theme = theme;
        Store.SetSetting(SetupKeys.Theme, theme);

        // The shell as well as the page. See IAppTheme — data-theme reaches the document and nothing
        // behind it, and what is behind it is what somebody sees for the first second of every launch.
        Shell.Apply(theme);

        try { await JS.InvokeVoidAsync("aetherTheme", theme); } catch { }
    }
}

<style>
    .you { max-width: 720px; margin: 0 auto; display: flex; flex-direction: column; gap: 26px; }

    .profile { display: flex; align-items: center; gap: 16px; padding: 12px 4px 4px; }
    .pav { width: 72px; height: 72px; border-radius: 50%; background: linear-gradient(135deg, var(--brand), var(--brand-deep)); color: #fff; display: flex; align-items: center; justify-content: center; font-weight: 800; font-size: 2rem; }
    .pinfo { display: flex; flex-direction: column; gap: 4px; min-width: 0; }
    .pname { font-size: 1.5rem; font-weight: 800; color: var(--ink); }
    .pname-edit { appearance: none; border: none; background: transparent; padding: 0; width: 100%; min-width: 0; font-family: inherit; }
    .pname-edit::placeholder { color: var(--ink-3); opacity: .65; font-weight: 700; }
    .pname-edit:focus { outline: none; }
    .ptag { appearance: none; border: none; background: transparent; cursor: pointer; text-align: left; padding: 0; font-family: var(--mono); font-size: 0.95rem; font-weight: 700; letter-spacing: 1px; color: var(--brand); }

    .group { display: flex; flex-direction: column; gap: 10px; }
    .glabel { font-size: 0.68rem; font-weight: 800; letter-spacing: 1px; text-transform: uppercase; color: var(--ink-3); padding-left: 4px; }

    .seg { display: flex; gap: 6px; background: var(--surface-2); color: var(--on-surface-2); --ink: var(--on-surface-2); --ink-2: var(--on-surface-2); --ink-3: var(--on-surface-2); --brand: var(--on-surface-2); border: 1px solid var(--line); border-radius: 12px; padding: 5px; }
    .seg-btn { flex: 1 1 0; appearance: none; border: none; background: transparent; color: var(--ink-2); font-weight: 650; font-size: 0.92rem; padding: 10px 0; border-radius: 8px; cursor: pointer; }
    .seg-btn.on { background: var(--pick-bg); color: var(--pick-ink); border-radius: 8px; font-weight: 750; }

    .about { display: flex; align-items: center; justify-content: space-between; gap: 12px; background: var(--surface); color: var(--on-surface); --ink: var(--on-surface); --ink-2: var(--on-surface); --ink-3: var(--on-surface); --brand: var(--on-surface); --line: rgba(255,255,255,.35); border: 1px solid var(--line); border-radius: 14px; padding: 15px 17px; box-shadow: var(--shadow-sm); }
    .about-body { display: flex; flex-direction: column; gap: 2px; }
    .about-t { font-weight: 700; color: var(--ink); font-size: 0.98rem; }
    .about-s { font-size: 0.82rem; color: var(--ink-2); }
    .chev { color: var(--ink-3); font-size: 1.2rem; font-weight: 700; }
</style>
