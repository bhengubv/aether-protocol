@page "/settings"
@using System.Linq
@using AetherNet.Sample.Shared.Data
@using AetherNet.Sample.Shared.Services
@using AetherNet.Node
@inject IJSRuntime JS
@inject ProxyDirectory Proxies
@inject ChatService Chat
@inject NavigationManager Nav
@inject AetherStore Store
@inject IAppTheme Shell
@inject IAetherNodeClient Node
@inject PanicWipeService Panic
@implements IDisposable
@implements IAetherNodeEvents

@* How the app behaves — configuration, kept apart from who you are (that is Profile, the You tab). This
   is the home settings finally has: everything that governs the app rather than describes you lives here,
   and it has room to grow, which a profile card never did. *@

<PageTitle>Aether — settings</PageTitle>

<div class="you">
    <h1 class="scr-title">Settings</h1>

    @* Safety first, and near the top on purpose: an emergency broadcast that floods every Aether phone
       in range with no towers and no account. Its own screen holds the confirm + reach + "mark safe". *@
    <section class="group">
        <div class="glabel">Safety</div>
        <button class="about" @onclick="@(() => Nav.NavigateTo("/sos"))">
            <span class="about-body">
                <span class="about-t">Emergency SOS</span>
                <span class="about-s">Broadcast to every phone in range — no towers, no signal needed</span>
            </span>
            <span class="chev">→</span>
        </button>
    </section>

    @* The gap the whole split was for: the identity had no way off the phone. Now it does — a recovery
       phrase, derived from the key already here, never sent anywhere. *@
    <section class="group">
        <div class="glabel">Account &amp; identity</div>
        <button class="about" @onclick="@(() => Nav.NavigateTo("/backup"))">
            <span class="about-body">
                <span class="about-t">Back up your identity</span>
                <span class="about-s">@(_backedUp
                    ? "Backed up — your 24 words are written down"
                    : "24 words that restore you on a new phone — the only way back if you lose this one")</span>
            </span>
            <span class="chev">@(_backedUp ? "✓" : "→")</span>
        </button>
    </section>

    <section class="group">
        <div class="glabel">Appearance</div>
        <div class="seg">
            <button class="seg-btn @(_theme == "light" ? "on" : null)" @onclick='() => SetTheme("light")'>Light</button>
            <button class="seg-btn @(_theme == "dark" ? "on" : null)" @onclick='() => SetTheme("dark")'>Dark</button>
            <button class="seg-btn @(_theme == "system" ? "on" : null)" @onclick='() => SetTheme("system")'>System</button>
        </div>
    </section>

    @* The second leg, in the only place it can honestly live: a switch the person owns. Carrying
       somebody else's traffic spends their battery and their data bundle, so it is never on quietly. *@
    <section class="group">
        <div class="glabel">Relay for your Circle</div>
        <button class="about" @onclick="ToggleGateway" disabled="@_busy">
            <span class="about-body">
                <span class="about-t">@(Proxies.IsGateway ? "This phone is relaying" : "Relay for your Circle")</span>
                <span class="about-s">@GatewayDetail</span>
            </span>
            <span class="chev">@(Proxies.IsGateway ? "on" : "off")</span>
        </button>
    </section>

    @* AetherNet — the nearby-radio mesh — is a choice. Off, the app runs over the internet only and never
       wakes the physical radios (no battery, no permission prompts); on, phones near you reach each other
       with no towers and no accounts. Enabling it is authorizing the mesh on this device. It applies at
       launch, so a change asks for a reopen rather than pretending the radios stopped mid-session. *@
    <section class="group">
        <div class="glabel">AetherNet</div>
        <button class="about" @onclick="ToggleAetherNet">
            <span class="about-body">
                <span class="about-t">@(_aetherNet ? "AetherNet is on" : "AetherNet is off")</span>
                <span class="about-s">@AetherNetDetail</span>
            </span>
            <span class="chev">@(_aetherNet ? "on" : "off")</span>
        </button>
    </section>

    @* Read-only: whether this phone is reaching anyone right now and over which radio. NOT a picker —
       nobody chooses a transport, the widest linked radio carries — this only says what is happening. *@
    <section class="group">
        <div class="glabel">Connectivity</div>
        <div class="about">
            <span class="about-body">
                <span class="about-t">@(_link.Linked ? $"Connected — over {_link.Radio}" : "Not connected")</span>
                <span class="about-s">@(_link.Linked
                    ? "messages go straight to the phone you're linked with"
                    : "messages wait here until someone you've added is nearby")</span>
            </span>
            <span class="chev">@($"{_link.Available}/{_link.Total}")</span>
        </div>
    </section>

    @* Handing somebody the app with no store in the middle. It goes to people you have already added,
       because a stranger you can hand a forty-megabyte package to is a stranger with your attention. *@
    <section class="group">
        <div class="glabel">Share Aether</div>
        @if (Chat.CanShareApp)
        {
            <button class="about" @onclick="@(() => Nav.NavigateTo("/share"))">
                <span class="about-body">
                    <span class="about-t">Touch My Blood</span>
                    <span class="about-s">give Aether to a friend next to you — they need nothing on their phone</span>
                </span>
                <span class="chev">→</span>
            </button>

            @foreach (var contact in Chat.MutualContacts)
            {
                <button class="about" @onclick="() => ShareWith(contact)" disabled="@_busy">
                    <span class="about-body">
                        <span class="about-t">Send Aether to @contact</span>
                        <span class="about-s">@ShareSize — over the mesh, no app store</span>
                    </span>
                    <span class="chev">→</span>
                </button>
            }
            @if (Chat.MutualContacts.Count == 0)
            {
                <div class="about"><span class="about-body">
                    <span class="about-t">Nobody to share with yet</span>
                    <span class="about-s">add someone first — then you can hand them the app</span>
                </span></div>
            }
        }
        else
        {
            <div class="about"><span class="about-body">
                <span class="about-t">Not available on this phone</span>
                <span class="about-s">@Chat.CannotShareAppReason</span>
            </span></div>
        }
    </section>

    @* The protocol showcase, off the everyday tab bar and here instead: a deliberate detour into every
       capability the substrate carries, not a permanent fifth of the bar. *@
    <section class="group">
        <div class="glabel">Developer</div>
        <button class="about" @onclick="@(() => Nav.NavigateTo("lab"))">
            <span class="about-body">
                <span class="about-t">Lab</span>
                <span class="about-s">every capability the protocol carries, driven live in-process</span>
            </span>
            <span class="chev">→</span>
        </button>
    </section>

    <section class="group">
        <div class="glabel">About</div>
        <a class="about" href="https://github.com/bhengubv/aether-protocol" target="_blank" rel="noopener">
            <span class="about-body">
                <span class="about-t">Aether runs on AetherNet</span>
                <span class="about-s">an open, serverless mesh protocol</span>
            </span>
            <span class="chev">↗</span>
        </a>
    </section>

    @* The local half of a panic wipe, made reachable at last: AetherStore.WipeAll() erases every
       contact, message, session and setting and VACUUMs the file, so the app returns to setup. Two taps
       because one is an accident, and the warning is in the words — the palette stays three colours. *@
    <section class="group">
        <div class="glabel">Danger zone</div>
        <button class="about" @onclick="EraseAll">
            <span class="about-body">
                <span class="about-t">@(_armWipe ? "Tap again to erase everything" : "Erase all data on this phone")</span>
                <span class="about-s">@(_armWipe
                    ? "this cannot be undone"
                    : "every contact, message, setting and your identity key — back to a fresh install")</span>
            </span>
            <span class="chev">@(_armWipe ? "‼" : "⌫")</span>
        </button>
    </section>
</div>

@code {
    private bool _busy;
    private string? _shareNote;
    private bool _backedUp;
    private bool _armWipe;

    /// <summary>The device's link/presence, read through the node contract (IAetherNodeClient) rather
    /// than the radio directly — the app dogfooding its own node's presence slice.</summary>
    private NodeLinkStatus _link = NodeLinkStatus.Offline;
    private IDisposable? _nodeSub;

    /// <summary>Whether AetherNet (the nearby-radio mesh) is switched on. Default on — absent means on,
    /// only an explicit "0" is off — so a device that pre-dates the setting keeps the mesh it had.</summary>
    private bool _aetherNet;

    /// <summary>The value the app actually launched with — the radios are gated at launch, so a change
    /// only takes effect on the next open, and the card says so rather than lying.</summary>
    private bool _aetherNetLaunched;

    private string AetherNetDetail => _aetherNet != _aetherNetLaunched
        ? "reopen Aether for this to take effect"
        : _aetherNet
            ? "nearby radios reach people around you — no towers, no accounts"
            : "internet only — the nearby radios stay off until you switch this on";

    private string GatewayDetail => _shareNote
        ?? (Proxies.IsGateway ? "your Circle can reach each other through this phone"
            : Proxies.Best is { } via ? $"currently relaying through {via}"
            : "lets people with no data reach each other through yours");

    private string ShareSize => Chat.AppShareSizeBytes > 0
        ? $"{Chat.AppShareSizeBytes / (1024 * 1024)} MB"
        : "the app itself";

    protected override async Task OnInitializedAsync()
    {
        Proxies.Changed += OnChanged;
        _theme = Store.GetSetting(SetupKeys.Theme) ?? "system";
        _backedUp = Store.GetAccount().RecoveryBackedUp;
        _aetherNet = _aetherNetLaunched = Store.GetSetting(SetupKeys.AetherNet) != "0";

        // Presence now comes through the node contract — the app is a client of its own node.
        _nodeSub = Node.Subscribe(this);
        try { _link = await Node.GetLinkAsync(); }
        catch { _link = NodeLinkStatus.Offline; }
    }

    private void OnChanged() => _ = InvokeAsync(StateHasChanged);

    // IAetherNodeEvents — the node pushes link changes (and inbound/grant, unused here) to this page.
    void IAetherNodeEvents.OnLinkChanged(NodeLinkStatus status)
    {
        _link = status;
        _ = InvokeAsync(StateHasChanged);
    }

    void IAetherNodeEvents.OnInbound(InboundMessage message) { }

    void IAetherNodeEvents.OnGrantChanged(GrantState state) { }

    public void Dispose()
    {
        Proxies.Changed -= OnChanged;
        _nodeSub?.Dispose();
    }

    /// <summary>
    /// Erase everything this device holds and return it to setup. Two taps — the first only arms the
    /// second — because a one-tap wipe is an accident waiting to happen.
    /// </summary>
    private void EraseAll()
    {
        if (!_armWipe) { _armWipe = true; return; }
        // The real panic wipe, not just a database clear: this destroys the identity key in the vault
        // AND every local row. Clearing the database alone (the old behaviour) left the one secret whose
        // loss is the whole point — the identity private key — sitting in the keystore, so a wiped phone
        // was still cryptographically you. Wipe() sweeps the key first, then the rest.
        Panic.Wipe();
        // A device with no identity row lands on the setup wizard; force a reload so Routes re-decides.
        Nav.NavigateTo("/", forceLoad: true);
    }

    private async Task ToggleGateway()
    {
        _busy = true;
        try { await Chat.SetRelayingAsync(!Proxies.IsGateway); }
        finally { _busy = false; }
    }

    /// <summary>
    /// Switch AetherNet (the nearby-radio mesh) on or off. Persisted immediately; the radios are brought
    /// up at launch (see WarmUpService), so a change takes effect when Aether is next opened — the card
    /// reflects that rather than pretending the radios stopped mid-session.
    /// </summary>
    private void ToggleAetherNet()
    {
        _aetherNet = !_aetherNet;
        Store.SetFlag(SetupKeys.AetherNet, _aetherNet);
    }

    private async Task ShareWith(string tag)
    {
        _busy = true;
        try
        {
            _shareNote = await Chat.ShareAppAsync(tag)
                ? $"sending Aether to {tag}"
                : "could not start the share";
        }
        finally { _busy = false; }
    }

    /// <summary>What the person chose, read back from the store rather than assumed.</summary>
    private string _theme = "system";

    private async Task SetTheme(string theme)
    {
        _theme = theme;
        Store.SetSetting(SetupKeys.Theme, theme);

        // The shell as well as the page. See IAppTheme — data-theme reaches the document and nothing
        // behind it, and what is behind it is what somebody sees for the first second of every launch.
        Shell.Apply(theme);

        try { await JS.InvokeVoidAsync("aetherTheme", theme); } catch { }
    }
}

<style>
    .you { max-width: 720px; margin: 0 auto; display: flex; flex-direction: column; gap: 26px; }

    .group { display: flex; flex-direction: column; gap: 10px; }
    .glabel { font-size: 0.68rem; font-weight: 800; letter-spacing: 1px; text-transform: uppercase; color: var(--ink-3); padding-left: 4px; }

    .seg { display: flex; gap: 6px; background: var(--surface-2); color: var(--on-surface-2); --ink: var(--on-surface-2); --ink-2: var(--on-surface-2); --ink-3: var(--on-surface-2); --brand: var(--on-surface-2); border: 1px solid var(--line); border-radius: 12px; padding: 5px; }
    .seg-btn { flex: 1 1 0; appearance: none; border: none; background: transparent; color: var(--ink-2); font-weight: 650; font-size: 0.92rem; padding: 10px 0; border-radius: 8px; cursor: pointer; }
    .seg-btn.on { background: var(--pick-bg); color: var(--pick-ink); border-radius: 8px; font-weight: 750; }

    .about { display: flex; align-items: center; justify-content: space-between; gap: 12px; background: var(--surface); color: var(--on-surface); --ink: var(--on-surface); --ink-2: var(--on-surface); --ink-3: var(--on-surface); --brand: var(--on-surface); --line: rgba(255,255,255,.35); border: 1px solid var(--line); border-radius: 14px; padding: 15px 17px; box-shadow: var(--shadow-sm); }
    .about-body { display: flex; flex-direction: column; gap: 2px; }
    .about-t { font-weight: 700; color: var(--ink); font-size: 0.98rem; }
    .about-s { font-size: 0.82rem; color: var(--ink-2); }
    .chev { color: var(--ink-3); font-size: 1.2rem; font-weight: 700; }
</style>
