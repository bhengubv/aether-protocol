@page "/meshweb"
@using AetherNet.Sample.Shared.Services
@implements IDisposable
@inject MeshWebService Mesh
@inject ChatService Chat
@inject NavigationManager Nav
@inject IJSRuntime JS

<PageTitle>Aether — AetherNet</PageTitle>

@* An AetherNet tab is a browser and a workshop. Browse is somebody else's tag; Mine is what this
   phone answers with. Separated because they are different jobs, and a person doing one of them
   should not be reading the other. *@
<div class="browser">
    <div class="where">
        <button class="seg @(_mine ? null : "on")" @onclick="() => Show(false)">Browse</button>
        <button class="seg @(_mine ? "on" : null)" @onclick="() => Show(true)">Mine</button>
    </div>

@if (_mine)
{
    <div class="mine">
        <p class="lede">Your AetherTag is your domain. Every page below is a path under it, served off this phone — nobody issued it, so nobody can take it back.</p>

        @foreach (var card in Mesh.Mine.All)
        {
            <div class="row">
                <button class="rmain" @onclick="@(() => Go(Mesh.Address(card.Name)))">
                    <span class="rtitle">@(string.IsNullOrWhiteSpace(card.Doc.Title) ? card.Name : card.Doc.Title)</span>
                    <span class="raddr">@(Mesh.LocalTag + "/" + card.Name)</span>
                    <span class="rstate @(card.Live ? "live" : "draft")">@(card.Live ? "published" : "draft")</span>
                </button>
                <button class="redit" @onclick="@(() => Nav.NavigateTo("/page/" + card.Name))" aria-label="Edit">Edit</button>
            </div>
        }

        <button class="new" disabled="@Mesh.Mine.Full" @onclick="@(() => Nav.NavigateTo("/page/new"))">
            <span class="plus">+</span>
            <span class="ntext">
                <span class="nt">Create a web card</span>
                <span class="ns">Four steps. Pick a look, write it, publish it.</span>
            </span>
        </button>

        @if (Mesh.Mine.Full)
        {
            <p class="lede">That is as many pages as one device offers.</p>
        }
    </div>
}
else
{
    <div class="omnibox">
        <span class="lock" aria-hidden="true">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round"><rect x="5" y="11" width="14" height="9" rx="2"/><path d="M8 11V8a4 4 0 0 1 8 0v3"/></svg>
        </span>
        <span class="scheme">aether://</span>
        <input class="addr" @bind="_address" @bind:event="oninput" @onkeydown="OnKey"
               placeholder="tag / name" spellcheck="false" autocapitalize="off" />
        <button class="go" disabled="@_busy" @onclick="Open" aria-label="Go">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
        </button>
    </div>

    <div class="tabs">
        @foreach (var name in Mesh.Pages)
        {
            <button class="bm @(_address == $"{Mesh.LocalTag}/{name}" ? "on" : null)" @onclick="@(() => Go(Mesh.Address(name)))">@name</button>
        }
        @foreach (var card in Mesh.SavedCards)
        {
            <button class="bm saved @(_address == TrimScheme(card.Address) ? "on" : null)" @onclick="@(() => Go(card.Address))">🔖 @card.Title</button>
        }
        @if (Mesh.PeerSiteAddress is { } peer && !Mesh.SavedCards.Any(c => c.Address == peer))
        {
            <button class="bm peer" @onclick="@(() => Go(peer))">★ nearby phone</button>
        }
    </div>

    <div class="page">
        @if (_page is { Ok: true } p)
        {
            @* Drawn block by block, never injected. A card is authored by a stranger, so nothing in
               it may execute or fetch — and a block this build does not recognise is skipped rather
               than failing the whole card, so a newer author never breaks an older reader. *@
            <div class="doc" style="@Dress(p.Card)">
                @if (p.Card is { } card)
                {
                    @* The hero. A card's first picture runs the full width above the title, the way a
                       page has a masthead — which is most of the difference between something that
                       looks like a place and something that looks like a document. Until the bytes
                       arrive the description holds the same space, so the card never jumps. *@
                    @* The masthead. Three layers in one box: the picture the mesh carries, the
                       shader painted over it, and the flat accent behind both — so a phone with no
                       GPU still meets a page rather than a gap. Keyed on the address because Blazor
                       would otherwise keep one canvas across two cards, and the painter refuses to
                       repaint a plate it has already done. *@
                    var hero = card.Blocks.FirstOrDefault(b => b.Kind == CardBlock.Image);
                    <div class="plate" @key="p.Address">
                        @if (hero is not null && _assets.TryGetValue(hero.ContentHash ?? "", out var heroUri))
                        {
                            <img class="plate-art" src="@heroUri" alt="@hero.Value" />
                        }
                        <canvas class="plate-gl" data-aether-shader
                                data-accent="@Paint(card)" data-seed="@Seed(card.Title, p.Name)"></canvas>
                        <span class="mark">@Mark(card.Title, p.Name)</span>
                    </div>

                    <h1 class="card-title">@card.Title</h1>
                    foreach (var block in card.Blocks)
                    {
                        switch (block.Kind)
                        {
                            case CardBlock.Heading:
                                <h2 class="card-h">@block.Value</h2>
                                break;

                            case CardBlock.Text:
                                <p class="card-p">@block.Value</p>
                                break;

                            case CardBlock.List:
                                <ul class="card-ul">
                                    @foreach (var item in block.Items ?? [])
                                    {
                                        <li>@item</li>
                                    }
                                </ul>
                                break;

                            @* A labelled fact reads as two columns, the same way the page renderer
                               draws it. Printing the raw "Open = 07:00" showed the author's own
                               notation to a reader, and made the browser and the page disagree about
                               what the same card looks like. *@
                            case CardBlock.KeyValue:
                                <div class="card-kv">
                                    <span class="kv-k">@Label(block.Value)</span>
                                    <span class="kv-v">@Said(block.Value)</span>
                                </div>
                                break;

                            @* The picture. The card names a content hash; the bytes come from the mesh
                               and we build the data: URI ourselves, so a stranger's card can never make
                               the app fetch anything. Until the artwork arrives the description stands
                               in for it — the card is readable either way. *@
                            case CardBlock.Image when !ReferenceEquals(block, hero):
                                @if (_assets.TryGetValue(block.ContentHash ?? "", out var uri))
                                {
                                    <img class="card-art" src="@uri" alt="@block.Value" />
                                }
                                else
                                {
                                    <div class="card-art pending">@block.Value</div>
                                }
                                break;

                            @* Theme is applied to the card as a whole, not drawn in place. *@
                            case CardBlock.Theme:
                                break;

                            @* A link goes to another card on the mesh and nowhere else. It is drawn as
                               a button that re-enters this same resolver rather than as an anchor, so
                               a stranger's card cannot hand the browser an address of its own choosing.
                               Anything that is not an aether:// address is shown as plain text — the
                               card still renders, the link simply does not work, which is the safe way
                               round. *@
                            @* A tip jar. The one block that names somewhere outside the mesh — and it
                               is still never followed on the reader's behalf. The address is shown as
                               text and as a code they can scan on their own connection, so opening a
                               stranger's card causes no outbound request of any kind. *@
                            case CardBlock.Tip when CardBlock.IsUsableTip(block.Target):
                                <div class="card-tip">
                                    <div class="tip-say">
                                        <span class="tip-l">@(block.Value ?? "Tip")</span>
                                        <span class="tip-h">@CardBlock.TipHost(block.Target)</span>
                                        <span class="tip-u">@block.Target</span>
                                    </div>
                                    <div class="tip-qr">@((MarkupString)QrSvg.Render(block.Target!, withMark: false))</div>
                                </div>
                                break;

                            case CardBlock.Link:
                                @if (IsMeshAddress(block.Target))
                                {
                                    <button type="button" class="card-link" @onclick="@(() => Go(block.Target!))">
                                        @(block.Value ?? block.Target)
                                    </button>
                                }
                                else
                                {
                                    <p class="card-p">@block.Value</p>
                                }
                                break;
                        }
                    }
                }
            </div>
            <div class="siteinfo">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="5" y="11" width="14" height="9" rx="2"/><path d="M8 11V8a4 4 0 0 1 8 0v3"/></svg>
                @if (p.Own)
                {
                    <span>your page · <span class="mono">@p.AuthorTag</span></span>
                }
                else
                {
                    <span>signed by <span class="mono">@p.AuthorTag</span></span>
                    @if (p.Remote)
                    {
                        <span class="air">· fetched over @Mesh.RadioName</span>
                    }
                    else
                    {
                        <span class="offline">· saved offline</span>
                    }
                }
            </div>
        }
        else if (_page is { Ok: false } f)
        {
            <div class="err">Couldn't reach <span class="mono">@f.Address</span><br />@f.Error</div>
        }
        else
        {
            <div class="muted">Resolving…</div>
        }
    </div>
}
</div>

@code {
    private string _address = "";
    private MeshWebService.MeshPage? _page;
    private bool _busy;
    private bool _autoOpened;
    private bool _mine;

    /// <summary>
    /// Artwork already assembled, by content hash. Held here rather than fetched during render because
    /// a picture may still be arriving over the radio, and a card must draw immediately either way.
    /// </summary>
    private readonly Dictionary<string, string> _assets = new(StringComparer.Ordinal);

    /// <summary>
    /// The card's own colour, applied to the card and nothing else.
    ///
    /// <para>
    /// A card is a blob from a stranger, so its accent is untrusted input written into a style
    /// attribute — the one place a card gets anywhere near CSS. It is admitted only as a plain hex
    /// colour, and it sets a variable the card's own rules read, so the worst a hostile card can do
    /// is choose an ugly colour for itself. Anything else, and the card keeps the app's blue.
    /// </para>
    /// </summary>
    private static string Dress(CardDocument? card)
    {
        var colour = card?.Blocks
            .FirstOrDefault(b => b.Kind == CardBlock.Theme && CardBlock.IsUsableAccent(b.Value))?.Value;

        // The look, on the other hand, is not untrusted: a card names one by key and an unknown key
        // falls back to the default, so the font stacks written here are always our own. Applying them
        // is what makes the choice somebody made in the editor mean anything to a reader — without it
        // every page on the mesh comes out in the same typeface whatever its author picked.
        var look = CardLook.FromCard(card);
        var dress = $"--card-display:{look.Display};--card-body:{look.Body}";

        return colour is null ? dress : $"--card-accent:{colour};{dress}";
    }

    /// <summary>The label half of a labelled fact — everything before the equals sign.</summary>
    private static string Label(string? value)
    {
        if (string.IsNullOrWhiteSpace(value)) return "";

        var cut = value.IndexOf('=');
        return (cut < 0 ? value : value[..cut]).Trim();
    }

    /// <summary>And what it says — everything after.</summary>
    private static string Said(string? value)
    {
        if (string.IsNullOrWhiteSpace(value)) return "";

        var cut = value.IndexOf('=');
        return cut < 0 ? "" : value[(cut + 1)..].Trim();
    }

    /// <summary>The colour this card's masthead is painted in.</summary>
    /// <remarks>
    /// The card's own accent where it declared one, the look's colour otherwise — never a value from
    /// anywhere else. It is handed to a shader as a uniform, and it has already been through
    /// <see cref="CardBlock.IsUsableAccent"/>, so what reaches the GPU is six hexadecimal digits.
    /// </remarks>
    private static string Paint(CardDocument? card) =>
        card?.Blocks.FirstOrDefault(b => b.Kind == CardBlock.Theme && CardBlock.IsUsableAccent(b.Value))?.Value
        ?? CardLook.FromCard(card).Accent;

    /// <summary>
    /// How this page folds, as a number.
    /// </summary>
    /// <remarks>
    /// A number rather than the title, so the only things the shader is ever handed are a validated
    /// colour and an integer. A card is a blob written by a stranger, and the less of it that reaches
    /// anything executable, the fewer ways there are to be wrong about escaping.
    /// </remarks>
    private static int Seed(string? title, string? name)
    {
        var hash = 2166136261u;

        foreach (var c in (title is { Length: > 0 } ? title : name) ?? "")
        {
            hash ^= c;
            hash *= 16777619;
        }

        return (int)(hash % 100000);
    }

    /// <summary>The single character the masthead is built around.</summary>
    private static string Mark(string? title, string? name)
    {
        foreach (var source in new[] { title, name })
            foreach (var c in source ?? "")
                if (char.IsLetterOrDigit(c))
                    return char.ToUpperInvariant(c).ToString();

        return "A";
    }

    /// <summary>
    /// Paint whatever plate is now on screen.
    /// </summary>
    /// <remarks>
    /// After the render rather than during it, because the shader sizes itself from the element the
    /// browser has already laid out. Failures are swallowed: a card that could not be painted is a
    /// card drawn flat, which is a look, not a fault.
    /// </remarks>
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        try
        {
            await JS.InvokeVoidAsync("aetherShader.paintAll");
        }
        catch (Exception)
        {
            // No painter on this head, or the page went away mid-call.
        }
    }

    /// <summary>
    /// Pull in any picture this card names. Runs after the page is already on screen, so the card is
    /// readable while its artwork is still crossing the radio.
    /// </summary>
    private async Task LoadArtAsync(CardDocument? card)
    {
        if (card is null) return;

        foreach (var hash in card.Blocks
            .Where(b => b.Kind == CardBlock.Image)
            .Select(b => b.ContentHash)
            .Where(h => h is not null && !_assets.ContainsKey(h))
            .Distinct(StringComparer.Ordinal)
            .ToArray())
        {
            if (await Mesh.AssetAsync(hash) is { } uri)
            {
                _assets[hash!] = uri;
                StateHasChanged();
            }
        }
    }

    /// <summary>
    /// May this card send the reader somewhere? Only to another card on the mesh.
    /// <para>
    /// The card is a blob written by a stranger, so its link targets are untrusted input. An
    /// <c>http</c> or <c>javascript</c> target would turn a card into a way to reach out of the mesh
    /// — exactly what publishing cards as inert JSON instead of HTML exists to prevent. Anything that
    /// is not an <c>aether://</c> address is drawn as plain text and goes nowhere.
    /// </para>
    /// </summary>
    private static bool IsMeshAddress(string? target) =>
        !string.IsNullOrWhiteSpace(target) &&
        target.StartsWith("aether://", StringComparison.OrdinalIgnoreCase);

    private void Show(bool mine) => _mine = mine;

    protected override async Task OnInitializedAsync()
    {
        Mesh.Changed += OnChanged;
        Mesh.Mine.Changed += OnChanged;

        // Somebody has just published. They are sent back to the list of their own pages, not to a
        // browser pointed at a stranger.
        _mine = Nav.Uri.Contains("mine=1", StringComparison.Ordinal);

        // While a card is open this page answers for itself: a route says which card, and only the
        // page knows how far down it somebody had read.
        Chat.Holding = () => Task.FromResult(Handoff.Describe(
            $"/meshweb?a={Uri.EscapeDataString(_address)}", null, null));

        await Mesh.EnsureReadyAsync();

        // Somebody handed us a card. Open theirs rather than our own home page.
        if (Chat.TakeArriving() is { Kind: Handoff.Kind.Card } handed)
        {
            await Go(handed.Target);
            return;
        }

        await Go(Mesh.HomeAddress);
        if (Mesh.RadioAvailable && !Mesh.RadioLinked)
            Mesh.LinkRadio();
    }

    private void OnChanged() => _ = InvokeAsync(async () =>
    {
        if (!_autoOpened && !_busy && Mesh.PeerSiteAddress is { } peer)
        {
            _autoOpened = true;
            await Go(peer);
        }
        StateHasChanged();
    });

    private async Task Open()
        => await Go("aether://" + _address.Trim().TrimStart('/'));

    private async Task Go(string address)
    {
        if (_busy) return;
        _busy = true;
        StateHasChanged();
        try
        {
            _page = await Mesh.OpenAsync(address);
            _address = TrimScheme(address);
        }
        finally
        {
            _busy = false;
        }

        await LoadArtAsync(_page?.Card);
    }

    private async Task OnKey(KeyboardEventArgs e)
    {
        if (e.Key == "Enter") await Open();
    }

    private static string TrimScheme(string a) =>
        a.StartsWith("aether://", StringComparison.OrdinalIgnoreCase) ? a["aether://".Length..] : a;

    public void Dispose()
    {
        // Stop answering for a page that is no longer open.
        Chat.Holding = null;
        Mesh.Changed -= OnChanged;
        Mesh.Mine.Changed -= OnChanged;
    }
}

<style>
    .browser { display: flex; flex-direction: column; gap: 11px; max-width: 720px; margin: 0 auto; }

    /* Browse or Mine. Two jobs, one tab, and never both on screen. */
    .where { display: flex; gap: 4px; padding: 3px; border-radius: 999px; background: var(--surface-2); border: 1px solid var(--line); }
    .seg { flex: 1 1 0; padding: 9px 14px; border: 0; border-radius: 999px; background: transparent; color: var(--ink-2); font-size: 0.88rem; font-weight: 700; cursor: pointer; }
    .seg.on { background: var(--surface); color: var(--brand); box-shadow: var(--shadow-sm); }

    /* Mine — the pages this phone answers with. */
    .mine { display: flex; flex-direction: column; gap: 9px; }
    .lede { margin: 0; padding: 2px 4px; font-size: 0.85rem; line-height: 1.5; color: var(--ink-2); }
    .row { display: flex; align-items: stretch; gap: 7px; }
    .rmain { flex: 1 1 auto; min-width: 0; display: flex; flex-direction: column; gap: 3px; text-align: left; padding: 13px 15px; border-radius: var(--radius); border: 1px solid var(--line-card); background: var(--surface); cursor: pointer; }
    .rtitle { font-size: 1rem; font-weight: 750; color: var(--ink); overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
    .raddr { font-family: var(--mono); font-size: 0.78rem; color: var(--ink-3); overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
    .rstate { font-size: 0.68rem; font-weight: 800; letter-spacing: .08em; text-transform: uppercase; }
    .rstate.live { color: var(--brand); }
    .rstate.draft { color: var(--ink-3); }
    .redit { flex: 0 0 auto; padding: 0 16px; border-radius: var(--radius); border: 1px solid var(--line); background: transparent; color: var(--ink-2); font-weight: 700; font-size: 0.85rem; cursor: pointer; }

    .new { display: flex; align-items: center; gap: 13px; text-align: left; padding: 15px; border-radius: var(--radius); border: 1px dashed var(--line-card); background: transparent; cursor: pointer; }
    .new:disabled { opacity: .45; cursor: default; }
    .plus { flex: 0 0 auto; width: 38px; height: 38px; border-radius: 50%; background: var(--brand); color: #fff; font-size: 1.3rem; font-weight: 700; display: flex; align-items: center; justify-content: center; }
    .ntext { display: flex; flex-direction: column; gap: 2px; }
    .nt { font-size: 1rem; font-weight: 750; color: var(--ink); }
    .ns { font-size: 0.82rem; color: var(--ink-2); }

    /* Address bar — a browser omnibox pill. */
    .omnibox { display: flex; align-items: center; gap: 8px; background: var(--surface); border: 1px solid var(--line); border-radius: 999px; padding: 7px 7px 7px 14px; box-shadow: var(--shadow-sm); }
    .lock { display: flex; color: var(--brand); }
    .lock svg { width: 16px; height: 16px; }
    .scheme { font-family: var(--mono); font-weight: 700; font-size: 0.82rem; color: var(--ink-3); }
    .addr { flex: 1 1 auto; min-width: 0; border: none; outline: none; background: transparent; font-family: var(--mono); font-size: 0.92rem; color: var(--ink); }
    .go { flex: 0 0 auto; width: 38px; height: 38px; border-radius: 50%; border: none; background: var(--brand); color: #fff; display: flex; align-items: center; justify-content: center; cursor: pointer; }
    .go:disabled { opacity: .5; }
    .go svg { width: 19px; height: 19px; }

    /* Bookmarks — a thin, horizontally-scrolling row. */
    .tabs { display: flex; gap: 7px; overflow-x: auto; scrollbar-width: none; padding: 0 2px 1px; }
    .tabs::-webkit-scrollbar { display: none; }
    .bm { flex: 0 0 auto; border: 1px solid var(--line); background: var(--surface); color: var(--ink-2); font-family: var(--mono); font-size: 0.8rem; font-weight: 600; padding: 6px 13px; border-radius: 999px; cursor: pointer; white-space: nowrap; }
    .bm.on { border-color: var(--brand); color: var(--brand); background: var(--brand-tint); }
    .bm.peer { border-color: var(--brand); color: var(--brand); background: var(--brand-tint); }
    .bm.saved { color: var(--ink-2); }
    .bm.saved.on { border-color: var(--brand); color: var(--brand); background: var(--brand-tint); }

    /* The page itself — the rendered card fills the view like a web page. */
    .page { min-height: 46vh; }

    /* The card. Every block below is drawn by us from typed JSON — a stranger's card gets our
       typography and nothing of its own, which is exactly why it can be trusted to render.

       The one thing a card chooses for itself is --card-accent, and only as a plain hex colour that
       has already been checked. Everything accented below reads it and falls back to the app's blue,
       so a card that sets no theme still looks deliberate. */
    .doc {
        --card-accent: var(--brand);
        --card-display: inherit;
        --card-body: inherit;
        font-family: var(--card-body);
        background: var(--surface);
        border: 1px solid var(--line);
        border-radius: 16px;
        padding: 0 20px 24px;
        overflow: hidden;
    }

    /* Full-bleed masthead: out to the card's edges, under its rounded top corners. The app-wide
       `img { max-width: 100% }` that keeps pages from scrolling sideways would otherwise clamp the
       picture back inside the padding, so it is lifted here and nowhere else — the card clips it.

       The plate holds its own space from the first frame, so nothing jumps when a picture that is
       still crossing the radio finally lands. */
    .plate {
        position: relative;
        width: calc(100% + 40px);
        margin: 0 -20px 18px;
        aspect-ratio: 600 / 250;
        overflow: hidden;
        background: var(--card-accent);
    }
    .plate-art, .plate-gl {
        position: absolute;
        inset: 0;
        width: 100%;
        height: 100%;
        max-width: none;
        display: block;
        border: 0;
    }
    .plate-art { object-fit: cover; }
    .mark {
        position: absolute;
        left: 18px;
        bottom: 4px;
        font-family: var(--card-display);
        font-size: 4.4rem;
        line-height: 1;
        font-weight: 800;
        letter-spacing: -0.035em;
        color: #fff;
        opacity: .95;
    }

    .card-title {
        font-family: var(--card-display);
        margin: 0 0 2px;
        padding-top: 4px;
        font-size: 1.42rem;
        font-weight: 800;
        line-height: 1.2;
        letter-spacing: -0.01em;
        color: var(--ink);
    }
    /* The plate is the top of the card, so the title needs no space above it. */
    .plate + .card-title { padding-top: 0; }
    .doc > .card-title:first-child { padding-top: 22px; }

    /* A hairline under the title separates "who this is" from "what they're saying". */
    .card-title + * { margin-top: 14px; }
    .card-title::after {
        content: "";
        display: block;
        width: 38px;
        height: 3px;
        margin-top: 10px;
        border-radius: 2px;
        background: var(--card-accent);
    }

    /* An inline picture stays inside the text column — it illustrates, it is not the masthead. */
    .card-art { display: block; width: 100%; border-radius: 12px; margin: 4px 0 14px; }
    .card-art.pending {
        aspect-ratio: 600 / 260;
        display: flex;
        align-items: flex-end;
        padding: 12px 14px;
        background: var(--brand-tint);
        color: var(--ink-3);
        font-size: 0.85rem;
    }

