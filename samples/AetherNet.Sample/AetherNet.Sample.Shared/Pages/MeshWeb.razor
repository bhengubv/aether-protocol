@page "/meshweb"
@using AetherNet.Sample.Shared.Services
@implements IDisposable
@inject MeshWebService Mesh

<PageTitle>Aether — AetherNet</PageTitle>

<div class="browser">
    <div class="omnibox">
        <span class="lock" aria-hidden="true">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round"><rect x="5" y="11" width="14" height="9" rx="2"/><path d="M8 11V8a4 4 0 0 1 8 0v3"/></svg>
        </span>
        <span class="scheme">aether://</span>
        <input class="addr" @bind="_address" @bind:event="oninput" @onkeydown="OnKey"
               placeholder="tag / name" spellcheck="false" autocapitalize="off" />
        <button class="go" disabled="@_busy" @onclick="Open" aria-label="Go">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
        </button>
    </div>

    <div class="tabs">
        @foreach (var name in Mesh.Pages)
        {
            <button class="bm @(_address == $"{Mesh.LocalTag}/{name}" ? "on" : null)" @onclick="@(() => Go(Mesh.Address(name)))">@name</button>
        }
        @foreach (var card in Mesh.SavedCards)
        {
            <button class="bm saved @(_address == TrimScheme(card.Address) ? "on" : null)" @onclick="@(() => Go(card.Address))">🔖 @card.Title</button>
        }
        @if (Mesh.PeerSiteAddress is { } peer && !Mesh.SavedCards.Any(c => c.Address == peer))
        {
            <button class="bm peer" @onclick="@(() => Go(peer))">★ nearby phone</button>
        }
    </div>

    <div class="page">
        @if (_page is { Ok: true } p)
        {
            <div class="doc">@((MarkupString)p.Html!)</div>
            <div class="siteinfo">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="5" y="11" width="14" height="9" rx="2"/><path d="M8 11V8a4 4 0 0 1 8 0v3"/></svg>
                @if (p.Own)
                {
                    <span>your page · <span class="mono">@p.AuthorTag</span></span>
                }
                else
                {
                    <span>signed by <span class="mono">@p.AuthorTag</span></span>
                    @if (p.Remote)
                    {
                        <span class="air">· fetched over @Mesh.RadioName</span>
                    }
                    else
                    {
                        <span class="offline">· saved offline</span>
                    }
                }
            </div>
        }
        else if (_page is { Ok: false } f)
        {
            <div class="err">Couldn't reach <span class="mono">@f.Address</span><br />@f.Error</div>
        }
        else
        {
            <div class="muted">Resolving…</div>
        }
    </div>
</div>

@code {
    private string _address = "";
    private MeshWebService.MeshPage? _page;
    private bool _busy;
    private bool _autoOpened;

    protected override async Task OnInitializedAsync()
    {
        Mesh.Changed += OnChanged;
        await Mesh.EnsureReadyAsync();
        await Go(Mesh.HomeAddress);
        if (Mesh.RadioAvailable && !Mesh.RadioLinked)
            Mesh.LinkRadio();
    }

    private void OnChanged() => _ = InvokeAsync(async () =>
    {
        if (!_autoOpened && !_busy && Mesh.PeerSiteAddress is { } peer)
        {
            _autoOpened = true;
            await Go(peer);
        }
        StateHasChanged();
    });

    private async Task Open()
        => await Go("aether://" + _address.Trim().TrimStart('/'));

    private async Task Go(string address)
    {
        if (_busy) return;
        _busy = true;
        StateHasChanged();
        try
        {
            _page = await Mesh.OpenAsync(address);
            _address = TrimScheme(address);
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task OnKey(KeyboardEventArgs e)
    {
        if (e.Key == "Enter") await Open();
    }

    private static string TrimScheme(string a) =>
        a.StartsWith("aether://", StringComparison.OrdinalIgnoreCase) ? a["aether://".Length..] : a;

    public void Dispose() => Mesh.Changed -= OnChanged;
}

<style>
    .browser { display: flex; flex-direction: column; gap: 11px; max-width: 720px; margin: 0 auto; }

    /* Address bar — a browser omnibox pill. */
    .omnibox { display: flex; align-items: center; gap: 8px; background: var(--surface); border: 1px solid var(--line); border-radius: 999px; padding: 7px 7px 7px 14px; box-shadow: var(--shadow-sm); }
    .lock { display: flex; color: var(--brand); }
    .lock svg { width: 16px; height: 16px; }
    .scheme { font-family: var(--mono); font-weight: 700; font-size: 0.82rem; color: var(--ink-3); }
    .addr { flex: 1 1 auto; min-width: 0; border: none; outline: none; background: transparent; font-family: var(--mono); font-size: 0.92rem; color: var(--ink); }
    .go { flex: 0 0 auto; width: 38px; height: 38px; border-radius: 50%; border: none; background: var(--brand); color: #fff; display: flex; align-items: center; justify-content: center; cursor: pointer; }
    .go:disabled { opacity: .5; }
    .go svg { width: 19px; height: 19px; }

    /* Bookmarks — a thin, horizontally-scrolling row. */
    .tabs { display: flex; gap: 7px; overflow-x: auto; scrollbar-width: none; padding: 0 2px 1px; }
    .tabs::-webkit-scrollbar { display: none; }
    .bm { flex: 0 0 auto; border: 1px solid var(--line); background: var(--surface); color: var(--ink-2); font-family: var(--mono); font-size: 0.8rem; font-weight: 600; padding: 6px 13px; border-radius: 999px; cursor: pointer; white-space: nowrap; }
    .bm.on { border-color: var(--brand); color: var(--brand); background: var(--brand-tint); }
    .bm.peer { border-color: var(--brand); color: var(--brand); background: var(--brand-tint); }
    .bm.saved { color: var(--ink-2); }
    .bm.saved.on { border-color: var(--brand); color: var(--brand); background: var(--brand-tint); }

    /* The page itself — the rendered card fills the view like a web page. */
    .page { min-height: 46vh; }
    .doc { }
    .siteinfo { display: flex; align-items: center; gap: 5px; font-size: 0.72rem; color: var(--ink-3); padding: 10px 6px 0; }
    .siteinfo svg { width: 13px; height: 13px; color: var(--ink-3); }
    .siteinfo .mono { font-family: var(--mono); }
    .siteinfo .air { color: var(--brand); font-weight: 600; }
    .siteinfo .offline { color: var(--ink-2); font-weight: 600; }

    .err { color: var(--ink-2); background: var(--surface); border: 1px solid var(--line); border-radius: 14px; padding: 18px; line-height: 1.5; }
    .err .mono { font-family: var(--mono); color: var(--ink); }
    .muted { color: var(--ink-3); font-style: italic; padding: 24px 6px; }
</style>
