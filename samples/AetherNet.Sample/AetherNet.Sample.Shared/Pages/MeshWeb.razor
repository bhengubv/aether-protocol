@page "/meshweb"
@using AetherNet.Sample.Shared.Services
@inject MeshWebService Mesh

<PageTitle>AetherNet — mesh-web</PageTitle>

<div class="mesh">
    <header>
        <h1>The mesh-web</h1>
        <p>A web page with <strong>no URL and no server</strong>. Type an <code>aether://</code>
            address, tap <em>Open</em>, and the page resolves and renders — over the mesh, on this
            device. No DNS, no HTTP, nothing in the middle.</p>
    </header>

    <section class="bar">
        <span class="scheme">aether://</span>
        <input class="addr" @bind="_address" @bind:event="oninput" @onkeydown="OnKey"
               placeholder="tag/name" spellcheck="false" autocapitalize="off" />
        <button class="btn" disabled="@_busy" @onclick="Open">Open</button>
    </section>

    <section class="links">
        <span class="lbl">This device serves:</span>
        @foreach (var name in Mesh.Pages)
        {
            <button class="chip" @onclick="@(() => Go(Mesh.Address(name)))">@name</button>
        }
    </section>

    @if (_page is { Ok: true } p)
    {
        <section class="viewport">
            @((MarkupString)p.Html!)
        </section>
        <section class="wire">
            <div class="row"><span class="k">Address</span><span class="v mono">@p.Address</span></div>
            <div class="row"><span class="k">Signed by</span><span class="v mono">@p.AuthorTag</span></div>
            <div class="row">
                <span class="k">Content</span>
                <span class="v mono">@Short(p.RootHash) · @p.Bytes B · @p.Chunks chunk(s) · v@(p.Version)</span>
            </div>
        </section>
    }
    else if (_page is { Ok: false } f)
    {
        <section class="viewport error">Couldn't open <span class="mono">@f.Address</span> — @f.Error</section>
    }
    else
    {
        <section class="viewport muted">Resolving the mesh-web…</section>
    }
</div>

@code {
    private string _address = "";
    private MeshWebService.MeshPage? _page;
    private bool _busy;

    protected override async Task OnInitializedAsync()
    {
        await Mesh.EnsureReadyAsync();
        await Go(Mesh.HomeAddress);
    }

    private async Task Open()
        => await Go("aether://" + _address.Trim().TrimStart('/'));

    private async Task Go(string address)
    {
        if (_busy) return;
        _busy = true;
        try
        {
            _page = await Mesh.OpenAsync(address);
            _address = TrimScheme(address);
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task OnKey(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
            await Open();
    }

    private static string TrimScheme(string a) =>
        a.StartsWith("aether://", StringComparison.OrdinalIgnoreCase) ? a["aether://".Length..] : a;

    private static string Short(string? hash) =>
        string.IsNullOrEmpty(hash) ? "" : hash.Length <= 16 ? hash : hash[..16] + "…";
}

<style>
    .mesh { max-width: 900px; margin: 0 auto; padding: 0 4px 24px; color: #2c3e50; }
    .mesh header h1 { font-size: 1.8rem; font-weight: 800; color: #2196F3; margin: 4px 0 6px; }
    .mesh header p { margin: 0 0 18px; max-width: 640px; line-height: 1.5; color: #4a5b6b; }
    .mesh code { font-family: ui-monospace, Menlo, Consolas, monospace; background: #eef4fb; color: #1976D2; padding: 1px 5px; border-radius: 5px; }

    .bar { display: flex; align-items: stretch; gap: 8px; background: #fff; border: 1px solid #cfd8e3; border-radius: 10px; padding: 6px 6px 6px 12px; margin-bottom: 12px; }
    .bar .scheme { align-self: center; font-family: ui-monospace, Menlo, Consolas, monospace; font-weight: 700; color: #8a97a6; }
    .bar .addr { flex: 1 1 auto; min-width: 0; border: none; outline: none; font-family: ui-monospace, Menlo, Consolas, monospace; font-size: 0.92rem; color: #2c3e50; background: transparent; }
    .bar .btn { flex: 0 0 auto; }

    .links { display: flex; flex-wrap: wrap; align-items: center; gap: 8px; margin-bottom: 16px; }
    .links .lbl { color: #8a97a6; font-size: 0.78rem; text-transform: uppercase; letter-spacing: 0.5px; }
    .chip { appearance: none; border: 1px solid #cfd8e3; background: #fff; color: #2c3e50; font-weight: 600; font-size: 0.85rem; padding: 7px 14px; border-radius: 999px; cursor: pointer; font-family: ui-monospace, Menlo, Consolas, monospace; }
    .chip:hover { border-color: #2196F3; color: #1976D2; }

    .btn { appearance: none; border: none; background: #2196F3; color: #fff; font-weight: 600; font-size: 0.9rem; padding: 10px 18px; border-radius: 8px; cursor: pointer; }
    .btn:hover:not(:disabled) { background: #1976D2; }
    .btn:disabled { opacity: 0.5; cursor: default; }

    .viewport { background: #f5f7fa; border: 1px solid #e2e8f0; border-radius: 12px; padding: 14px; margin-bottom: 12px; }
    .viewport.error { color: #2c3e50; font-style: italic; }
    .viewport.muted { color: #8a97a6; font-style: italic; }

    .wire { background: #fff; border: 1px solid #e2e8f0; border-radius: 10px; padding: 10px 16px; }
    .wire .row { display: flex; gap: 10px; align-items: baseline; padding: 4px 0; }
    .wire .k { flex: 0 0 84px; color: #8a97a6; text-transform: uppercase; font-size: 0.66rem; letter-spacing: 0.5px; }
    .wire .v { color: #4a5b6b; min-width: 0; overflow-wrap: anywhere; }
    .wire .mono { font-family: ui-monospace, Menlo, Consolas, monospace; }
</style>
