@page "/share"
@using AetherNet.Sample.Shared.Services
@using AetherNet.Sample.Shared.Data
@implements IDisposable
@inject IIdentityService Me
@inject IAppShareService App
@inject ITapShare Tap
@inject AppHandout Handout
@inject IWifiDirectGroup Group
@inject AetherStore Store
@inject MyPages Mine
@inject MeshWebService Web

<PageTitle>Aether — Touch My Blood</PageTitle>

<div class="tmb">
    <h1 class="scr-title">Touch My Blood</h1>
    <p class="lede">Give Aether to a friend standing next to you. No shop, no data, no account.</p>

    @if (!App.IsSupported)
    {
        <section class="card">
            <div class="warn">@(App.UnavailableReason ?? "this phone cannot hand over the app")</div>
        </section>
    }
    else if (_invite is null)
    {
        <section class="card">
            <div class="size">@Size</div>
            <div class="size-sub">that's the whole app — it comes off this phone, not the internet</div>

            @* The one thing a stranger reads before deciding to trust any of this. Without it their
               phone shows them a code, which is the same problem as an address. *@
            <label class="who">
                <span class="glabel">Your name</span>
                <input class="whoin" maxlength="@MyName.Longest" placeholder="Thabang"
                       value="@_name" @oninput="OnName" />
            </label>
            <div class="who-sub">
                They'll see <strong>@GuestGroup.Label(MyName.OrTag(_name, Me.AetherTag))</strong> on their phone.
            </div>

            <button class="primary block" @onclick="StartAsync" disabled="@_busy">
                @(_busy ? "Opening…" : "Start")
            </button>
            @if (_busy)
            {
                <div class="bar" role="progressbar" aria-label="Opening a network"><span></span></div>
            }
            @if (_busy && _doing is { Length: > 0 } step)
            {
                @* Hosting takes tens of seconds — waiting on the radio, backing off, walking channels.
                   The radio narrates all of it; without this the screen is a dead button and anybody
                   watching concludes the app has hung. *@
                <p class="doing">@step</p>
            }
            @if (_note is { } n)
            {
                <p class="warn">@n</p>
            }
        </section>
    }
    else
    {
        @if (Tap.IsSupported)
        {
            <section class="card tap @(_landed ? "landed" : "")">
                <div class="tap-mark">@(_landed ? "✓" : "◎")</div>
                <div class="tap-say">@(_landed ? "Got them." : "Touch the phones back to back")</div>
                <div class="tap-sub">
                    @(_landed
                        ? "Their phone is joining you now."
                        : "Their phone doesn't need Aether on it yet.")
                </div>
                @if (_network is { } net)
                {
                    <div class="netname">@net.NetworkName</div>
                }
                @if (_offBand)
                {
                    @* Their phone had to leave its own Wi-Fi to reach us. Said plainly, because the
                       friend WILL notice their internet stop and should hear it from you first. *@
                    <div class="offband">
                        While they're getting it, their phone leaves their own Wi-Fi. It comes back straight after.
                    </div>
                }
            </section>
        }
        else
        {
            <section class="card nonfc">
                <div class="tap-say">No touching on this phone</div>
                <div class="tap-sub">@(Tap.UnavailableReason ?? "this phone has no NFC")@(Tap.IsFixable ? " — switch it on and come back" : "")</div>
            </section>
        }

        <section class="card qr-card">
            <div class="glabel">@(Tap.IsSupported ? "Or let them scan this" : "Let them scan this")</div>
            <div class="qr">@((MarkupString)_qr)</div>
            <div class="qr-sub">Their normal camera works — nothing to install first.</div>
        </section>

        <section class="card status">
            <div class="row"><span>Taken by</span><strong>@Handout.Served of @AppHandout.MaxHandovers</strong></div>
            <div class="row"><span>Open for</span><strong>@Countdown</strong></div>
            <button class="ghost block" @onclick="StopSharing">Stop</button>
        </section>
    }
</div>

<style>
    .tmb { max-width: 720px; margin: 0 auto; display: flex; flex-direction: column; gap: 16px; }

    .scr-title { font-size: 1.9rem; font-weight: 830; letter-spacing: -0.02em; color: var(--ink); padding: 4px 2px 0; }
    .lede { font-size: 0.95rem; line-height: 1.5; color: var(--ink-2); padding: 0 2px; }

    .card { display: flex; flex-direction: column; align-items: center; gap: 10px; background: var(--surface); color: var(--on-surface); --ink: var(--on-surface); --ink-2: var(--on-surface); --ink-3: var(--on-surface); --brand: var(--on-surface); --line: rgba(255,255,255,.35); border: 1px solid var(--line-card); border-radius: var(--radius); padding: 22px 20px; box-shadow: var(--shadow-sm); }

    .size { font-size: 2.4rem; font-weight: 830; letter-spacing: -0.03em; color: var(--brand); line-height: 1; }
    .size-sub { font-size: 0.85rem; color: var(--ink-3); text-align: center; }

    /* The tap target. It is not a button — nothing is pressed, the phones are held together — so it
       reads as a state rather than a control. */
    .tap { padding: 30px 20px; }
    .tap-mark { font-size: 3.2rem; line-height: 1; color: var(--brand); animation: breathe 2.4s ease-in-out infinite; }
    .tap.landed .tap-mark { animation: none; }
    .tap-say { font-size: 1.15rem; font-weight: 800; color: var(--ink); text-align: center; }
    .tap-sub { font-size: 0.85rem; color: var(--ink-3); text-align: center; }
    .nonfc .tap-say { color: var(--ink-2); font-weight: 700; font-size: 1rem; }

    @@keyframes breathe { 0%, 100% { opacity: .35; transform: scale(.94); } 50% { opacity: 1; transform: scale(1); } }
    @@media (prefers-reduced-motion: reduce) { .tap-mark { animation: none; opacity: 1; } }

    .qr { width: 190px; height: 190px; background: #fff; border-radius: 12px; padding: 10px; }
    .qr svg { width: 100%; height: 100%; display: block; }
    .qr-sub { font-size: 0.82rem; color: var(--ink-3); text-align: center; }
    .glabel { font-size: 0.68rem; font-weight: 800; letter-spacing: 1px; text-transform: uppercase; color: var(--ink-3); }

    .status { align-items: stretch; gap: 8px; }
    .row { display: flex; align-items: center; justify-content: space-between; font-size: 0.9rem; color: var(--ink-2); }
    .row strong { color: var(--ink); font-family: var(--mono); }

    .primary { appearance: none; border: none; background: var(--surface-2); color: var(--on-surface-2); --ink: var(--on-surface-2); --ink-2: var(--on-surface-2); --ink-3: var(--on-surface-2); --brand: var(--on-surface-2); border: 1.5px solid var(--on-surface-2); font-weight: 700; font-size: 0.98rem; padding: 14px 18px; border-radius: 12px; cursor: pointer; }
    .primary:disabled { opacity: .45; cursor: default; }
    .ghost { appearance: none; background: transparent; border: 1px solid var(--line); color: var(--ink-2); font-weight: 700; font-size: 0.9rem; padding: 11px 16px; border-radius: 12px; cursor: pointer; margin-top: 4px; }
    .block { display: block; width: 100%; }

    .warn { color: var(--brand-deep); font-size: 0.86rem; font-weight: 600; text-align: center; }

    /* What their phone will show them. Worth putting in front of the giver so they can say the name
       out loud — "join Aether Thabo" is a sentence a person can help somebody with. */
    .netname { font-family: var(--mono); font-size: 0.8rem; color: var(--brand); letter-spacing: .04em; }

    .who { display: flex; flex-direction: column; gap: 6px; width: 100%; max-width: 340px; margin-top: 6px; }
    .whoin { width: 100%; padding: 12px 14px; border-radius: 12px; border: 1px solid var(--line); background: var(--surface); color: var(--on-surface); --ink: var(--on-surface); --ink-2: var(--on-surface); --ink-3: var(--on-surface); --brand: var(--on-surface); color: var(--ink); font-size: 1rem; font-weight: 600; }
    .whoin:focus-visible { outline: 2px solid var(--brand); outline-offset: 1px; }
    .who-sub { font-size: 0.8rem; color: var(--ink-3); text-align: center; max-width: 340px; }
    .who-sub strong { color: var(--brand); font-family: var(--mono); font-weight: 600; }
    /* Information. Red is an error, amber is a warning, blue is something worth knowing — nothing
       here has gone wrong, we are just saying what is about to happen. */
    .offband { font-size: 0.78rem; line-height: 1.45; color: var(--info); background: var(--info-bg); border-radius: var(--radius-sm); padding: 8px 12px; text-align: center; max-width: 340px; font-weight: 600; }
    .doing { font-size: 0.78rem; line-height: 1.4; color: var(--ink-3); text-align: center; max-width: 340px; margin: 0; font-family: var(--mono); }

    /* Indeterminate on purpose: the radio cannot say how far along it is, and a bar that pretends to
       know is a worse lie than one that only says "still working". */
    .bar { width: 100%; max-width: 340px; height: 4px; border-radius: 2px; background: var(--line); overflow: hidden; }
    .bar span { display: block; width: 40%; height: 100%; border-radius: 2px; background: var(--brand); color: #fff; --ink: #fff; --ink-2: #fff; --ink-3: #fff; animation: slide 1.4s ease-in-out infinite; }
    @@keyframes slide { 0% { transform: translateX(-100%); } 100% { transform: translateX(250%); } }
    @@media (prefers-reduced-motion: reduce) { .bar span { animation: none; width: 100%; opacity: .6; } }
</style>

@code {
    private string? _invite;
    private string _qr = "";
    private string? _note;
    private bool _busy;
    private bool _landed;
    private System.Threading.Timer? _tick;

    private string Size => App.SizeBytes > 0
        ? $"{App.SizeBytes / (1024 * 1024)} MB"
        : "—";

    private string Countdown => Handout.Remaining is { TotalSeconds: > 0 } left
        ? $"{(int)left.TotalMinutes}:{left.Seconds:00}"
        : "closed";

    private string _name = "";
    private string? _doing;
    private bool _sawBandAttempt;
    private bool _offBand;

    protected override void OnInitialized()
    {
        Handout.Changed += OnChanged;
        Handout.Delivered += OnDelivered;
        Tap.Tapped += OnTapped;
        Group.Status += OnRadio;
        Handout.Say += OnRadio;

        _name = MyName.Clean(Store.GetSetting(AetherStoreCardStore.NameKey));
    }

    /// <summary>
    /// Remember the name as it is typed.
    /// </summary>
    /// <remarks>
    /// Kept on this device and nowhere else. It is not an account and nobody is asked to prove it —
    /// the proof is that the person saying it is standing next to you.
    /// </remarks>
    /// <summary>
    /// The app has landed on their phone, so the network comes down.
    /// </summary>
    /// <remarks>
    /// While our group is up, the friend who joined it may be off their own Wi-Fi — one radio cannot
    /// always hold both, and the channel theirs is on may be one we are barred from sharing. Measured
    /// on a Redmi: internet gone, every time. The transfer takes about nine seconds; leaving the group
    /// open for the rest of the five-minute window turns that into five minutes of no internet for
    /// somebody who has just been given something.
    /// </remarks>
    private void OnDelivered()
    {
        // Everybody who was going to take it has: stop now rather than sit there holding their radio.
        if (Handout.Served >= AppHandout.MaxHandovers)
        {
            InvokeAsync(() => { StopSharing(); StateHasChanged(); });
            return;
        }

        // Otherwise leave a short window for the next person at the same table, then close.
        Handout.CloseSoon();
    }

    /// <summary>Show what the radio is doing while it does it.</summary>
    private void OnRadio(string step)
    {
        // Noted when it happens. Reading it off _doing afterwards never worked: by the time hosting
        // fails, _doing holds whatever the radio said LAST, which is not the line that explains why.
        if (step.Contains("asking for the band", StringComparison.OrdinalIgnoreCase))
            _sawBandAttempt = true;

        if (step.Contains("cost them their Wi-Fi", StringComparison.OrdinalIgnoreCase))
            _offBand = true;

        _doing = step;
        InvokeAsync(StateHasChanged);
    }

    private void OnName(ChangeEventArgs e)
    {
        _name = MyName.Clean(e.Value?.ToString());
        Store.SetSetting(AetherStoreCardStore.NameKey, _name);
    }

    private async Task StartAsync()
    {
        _busy = true;
        _note = null;
        _sawBandAttempt = false;
        _offBand = false;

        try
        {
            // Raise a network with this person's name on it. That name is the whole design: a raw
            // address under a browser's "not secure" warning is a thing people are taught to back
            // away from, and a network called after somebody is a thing they join without thinking.
            _network = GuestGroup.For(MyName.OrTag(_name, Me.AetherTag));
            var hosted = await Group.HostAsync(_network);

            if (hosted is null)
            {
                // Say which of the two it is. "Wouldn't start" covers a phone with the radio off and
                // a phone that simply cannot host in the band we insist on, and those need different
                // things from the person reading it.
                _note = _sawBandAttempt
                    ? "this phone can only host on 2.4GHz, and that would knock your friend off their "
                      + "own Wi-Fi — so nothing was opened"
                    : "couldn't open a network on this phone — Wi-Fi Direct wouldn't start";
                return;
            }

            _network = hosted;

            // Off the UI thread: opening the listener and reading the package size both touch the
            // file system, and this is the button somebody presses while a friend is watching.
            // Their own front door, not a special document. This is the thing a stranger reads before
            // deciding whether to accept anything, and it should be the same page anybody already on
            // AetherNet would find at this tag — one page, written once, seen by everybody.
            Handout.Card = Mine.Get(MyPages.Home)?.Doc
                ?? OwnCard.Load(Store.GetSetting(AetherStoreCardStore.OldCardKey), _name);

            // Their pictures, fetched now. The server that answers the tap has one shot at drawing
            // this page, and reaching into the mesh while a stranger's browser waits is a page that
            // hangs at the only moment it must not.
            Handout.Pictures = await PicturesOn(Handout.Card);

            var invite = await Task.Run(() => Handout.Start(from: MyName.OrTag(_name, Me.AetherTag)));

            if (invite is null)
            {
                _note = "couldn't start serving the app from this phone";
                await Group.LeaveAsync();
                return;
            }

            _invite = invite;
            _qr = QrSvg.Render(invite);
            _landed = false;

            // The tap carries the network, not an address. Their phone joins, sees no internet behind
            // it, and raises its own sign-in sheet — which is the only frame that a stranger's handset
            // will vouch for.
            ArmTap();

            _tick = new System.Threading.Timer(_ => OnChanged(), null, 1000, 1000);
        }
        finally { _busy = false; _doing = null; }
    }

    private WifiDirectCredentials? _network;
    /// <summary>
    /// Load the tap.
    /// </summary>
    /// <remarks>
    /// <para>
    /// One thing, not a choice. There was a switch here offering "network" or "whole install", which
    /// was a debugging control wearing product clothes — nobody handing a friend an app should be
    /// picking between two payload formats, and one of the two only worked on a phone at its setup
    /// screen, which is a moment that comes round every few years.
    /// </para>
    /// <para>
    /// What is left is the one that works on a phone somebody is already using: credentials in the
    /// format stock Android acts on. Measured — a handset with nothing installed read it and raised
    /// its own "connect to this network?" dialog, with nobody typing anything.
    /// </para>
    /// </remarks>
    private void ArmTap()
    {
        if (_network is not { } net) return;

        // The whole handover in one arming: the network, then the way in.
        //
        // Their phone joins on the first touch and has nowhere to go — the sign-in sheet needs a port
        // Android will not give an app, so nothing on their side speaks. The second message answers
        // that, and it is handed over on the read AFTER the credentials are taken, which is the same
        // touch if the phones are still together.
        var network = WifiHandover.Message(net.NetworkName, net.Passphrase);

        if (Handout.Package is { Length: > 0 } where)
        {
            Tap.ArmSequence(network, Ndef.Uri(where));
            return;
        }

        Tap.ArmRaw(network, $"the network {net.NetworkName}");
    }

    private void StopSharing()
    {
        Tap.Disarm();
        Handout.Stop();


        // The network goes with the offer. One left up is a phone quietly running an open door.
        if (_network is not null) { _ = Group.LeaveAsync(); _network = null; }
        _invite = null;
        _qr = "";
        _landed = false;
        _tick?.Dispose();
        _tick = null;
    }

    private void OnTapped() => _ = InvokeAsync(() => { _landed = true; StateHasChanged(); });

    private void OnChanged() => _ = InvokeAsync(() =>
    {
        // The handout closes itself when the window runs out; the screen should follow it rather than
        // sit there showing a QR code that stopped working a minute ago.
        if (_invite is not null && Handout.Invite is null) StopSharing();
        StateHasChanged();
    });

    /// <summary>Every picture a card names, as data this page can carry on its own.</summary>
    private async Task<IReadOnlyDictionary<string, string>> PicturesOn(CardDocument? card)
    {
        var found = new Dictionary<string, string>(StringComparer.Ordinal);

        foreach (var hash in (card?.Blocks ?? [])
            .Where(b => b.Kind == CardBlock.Image && CardBlock.IsUsableAssetHash(b.ContentHash))
            .Select(b => b.ContentHash!)
            .Distinct(StringComparer.Ordinal))
        {
            if (await Web.AssetAsync(hash) is { Length: > 0 } uri) found[hash] = uri;
        }

        return found;
    }

    public void Dispose()
    {
        Handout.Changed -= OnChanged;
        Handout.Delivered -= OnDelivered;
        Group.Status -= OnRadio;
        Handout.Say -= OnRadio;
        Tap.Tapped -= OnTapped;
        _tick?.Dispose();

        // Leaving the screen stops the offer. Nothing keeps serving because somebody wandered off.
        Tap.Disarm();
        Handout.Stop();
    }
}
