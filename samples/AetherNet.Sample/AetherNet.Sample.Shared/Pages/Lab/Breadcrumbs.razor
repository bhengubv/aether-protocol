@page "/lab/breadcrumbs"
@using AetherNet.Space.Models
@using AetherNet.Sample.Shared.Services.Lab
@implements IDisposable

@* Geo-pinned community noticeboards, standing up live in this page. Eighty-one phones, one per block of
   a geohash grid, each a real in-process node running the real aether-space breadcrumb service. Drop a
   note in the middle and watch it get carried: a phone that hears it and is inside the three-cell radius
   pulls it and re-hosts it for its own neighbours; a phone outside the radius hears it too but lets it
   fall, so the flood dies before it crosses the city. An emergency ignores the radius and rides every
   hop. Nothing here is mocked but the radio — the drop, the flood, the pull, the TTL, the prune are the
   shipping code the eight SDKs port. *@

<div class="bc">
    <header class="bc-head">
        <a class="bc-back" href="lab">← Lab</a>
        <h1>Geo noticeboards</h1>
        <p>Drop a note at a place. Passing devices carry and re-host it — but only within three cells, unless it's an emergency.</p>
    </header>

    <section class="bc-drop">
        <input class="bc-input" @bind="_note" @bind:event="oninput" placeholder="What's the notice?" />
        <div class="bc-drop-row">
            <label class="bc-ttl">
                TTL
                <select @bind="_ttl" disabled="@_demo.Busy">
                    <option value="24">24 h</option>
                    <option value="72">72 h</option>
                    <option value="168">168 h (1 week)</option>
                </select>
            </label>
            <button class="btn ink" disabled="@_demo.Busy" @onclick="() => Drop(BreadcrumbType.Notice)">Drop notice</button>
            <button class="btn ghost" disabled="@_demo.Busy" @onclick="() => Drop(BreadcrumbType.Emergency)">Drop emergency</button>
        </div>
    </section>

    @if (_demo.Current is { } cur)
    {
        <section class="bc-now">
            <div class="bc-now-main">
                <span class="bc-now-note">“@cur.Note”</span>
                <span class="bc-now-sub">@Label(cur.Type) · TTL @cur.TtlHours h · expires @cur.ExpiresAtUtc.ToString("MMM d HH:mm") UTC</span>
            </div>
            <div class="bc-now-carried">
                <span class="bc-now-big">@cur.CarriedBy<span class="bc-now-small">/@cur.Total</span></span>
                <span class="bc-now-lbl">carrying</span>
            </div>
        </section>
    }

    <section class="bc-gridwrap">
        <div class="bc-grid">
            @foreach (var d in _demo.Devices())
            {
                <div class="bc-cell @(d.InRadius ? "in-radius" : null)" title="@d.Cell (@d.Distance cells out)">
                    <span class="bc-node @Kind(d.Kind)"></span>
                </div>
            }
        </div>
        <div class="bc-legend">
            <span><i class="bc-node origin"></i> origin</span>
            <span><i class="bc-node carrying"></i> carrying &amp; re-hosting</span>
            <span><i class="bc-node refused"></i> heard it, out of range — dropped</span>
            <span><i class="bc-swatch"></i> the 3-cell radius</span>
        </div>
    </section>

    <section class="bc-life">
        <div class="bc-life-col">
            <div class="bc-life-title">Time to live</div>
            <p class="bc-life-note">A notice isn't forever. Seed one that was dropped ten days ago under a 72 h TTL, then let every device sweep its own store.</p>
            <div class="bc-life-btns">
                <button class="btn ghost" @onclick="() => _demo.SeedStaleNoticeAsync()">Seed a stale notice</button>
                <button class="btn ghost" @onclick="() => _demo.PruneExpired()">Prune expired</button>
            </div>
        </div>
        <div class="bc-life-col">
            <div class="bc-life-title">Scan from here</div>
            <p class="bc-life-note">What the origin device can see around it — the real radius-aware scan over its own store.</p>
            <div class="bc-life-btns">
                <button class="btn ghost" @onclick="() => Scan(1)">Scan · radius 1</button>
                <button class="btn ghost" @onclick="() => Scan(3)">Scan · radius 3</button>
            </div>
            @if (_scanned)
            {
                <div class="bc-scan">
                    @if (_scan.Count == 0)
                    {
                        <span class="bc-scan-empty">Nothing active in range.</span>
                    }
                    else
                    {
                        @foreach (var s in _scan)
                        {
                            <div class="bc-scan-row">
                                <span class="bc-scan-type">@Label(s.Type)</span>
                                <span class="bc-scan-hash">@(s.ContentHash[..10])</span>
                                <span class="bc-scan-exp">expires @s.ExpiresAtUtc.ToString("MMM d")</span>
                            </div>
                        }
                    }
                </div>
            }
        </div>
    </section>

    <section class="bc-log">
        @foreach (var line in _demo.Log())
        {
            <div class="bc-line @(line.Emphasis ? "on" : null)">@line.Text</div>
        }
        @if (_demo.Log().Count == 0)
        {
            <div class="bc-line bc-empty">Drop a notice and watch it travel.</div>
        }
    </section>
</div>

<style>
    .bc { padding: 16px 16px 32px; display: flex; flex-direction: column; gap: 16px; max-width: 560px; margin: 0 auto; }
    .bc-back { font-size: 13px; font-weight: 700; color: var(--ink); opacity: .6; text-decoration: none; }
    .bc-head h1 { margin: 8px 0 0; font-size: 26px; font-weight: 800; letter-spacing: -.4px; color: var(--ink); }
    .bc-head p { margin: 6px 0 0; font-size: 14px; font-weight: 500; color: var(--ink); opacity: .72; line-height: 1.45; }

    .bc-drop { display: flex; flex-direction: column; gap: 10px; }
    .bc-input { width: 100%; font: inherit; font-size: 15px; color: var(--ink); background: transparent; border: 1.5px solid var(--line); border-radius: 12px; padding: 12px 14px; }
    .bc-input::placeholder { color: var(--ink); opacity: .4; }
    .bc-drop-row { display: flex; flex-wrap: wrap; gap: 8px; align-items: center; }
    .bc-ttl { display: inline-flex; align-items: center; gap: 6px; font-size: 12px; font-weight: 700; text-transform: uppercase; letter-spacing: .6px; color: var(--ink); opacity: .7; }
    .bc-ttl select { font: inherit; font-size: 13px; font-weight: 600; text-transform: none; letter-spacing: 0; color: var(--ink); background: transparent; border: 1.5px solid var(--line); border-radius: 10px; padding: 8px 10px; }
    .btn.ink { margin-left: auto; }

    .bc-now { display: flex; align-items: center; gap: 12px; border: 1.5px solid var(--line-card); border-radius: 14px; padding: 12px 14px; }
    .bc-now-main { display: flex; flex-direction: column; gap: 3px; min-width: 0; flex: 1 1 auto; }
    .bc-now-note { font-size: 15px; font-weight: 700; color: var(--ink); }
    .bc-now-sub { font-size: 12px; font-weight: 600; color: var(--ink); opacity: .62; font-family: var(--mono); }
    .bc-now-carried { display: flex; flex-direction: column; align-items: center; flex: none; }
    .bc-now-big { font-size: 26px; font-weight: 800; color: var(--brand); line-height: 1; }
    .bc-now-small { font-size: 14px; font-weight: 700; opacity: .5; }
    .bc-now-lbl { font-size: 10px; font-weight: 800; letter-spacing: .8px; text-transform: uppercase; color: var(--ink); opacity: .55; }

    .bc-gridwrap { display: flex; flex-direction: column; gap: 12px; }
    .bc-grid { display: grid; grid-template-columns: repeat(9, 1fr); gap: 4px; }
    .bc-cell { aspect-ratio: 1; border-radius: 6px; display: flex; align-items: center; justify-content: center; background: transparent; transition: background .18s ease; }
    .bc-cell.in-radius { background: var(--brand-tint); }
    .bc-node { width: 54%; height: 54%; border-radius: 50%; border: 1.5px solid var(--line); background: transparent; transition: all .18s ease; }
    .bc-node.origin { background: var(--brand-deep); border-color: var(--brand-deep); box-shadow: 0 0 0 3px var(--brand-tint); }
    .bc-node.carrying { background: var(--brand); border-color: var(--brand); }
    .bc-node.refused { border-color: var(--ink); border-style: dashed; opacity: .5; background: transparent; }

    .bc-legend { display: flex; flex-wrap: wrap; gap: 12px; font-size: 11.5px; font-weight: 600; color: var(--ink); opacity: .8; }
    .bc-legend span { display: inline-flex; align-items: center; gap: 5px; }
    .bc-legend i.bc-node { width: 13px; height: 13px; flex: none; }
    .bc-swatch { width: 13px; height: 13px; border-radius: 4px; background: var(--brand-tint); border: 1px solid rgba(33,150,243,.35); flex: none; display: inline-block; }

    .bc-life { display: grid; grid-template-columns: repeat(auto-fit, minmax(230px, 1fr)); gap: 12px; }
    .bc-life-col { border: 1.5px solid var(--line-card); border-radius: 14px; padding: 13px 14px; display: flex; flex-direction: column; gap: 8px; }
    .bc-life-title { font-size: 12px; font-weight: 800; letter-spacing: 1px; text-transform: uppercase; color: var(--ink); opacity: .6; }
    .bc-life-note { font-size: 12.5px; font-weight: 500; line-height: 1.4; color: var(--ink); opacity: .7; margin: 0; }
    .bc-life-btns { display: flex; flex-wrap: wrap; gap: 8px; }
    .bc-life-btns .btn { padding: 9px 12px; font-size: 13px; }

    .bc-scan { display: flex; flex-direction: column; gap: 5px; margin-top: 4px; }
    .bc-scan-empty { font-size: 12.5px; font-style: italic; color: var(--ink); opacity: .55; }
    .bc-scan-row { display: flex; gap: 8px; align-items: baseline; font-size: 12px; font-family: var(--mono); color: var(--ink); }
    .bc-scan-type { font-weight: 800; opacity: .9; }
    .bc-scan-hash { opacity: .55; }
    .bc-scan-exp { margin-left: auto; opacity: .62; }

    .bc-log { display: flex; flex-direction: column; gap: 5px; border: 1.5px solid var(--line-card); border-radius: 14px; padding: 12px 14px; font-family: var(--mono); font-size: 12px; }
    .bc-line { color: var(--ink); opacity: .7; line-height: 1.5; }
    .bc-line.on { opacity: 1; font-weight: 700; color: var(--brand); }
    .bc-empty { font-style: italic; opacity: .5; }
</style>

@code {
    private BreadcrumbsDemo _demo = default!;
    private string _note = "Lost dog — brown, answers to Biko. Last seen by the shops.";
    private int _ttl = 72;
    private IReadOnlyList<SpaceBreadcrumb> _scan = Array.Empty<SpaceBreadcrumb>();
    private bool _scanned;

    protected override void OnInitialized()
    {
        _demo = new BreadcrumbsDemo();
        _demo.Changed += OnChanged;
    }

    private void OnChanged() => _ = InvokeAsync(StateHasChanged);

    private Task Drop(BreadcrumbType type) => _demo.DropAsync(_note, type, _ttl);

    private async Task Scan(int radius)
    {
        _scan = await _demo.ScanFromOriginAsync(radius);
        _scanned = true;
    }

    private static string Kind(BreadcrumbsDemo.CrumbKind k) => k switch
    {
        BreadcrumbsDemo.CrumbKind.Origin => "origin",
        BreadcrumbsDemo.CrumbKind.Carrying => "carrying",
        BreadcrumbsDemo.CrumbKind.Refused => "refused",
        _ => "",
    };

    private static string Label(BreadcrumbType t) => t switch
    {
        BreadcrumbType.Emergency => "Emergency",
        BreadcrumbType.Commerce => "Commerce",
        BreadcrumbType.Event => "Event",
        BreadcrumbType.JobPosting => "Job posting",
        _ => "Notice",
    };

    public void Dispose()
    {
        _demo.Changed -= OnChanged;
        _demo.Dispose();
    }
}
