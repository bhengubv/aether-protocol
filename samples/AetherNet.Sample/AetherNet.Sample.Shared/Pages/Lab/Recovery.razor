@page "/lab/recovery"
@using AetherNet.Sample.Shared.Services.Lab
@implements IDisposable

@* The identity is the words. Nothing else holds it.

   An AetherNet identity is an Ed25519 key pair whose private key is a 32-byte seed — exactly 256 bits,
   which map cleanly onto a 24-word BIP-39 phrase. You write down twenty-four ordinary words, and from
   those words alone the identity is rebuilt on any device. No server, no account, no custodian holds a
   copy; if the words are the only backup, the words are the only thing that can restore you. And the
   checksum means a mistyped word is rejected outright rather than quietly rebuilding a different
   identity — a wrong tag is worse than an error.

   Below is the real IdentityBackup / Bip39Mnemonic — the same standard phrase any conformant BIP-39
   wallet would produce, and the same bytes every AetherNet SDK reproduces. *@

<div class="rec">
    <header class="rec-head">
        <a class="rec-back" href="lab">← Lab</a>
        <h1>Recovery phrase</h1>
        <p>Turn an identity into 24 words, then rebuild the very same tag from those words on a fresh
           device — with no custodian anywhere in between.</p>
    </header>

    <section class="rec-dev card">
        <div class="rec-dev-top">
            <span class="rec-dev-name">This device</span>
            <button class="rec-regen" @onclick="Generate">↻ new identity</button>
        </div>
        <div class="rec-dev-tag">@_tagA</div>
        <div class="rec-dev-note">its private key is a 32-byte Ed25519 seed — the whole identity</div>
    </section>

    <section class="rec-phrase">
        <div class="rec-phrase-label">Write these down — they <b>are</b> the identity</div>
        <div class="rec-words">
            @for (var i = 0; i < _words.Length; i++)
            {
                <span class="rec-word"><span class="rec-word-n">@(i + 1)</span>@_words[i]</span>
            }
        </div>
    </section>

    <section class="rec-restore">
        <div class="rec-restore-label">A new device — type the words in (or edit one to see it caught)</div>
        <textarea class="rec-area" rows="3" value="@_entered" @oninput="OnEntered"></textarea>
        <div class="rec-restore-btns">
            <span class="rec-valid @(_valid ? "ok" : "bad")">@(_valid ? "✓ well-formed phrase" : "✗ not a valid phrase")</span>
            <span class="rec-spacer"></span>
            <button class="btn ghost" @onclick="CorruptOne">Mistype a word</button>
            <button class="btn ghost" @onclick="ResetPhrase">Reset</button>
            <button class="btn" @onclick="Recover" disabled="@string.IsNullOrWhiteSpace(_entered)">Recover identity</button>
        </div>
    </section>

    @if (_result is not null)
    {
        <section class="rec-out @(_match ? "good" : "warn")">
            <div class="rec-out-head">@_result</div>
            @if (_tagB is not null)
            {
                <div class="rec-out-tags">
                    <span>original <b>@_tagA</b></span>
                    <span>rebuilt <b>@_tagB</b></span>
                </div>
            }
        </section>
    }
</div>

<style>
    .rec { padding: 16px 16px 32px; display: flex; flex-direction: column; gap: 16px; }
    .rec-back { font-size: 13px; font-weight: 700; color: var(--ink); opacity: .6; text-decoration: none; }
    .rec-head h1 { margin: 8px 0 0; font-size: 26px; font-weight: 800; letter-spacing: -.4px; color: var(--ink); }
    .rec-head p { margin: 6px 0 0; font-size: 14px; font-weight: 500; line-height: 1.5; color: var(--ink); opacity: .72; }

    .rec-dev { padding: 14px 16px; display: flex; flex-direction: column; gap: 5px; }
    .rec-dev-top { display: flex; align-items: center; justify-content: space-between; gap: 10px; }
    .rec-dev-name { font-size: 12px; font-weight: 800; letter-spacing: .8px; text-transform: uppercase; color: var(--ink); opacity: .8; }
    .rec-regen { appearance: none; border: none; background: transparent; cursor: pointer; font: inherit; font-size: 12px; font-weight: 700; color: var(--ink); opacity: .8; }
    .rec-dev-tag { font-family: var(--mono); font-size: clamp(20px, 6vw, 28px); font-weight: 800; letter-spacing: 2px; color: var(--ink); word-break: break-all; }
    .rec-dev-note { font-size: 12.5px; font-weight: 500; color: var(--ink); opacity: .82; }

    .rec-phrase { display: flex; flex-direction: column; gap: 8px; }
    .rec-phrase-label { font-size: 12px; font-weight: 700; color: var(--ink); opacity: .75; }
    .rec-words { display: grid; grid-template-columns: repeat(auto-fill, minmax(120px, 1fr)); gap: 6px; }
    .rec-word { display: flex; align-items: baseline; gap: 7px; font-family: var(--mono); font-size: 13.5px; font-weight: 650;
        color: var(--ink); border: 1px solid var(--line); border-radius: 9px; padding: 7px 10px; min-width: 0; word-break: break-all; }
    .rec-word-n { flex: none; font-size: 10px; font-weight: 800; color: var(--ink); opacity: .45; min-width: 16px; }

    .rec-restore { display: flex; flex-direction: column; gap: 8px; }
    .rec-restore-label { font-size: 12px; font-weight: 700; color: var(--ink); opacity: .75; }
    .rec-area { width: 100%; box-sizing: border-box; font-family: var(--mono); font-size: 13.5px; line-height: 1.6; color: var(--ink);
        background: transparent; border: 1.5px solid var(--line); border-radius: 12px; padding: 11px 13px; resize: vertical; }
    .rec-area:focus { outline: 2px solid var(--brand-tint); border-color: var(--brand); }
    .rec-restore-btns { display: flex; flex-wrap: wrap; align-items: center; gap: 8px; }
    .rec-valid { font-size: 12px; font-weight: 700; }
    .rec-valid.ok { color: var(--brand); }
    .rec-valid.bad { color: var(--ink); opacity: .55; }
    .rec-spacer { flex: 1 1 auto; }

    .rec-out { border: 1.5px solid var(--line-card); border-radius: 14px; padding: 14px 16px; display: flex; flex-direction: column; gap: 8px; }
    .rec-out.good { border-color: var(--brand); }
    .rec-out-head { font-size: 14px; font-weight: 750; line-height: 1.45; color: var(--ink); }
    .rec-out-tags { display: flex; flex-wrap: wrap; gap: 6px 18px; font-family: var(--mono); font-size: 13px; color: var(--ink); opacity: .8; }
    .rec-out-tags b { font-weight: 800; opacity: 1; }
</style>

@code {
    // The demo runs in AetherNetService; this page shows it and passes on what the person does. The private key
    // stays there: this page only ever has the words and the tags.
    private RecoveryLabDemo _demo = null!;

    private string _tagA => _demo.TagA;
    private string[] _words => _demo.Words.ToArray();
    private string _entered => _demo.Entered;
    private bool _valid => _demo.Valid;
    private string? _result => _demo.Result;
    private string? _tagB => _demo.TagB;
    private bool _match => _demo.Match;

    protected override void OnInitialized()
    {
        _demo = new RecoveryLabDemo();
        _demo.Changed += OnChanged;
    }

    private void OnChanged() => InvokeAsync(StateHasChanged);

    private void Generate() => _demo.Generate();
    private void ResetPhrase() => _demo.ResetPhrase();
    private void CorruptOne() => _demo.CorruptOne();
    private void Recover() => _demo.Recover();
    private void OnEntered(ChangeEventArgs e) => _demo.Entered = e.Value?.ToString() ?? "";

    public void Dispose()
    {
        _demo.Changed -= OnChanged;
        _demo.Dispose();
    }
}
