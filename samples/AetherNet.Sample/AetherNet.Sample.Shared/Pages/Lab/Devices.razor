@page "/lab/devices"
@using AetherNet.Sample.Shared.Services.Lab
@using DeviceState = AetherNet.Sample.Shared.Services.Lab.DevicesLabDemo.DeviceState
@implements IDisposable

@* Adding a device, and taking one away, with no directory to ask.

   A user links a new device by having their long-term identity key sign the new device's public key;
   every other device and contact verifies that signature and admits the newcomer to the "self" set. To
   eject one — lost, seized, retired — the same identity key signs a revocation, gossiped out, and each
   peer that verifies it drops the device and refuses any session keyed to it. No central directory, no
   server: a forwarder cannot admit or revoke a device it does not hold the identity key for. And because
   the records are deterministic, every device that sees the same link and revocation — in any order —
   converges on the same answer.

   Below is the real DeviceLinkCodec, DeviceRevocationCodec / RevocationSet, and SyncReconciler. *@

<div class="dev">
    <header class="dev-head">
        <a class="dev-back" href="lab">← Lab</a>
        <h1>Devices &amp; revocation</h1>
        <p>Link a second device with a signed membership record, then gossip a revocation and watch a
           peer shut it out — all verified locally, with nothing central to consult.</p>
    </header>

    <section class="dev-id card">
        <div class="dev-id-label">Your identity — the long-term key that signs membership</div>
        <div class="dev-id-tag">@_userTag</div>
    </section>

    <section class="dev-devices">
        @foreach (var d in _devices)
        {
            <div class="dev-chip @d.State">
                <span class="dev-chip-name">@d.Name</span>
                <span class="dev-chip-state">@StateLabel(d.State)</span>
            </div>
        }
    </section>

    <section class="dev-step">
        <div class="dev-step-h">1 · Link a second device</div>
        <div class="dev-step-btns">
            <button class="btn" @onclick="Link" disabled="@(_bState != DeviceState.Unlinked)">Link "phone-B"</button>
            <button class="btn ghost" @onclick="ForgeLink">Forge a link (attacker's key)</button>
        </div>
        @if (_linkInfo is not null)
        {
            <div class="dev-res ok">@_linkInfo</div>
        }
        @if (_forgeLinkInfo is not null)
        {
            <div class="dev-res">@_forgeLinkInfo</div>
        }
    </section>

    <section class="dev-step">
        <div class="dev-step-h">2 · Revoke it, and gossip that to a contact</div>
        <div class="dev-step-btns">
            <button class="btn" @onclick="Revoke" disabled="@(_bState != DeviceState.Linked)">Revoke "phone-B" (lost)</button>
            <button class="btn ghost" @onclick="ForgeRevoke">Forge a revocation</button>
        </div>
        @if (_revInfo is not null)
        {
            <div class="dev-res ok">@_revInfo</div>
        }
        @if (_forgeRevInfo is not null)
        {
            <div class="dev-res">@_forgeRevInfo</div>
        }
    </section>

    <section class="dev-step">
        <div class="dev-step-h">3 · Everyone converges, whatever the gossip order</div>
        <div class="dev-step-btns">
            <button class="btn" @onclick="Reconcile">Reconcile link + revocation</button>
        </div>
        @if (_reconInfo is not null)
        {
            <div class="dev-res ok">@_reconInfo</div>
        }
    </section>

    <section class="dev-reset">
        <button class="btn ghost" @onclick="Reset">Reset demo</button>
    </section>
</div>

<style>
    .dev { padding: 16px 16px 32px; display: flex; flex-direction: column; gap: 16px; }
    .dev-back { font-size: 13px; font-weight: 700; color: var(--ink); opacity: .6; text-decoration: none; }
    .dev-head h1 { margin: 8px 0 0; font-size: 26px; font-weight: 800; letter-spacing: -.4px; color: var(--ink); }
    .dev-head p { margin: 6px 0 0; font-size: 14px; font-weight: 500; line-height: 1.5; color: var(--ink); opacity: .72; }

    .dev-id { padding: 14px 16px; display: flex; flex-direction: column; gap: 4px; }
    .dev-id-label { font-size: 12px; font-weight: 700; color: var(--ink); opacity: .85; }
    .dev-id-tag { font-family: var(--mono); font-size: clamp(20px, 6vw, 28px); font-weight: 800; letter-spacing: 2px; color: var(--ink); word-break: break-all; }

    .dev-devices { display: flex; flex-wrap: wrap; gap: 8px; }
    .dev-chip { display: flex; flex-direction: column; gap: 2px; border: 1.5px solid var(--line-card); border-radius: 12px; padding: 10px 14px; min-width: 120px; }
    .dev-chip-name { font-family: var(--mono); font-size: 13px; font-weight: 800; color: var(--ink); }
    .dev-chip-state { font-size: 11px; font-weight: 700; color: var(--ink); opacity: .6; }
    .dev-chip.Linked { border-color: var(--brand); }
    .dev-chip.Linked .dev-chip-state { color: var(--brand); opacity: 1; }
    .dev-chip.Revoked { opacity: .5; border-style: dashed; }

    .dev-step { border: 1.5px solid var(--line-card); border-radius: 14px; padding: 13px 15px; display: flex; flex-direction: column; gap: 9px; }
    .dev-step-h { font-size: 13px; font-weight: 800; color: var(--ink); }
    .dev-step-btns { display: flex; flex-wrap: wrap; gap: 8px; }
    .dev-res { font-size: 12.5px; font-weight: 600; line-height: 1.5; color: var(--ink); opacity: .78; word-break: break-word; }
    .dev-res.ok { opacity: .92; }

    .dev-reset { display: flex; }
</style>

@code {
    // The demo runs in AetherNetService; this page shows it and passes on what the person does. The identity keys
    // stay there: this page only sees what each step proved.
    private DevicesLabDemo _demo = null!;

    private string _userTag => _demo.UserTag;
    private DeviceState _bState => _demo.BState;
    private string? _linkInfo => _demo.LinkInfo;
    private string? _forgeLinkInfo => _demo.ForgeLinkInfo;
    private string? _revInfo => _demo.RevInfo;
    private string? _forgeRevInfo => _demo.ForgeRevInfo;
    private string? _reconInfo => _demo.ReconInfo;
    private IReadOnlyList<DevicesLabDemo.DeviceView> _devices => _demo.Devices;

    protected override void OnInitialized()
    {
        _demo = new DevicesLabDemo();
        _demo.Changed += OnChanged;
    }

    private void OnChanged() => InvokeAsync(StateHasChanged);

    private void Reset() => _demo.Reset();
    private void Link() => _demo.Link();
    private void ForgeLink() => _demo.ForgeLink();
    private void Revoke() => _demo.Revoke();
    private void ForgeRevoke() => _demo.ForgeRevoke();
    private void Reconcile() => _demo.Reconcile();

    private static string StateLabel(DeviceState s) => s switch
    {
        DeviceState.Linked => "in the self set",
        DeviceState.Revoked => "revoked",
        _ => "not linked",
    };

    public void Dispose()
    {
        _demo.Changed -= OnChanged;
        _demo.Dispose();
    }
}
