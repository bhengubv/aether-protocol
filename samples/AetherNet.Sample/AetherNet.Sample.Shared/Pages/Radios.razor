@page "/radios"
@using AetherNet.Sample.Shared.Services
@implements IDisposable
@inject IRadioMesh Radio

<PageTitle>AetherNet — radios</PageTitle>

<div class="radios">
    <header>
        <h1>Over-the-air</h1>
        <p>Every AetherNet radio lives in <strong>this one app</strong> — no second package. Pick a
            radio, tap <em>Connect</em> on both phones, and they link directly with no servers, no
            cell towers.</p>
    </header>

    <section class="picker">
        @foreach (var r in _radios)
        {
            <button class="chip @(r.Name == _selected ? "on" : null) @(r.Available ? null : "off")"
                    disabled="@(!r.Available)" @onclick="@(() => Pick(r.Name))">@r.Name</button>
        }
    </section>

    <section class="status">
        <div class="row"><span class="k">Radio</span><span class="v">@Radio.SelectedRadio</span></div>
        <div class="row"><span class="k">This phone</span><span class="tag">@Radio.LocalTag</span></div>
        <div class="row">
            <span class="k">Link</span>
            @if (Radio.IsLinked)
            {
                <span class="linked">● linked with @Radio.PeerTag</span>
            }
            else
            {
                <span class="v">not linked yet</span>
            }
        </div>
    </section>

    @if (!Radio.IsSupported)
    {
        <p class="unsupported">Radios only light up on a phone. On this host the link is inert.</p>
    }

    <section class="actions">
        <button class="btn" disabled="@_busy" @onclick="LinkRadio">Connect</button>
        <span class="hint">Tap Connect on both phones.</span>
    </section>
    <section class="actions">
        <input class="msg" @bind="_message" @bind:event="oninput" disabled="@(!Radio.IsLinked)" placeholder="Message to the other phone…" />
        <button class="btn" disabled="@(!Radio.IsLinked || string.IsNullOrWhiteSpace(_message))" @onclick="Send">Send over the air</button>
    </section>

    <section class="console">
        <div class="console-head">Radio log</div>
        <div class="log">
            @foreach (var line in _logNewestFirst)
            {
                <div class="line">@line</div>
            }
        </div>
    </section>
</div>

@code {
    private IReadOnlyList<string> _logNewestFirst = Array.Empty<string>();
    private IReadOnlyList<RadioInfo> _radios = Array.Empty<RadioInfo>();
    private string _selected = "";
    private string _message = "Hello from the other phone.";
    private bool _busy;

    private void Pick(string name) { Radio.SelectRadio(name); Refresh(); StateHasChanged(); }

    protected override void OnInitialized()
    {
        Radio.Changed += OnChanged;
        Refresh();
    }

    private void OnChanged() => _ = InvokeAsync(() => { Refresh(); StateHasChanged(); });

    private void Refresh()
    {
        _radios = Radio.Radios;
        _selected = Radio.SelectedRadio;
        _logNewestFirst = Radio.Log.Reverse().ToArray();
    }

    private async Task LinkRadio()
    {
        if (_busy) return;
        _busy = true;
        try { Radio.Link(); }
        finally { _busy = false; }
        await Task.CompletedTask;
    }

    private async Task Send()
    {
        if (!Radio.IsLinked || string.IsNullOrWhiteSpace(_message)) return;
        await Radio.SendTestAsync(_message);
    }

    public void Dispose() => Radio.Changed -= OnChanged;
}

<style>
    .radios { max-width: 900px; margin: 0 auto; padding: 0 4px 24px; color: #2c3e50; }
    .radios header h1 { font-size: 1.8rem; font-weight: 800; color: #2196F3; margin: 4px 0 6px; }
    .radios header p { margin: 0 0 18px; max-width: 640px; line-height: 1.5; color: #4a5b6b; }
    .status { background: #fff; border: 1px solid #e2e8f0; border-radius: 10px; padding: 12px 16px; margin-bottom: 16px; }
    .status .row { display: flex; gap: 10px; align-items: baseline; padding: 4px 0; }
    .status .k { flex: 0 0 90px; color: #8a97a6; text-transform: uppercase; font-size: 0.68rem; letter-spacing: 0.5px; }
    .status .v { color: #4a5b6b; }
    .status .tag { font-family: ui-monospace, Menlo, Consolas, monospace; font-weight: 700; letter-spacing: 0.5px; }
    .status .linked { color: #2196F3; font-weight: 700; }
    .unsupported { color: #6b7a89; font-style: italic; margin: 0 0 16px; }
    .actions { display: flex; flex-wrap: wrap; gap: 10px; margin-bottom: 16px; align-items: center; }
    .hint { color: #6b7a89; font-size: 0.82rem; }
    .picker { display: flex; flex-wrap: wrap; gap: 8px; margin-bottom: 16px; }
    .chip { appearance: none; border: 1px solid #cfd8e3; background: #fff; color: #2c3e50; font-weight: 600; font-size: 0.85rem; padding: 8px 14px; border-radius: 999px; cursor: pointer; }
    .chip.on { background: #2196F3; color: #fff; border-color: #2196F3; }
    .chip.off { opacity: 0.4; cursor: default; }
    .btn { appearance: none; border: none; background: #2196F3; color: #fff; font-weight: 600; font-size: 0.9rem; padding: 10px 16px; border-radius: 8px; cursor: pointer; }
    .btn:hover:not(:disabled) { background: #1976D2; }
    .btn:disabled { opacity: 0.5; cursor: default; }
    .msg { flex: 1 1 220px; box-sizing: border-box; border: 1px solid #cfd8e3; border-radius: 8px; padding: 10px 12px; font-size: 0.9rem; color: #2c3e50; }
    .msg:focus { outline: 2px solid #bcdcfb; border-color: #2196F3; }
    .console { background: #fff; border: 1px solid #e2e8f0; border-radius: 10px; overflow: hidden; }
    .console-head { padding: 8px 14px; background: #f5f7fa; border-bottom: 1px solid #e2e8f0; font-size: 0.72rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.6px; color: #8a97a6; }
    .log { display: flex; flex-direction: column-reverse; gap: 2px; height: 320px; overflow-y: auto; padding: 10px 14px; font-family: ui-monospace, Menlo, Consolas, monospace; font-size: 0.84rem; line-height: 1.5; color: #3b4a59; }
</style>
