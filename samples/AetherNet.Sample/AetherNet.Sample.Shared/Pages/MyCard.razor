@page "/mycard"
@using AetherNet.Sample.Shared.Services
@using AetherNet.Sample.Shared.Data
@implements IDisposable
@inject IIdentityService Me
@inject AetherStore Store

<PageTitle>Aether — Your card</PageTitle>

<div class="mine">
    <h1 class="scr-title">Your card</h1>
    <p class="lede">This is what someone sees when you hand them Aether. Pick a look, write what you like.</p>

    @* The look first, because it changes everything under it and choosing one is the whole
       difference between a page that looks designed and a page that looks filled in. *@
    <section class="card looks">
        <div class="glabel">Pick a look</div>
        <div class="lookrow">
            @foreach (var look in CardLook.All)
            {
                <button class="@(look.Key == _look.Key ? "look on" : "look")"
                        @onclick="() => ChooseLook(look.Key)">
                    <span class="look-name" style="font-family:@look.Display">@look.Name</span>
                    <span class="look-blurb">@look.Blurb</span>
                </button>
            }
        </div>
    </section>

    <section class="card">
        <label class="field">
            <span class="glabel">Your name</span>
            <input class="in" maxlength="@MyName.Longest" placeholder="Thabang"
                   value="@_card.Title" @oninput="OnTitle" />
        </label>
    </section>

    @for (var i = 0; i < _card.Blocks.Count; i++)
    {
        var index = i;
        var block = _card.Blocks[index];

        @if (!OwnCard.IsEditable(block))
        {
            continue;
        }

        <section class="card block">
            <div class="blockbar">
                <span class="glabel">@OwnCard.Label(block.Kind)</span>
                <div class="arrows">
                    <button class="tiny" @onclick="() => Move(index, -1)" disabled="@(index == 0)" aria-label="Move up">↑</button>
                    <button class="tiny" @onclick="() => Move(index, 1)" aria-label="Move down">↓</button>
                    <button class="tiny drop" @onclick="() => Drop(index)" aria-label="Remove">✕</button>
                </div>
            </div>

            @if (block.Kind == CardBlock.List)
            {
                @for (var j = 0; j < (block.Items?.Count ?? 0); j++)
                {
                    var item = j;
                    <input class="in" maxlength="@OwnCard.LongestValue" placeholder="One thing"
                           value="@block.Items![item]" @oninput="e => OnItem(index, item, e)" />
                }
                <button class="ghost small" @onclick="() => AddItem(index)">Add a line</button>
            }
            else if (block.Kind == CardBlock.KeyValue)
            {
                <input class="in" maxlength="@OwnCard.LongestValue" placeholder="Open = Mon to Sat"
                       value="@block.Value" @oninput="e => OnValue(index, e)" />
                <p class="hint">Put an = between the label and what it says.</p>
            }
            else if (block.Kind == CardBlock.Text)
            {
                <textarea class="in area" maxlength="@OwnCard.LongestValue" rows="3"
                          placeholder="A few words about you"
                          @oninput="e => OnValue(index, e)">@block.Value</textarea>
            }
            else
            {
                <input class="in" maxlength="@OwnCard.LongestValue" placeholder="A heading"
                       value="@block.Value" @oninput="e => OnValue(index, e)" />
            }
        </section>
    }

    <section class="card adds">
        <div class="glabel">Add to your card</div>
        <div class="addrow">
            @foreach (var kind in OwnCard.Writable)
            {
                <button class="ghost small" @onclick="() => Add(kind)" disabled="@Full">
                    @OwnCard.Label(kind)
                </button>
            }
        </div>
        @if (Full)
        {
            <p class="hint">That's as long as a card gets — it stays a card rather than a website.</p>
        }
    </section>

    @* Their card, drawn by the same renderer a stranger's phone will use. Not an impression of it. *@
    <section class="card preview">
        <div class="glabel">What they'll see</div>
        <iframe class="frame" title="Your card as a stranger sees it" srcdoc="@_preview"></iframe>
    </section>
</div>

<style>
    .mine { max-width: 720px; margin: 0 auto; display: flex; flex-direction: column; gap: 14px; }
    .scr-title { font-size: 1.9rem; font-weight: 830; letter-spacing: -0.02em; color: var(--ink); padding: 4px 2px 0; }
    .lede { font-size: 0.95rem; line-height: 1.5; color: var(--ink-2); padding: 0 2px; }

    .card { display: flex; flex-direction: column; gap: 10px; background: var(--surface); border: 1px solid var(--line-card); border-radius: var(--radius); padding: 16px 16px; box-shadow: var(--shadow-sm); }
    .glabel { font-size: 0.68rem; font-weight: 800; letter-spacing: 1px; text-transform: uppercase; color: var(--ink-3); }
    .hint { margin: 0; font-size: 0.76rem; color: var(--ink-3); }

    .lookrow { display: grid; grid-template-columns: repeat(auto-fit, minmax(150px, 1fr)); gap: 8px; }
    .look { text-align: left; display: flex; flex-direction: column; gap: 4px; padding: 11px 12px; border-radius: var(--radius-sm); border: 1px solid var(--line); background: transparent; cursor: pointer; }
    .look.on { border-color: var(--brand); background: var(--brand-tint); }
    .look-name { font-size: 1rem; font-weight: 700; color: var(--ink); }
    .look-blurb { font-size: 0.74rem; line-height: 1.4; color: var(--ink-2); }

    .field { display: flex; flex-direction: column; gap: 6px; }
    .in { width: 100%; padding: 11px 13px; border-radius: var(--radius-sm); border: 1px solid var(--line); background: var(--surface-2); color: var(--ink); font-size: 0.95rem; font-family: inherit; }
    .in:focus-visible { outline: 2px solid var(--brand); outline-offset: 1px; }
    .area { resize: vertical; line-height: 1.5; }

    .blockbar { display: flex; align-items: center; justify-content: space-between; gap: 8px; }
    .arrows { display: flex; gap: 4px; }
    .tiny { width: 30px; height: 30px; border-radius: var(--radius-sm); border: 1px solid var(--line); background: transparent; color: var(--ink-2); cursor: pointer; font-size: 0.85rem; }
    .tiny:disabled { opacity: .35; cursor: default; }
    .tiny.drop { color: var(--warn); }

    .addrow { display: flex; flex-wrap: wrap; gap: 6px; }
    .ghost { appearance: none; background: transparent; border: 1px solid var(--line); color: var(--ink-2); font-weight: 700; border-radius: var(--radius-sm); cursor: pointer; }
    .ghost.small { font-size: 0.82rem; padding: 8px 12px; }
    .ghost:disabled { opacity: .4; cursor: default; }

    .preview { gap: 12px; }
    .frame { width: 100%; height: 460px; border: 1px solid var(--line); border-radius: var(--radius-sm); background: #fff; }
</style>

@code {
    private CardDocument _card = new();
    private CardLook _look = CardLook.Of(null);
    private string _preview = "";

    private bool Full => _card.Blocks.Count >= OwnCard.MostBlocks;

    protected override void OnInitialized()
    {
        _card = OwnCard.Load(Store.GetSetting(OwnCard.Key), Store.GetSetting(MyName.Key));
        _look = OwnCard.LookOf(_card);
        Draw();
    }

    private void ChooseLook(string key)
    {
        OwnCard.SetLook(_card, key);
        _look = CardLook.Of(key);
        Save();
    }

    private void OnTitle(ChangeEventArgs e)
    {
        _card.Title = MyName.Clean(e.Value?.ToString());
        Store.SetSetting(MyName.Key, _card.Title);
        Save();
    }

    private void OnValue(int index, ChangeEventArgs e)
    {
        if (index < 0 || index >= _card.Blocks.Count) return;
        _card.Blocks[index].Value = e.Value?.ToString();
        Save();
    }

    private void OnItem(int index, int item, ChangeEventArgs e)
    {
        if (index < 0 || index >= _card.Blocks.Count) return;
        if (_card.Blocks[index].Items is not { } items) return;
        if (item < 0 || item >= items.Count) return;

        items[item] = e.Value?.ToString() ?? "";
        Save();
    }

    private void AddItem(int index)
    {
        if (index < 0 || index >= _card.Blocks.Count) return;
        (_card.Blocks[index].Items ??= []).Add("");
        Save();
    }

    private void Add(string kind) { OwnCard.Add(_card, kind); Save(); }
    private void Move(int index, int by) { OwnCard.Move(_card, index, by); Save(); }
    private void Drop(int index) { OwnCard.Remove(_card, index); Save(); }

    /// <summary>
    /// Written on every keystroke, deliberately.
    /// </summary>
    /// <remarks>
    /// There is no save button and nothing to lose. A card is a few hundred bytes of JSON into this
    /// device's own settings; the cost of writing it constantly is nothing, and the cost of somebody
    /// closing the screen having forgotten to press something is the card a stranger then sees.
    /// </remarks>
    private void Save()
    {
        OwnCard.Tidy(_card);
        Store.SetSetting(OwnCard.Key, _card.ToJson());
        Draw();
    }

    /// <summary>
    /// The preview is the real renderer, not an approximation of it.
    /// </summary>
    /// <remarks>
    /// Anything else would be two implementations of the same page, and the one nobody tests is the
    /// one a stranger actually reads.
    /// </remarks>
    private void Draw() =>
        _preview = CardPage.Render(_card, _card.Title, 51 * 1024 * 1024, "#");

    public void Dispose() { }
}
