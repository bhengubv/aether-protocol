@page "/newgroup"
@using AetherNet.Sample.Shared.Data
@using AetherNet.Sample.Shared.Services
@inject ChatService Messages
@inject ContactService Contacts
@inject NavigationManager Nav

<PageTitle>Aether — new group</PageTitle>

<div class="ng">
    <h1 class="scr-title">New group</h1>

    <input class="ng-name" @bind="_name" @bind:event="oninput" placeholder="Group name" maxlength="40" />

    <div class="ng-label">Who is in it</div>

    @if (_people.Count == 0)
    {
        <div class="ng-none">You have not added anyone yet. A group is made of people you already
            know — add someone first, then come back.</div>
    }
    else
    {
        <div class="ng-people">
            @foreach (var p in _people)
            {
                <button class="ng-row @(_picked.Contains(p.Tag) ? "on" : null)" @onclick="() => Toggle(p.Tag)">
                    <span class="av" style="background:@TagPalette.For(p.Tag)">@TagPalette.Initial(p.Tag)</span>
                    <span class="ng-tag">@p.Tag</span>
                    <span class="ng-tick">@(_picked.Contains(p.Tag) ? "✓" : "")</span>
                </button>
            }
        </div>
    }

    <button class="primary" disabled="@(!CanCreate)" @onclick="Create">
        @(_picked.Count == 0 ? "Pick at least one person" : $"Create with {_picked.Count} " + (_picked.Count == 1 ? "person" : "people"))
    </button>
</div>

@code {
    private string _name = "";
    private readonly HashSet<string> _picked = new(StringComparer.Ordinal);
    private IReadOnlyList<ContactRecord> _people = Array.Empty<ContactRecord>();
    private bool _busy;

    // Only people who have added you back can be in a group: a message to someone who has not is
    // one that can never be encrypted, and a group full of those is a group that does not work.
    protected override void OnInitialized() =>
        _people = Contacts.Contacts.Where(c => c.IsMutual).ToArray();

    private bool CanCreate => !_busy && _picked.Count > 0 && !string.IsNullOrWhiteSpace(_name);

    private void Toggle(string tag)
    {
        if (!_picked.Add(tag)) _picked.Remove(tag);
    }

    private async Task Create()
    {
        if (!CanCreate) return;
        _busy = true;
        var group = await Messages.CreateGroupAsync(_name, _picked);
        Nav.NavigateTo($"chat/{group.Id}");
    }
}

<style>
    .ng { max-width: 720px; margin: 0 auto; }
    .ng-name { width: 100%; border: 1px solid var(--line); background: var(--surface); color: var(--ink);
               border-radius: 14px; padding: 14px 16px; font-size: 1.05rem; font-weight: 650; }
    .ng-name:focus { outline: 2px solid var(--brand-tint); border-color: var(--brand); }
    .ng-label { font-size: 0.68rem; font-weight: 800; letter-spacing: 1px; text-transform: uppercase;
                color: var(--ink-3); padding-left: 4px; margin: 20px 0 8px; }
    .ng-none { color: var(--ink-3); font-size: 0.9rem; line-height: 1.5; padding: 10px 4px 20px; }
    .ng-people { display: flex; flex-direction: column; }
    .ng-row { appearance: none; border: none; background: transparent; cursor: pointer; display: flex;
              align-items: center; gap: 13px; padding: 11px 6px; border-bottom: 1px solid var(--line); text-align: left; }
    .ng-row.on { background: var(--brand-tint); border-radius: 12px; border-bottom-color: transparent; }
    .ng-row .av { flex: 0 0 auto; width: 44px; height: 44px; border-radius: 50%; display: flex;
                  align-items: center; justify-content: center; color: #fff; font-weight: 750; }
    .ng-tag { flex: 1 1 auto; font-family: var(--mono); font-weight: 680; color: var(--ink); }
    .ng-tick { flex: 0 0 auto; color: var(--brand); font-weight: 850; font-size: 1.1rem; }
    .primary { width: 100%; margin-top: 22px; border: none; border-radius: 14px; padding: 16px;
               background: var(--brand); color: #fff; font-weight: 750; font-size: 1rem; cursor: pointer; }
    .primary:disabled { opacity: .45; cursor: default; }
</style>
