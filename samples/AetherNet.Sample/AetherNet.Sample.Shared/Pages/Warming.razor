@using AetherNet.Sample.Shared.Services
@implements IDisposable
@inject WarmUpService Warm

@*
    The app getting ready, in front of you rather than behind your back.

    Everything here used to happen lazily — the identity unsealed on first read, the databases opened
    when a page asked, the radios linked when somebody tapped Connect, the Wi-Fi Direct group formed
    only when a call needed it. Each of those is a stall in front of a person who has just asked for
    something, and together they made a mesh that works look like a mesh that hesitates.

    So the waiting moves here, where nothing has been asked for yet and there is something to watch.
    The animation is not decoration over a progress bar: the mesh IS the progress. Each capability
    lights its own node as it comes up, the links draw between them, and when the picture is whole the
    app opens. Nothing is faked and no delay is added — it is on screen exactly as long as the work
    takes.
*@

<div class="warm">
    <div class="warm-stage">
        <svg viewBox="0 0 260 260" fill="none" xmlns="http://www.w3.org/2000/svg">
            <!-- Links from the centre outward. Each lights when the capability at its far end is up,
                 so the mesh grows outward from you as the phone becomes able to do things. -->
            <g stroke-linecap="round" stroke-width="1.6">
                @foreach (var n in Nodes.Skip(1))
                {
                    <line x1="130" y1="130" x2="@n.X" y2="@n.Y"
                          class="wl @Lit(n.Key)" />
                }
            </g>

            <!-- A packet on every link that is live, so a finished mesh is visibly carrying something
                 rather than merely drawn. -->
            @foreach (var n in Nodes.Skip(1).Where(n => State(n.Key) == WarmState.Ready))
            {
                <circle r="2.8" fill="currentColor" class="wp">
                    <animateMotion dur="2.4s" repeatCount="indefinite"
                                   path="@($"M130,130 L{n.X},{n.Y}")" />
                </circle>
            }

            <g>
                @foreach (var n in Nodes.Skip(1))
                {
                    <circle cx="@n.X" cy="@n.Y" r="8" class="wn @Lit(n.Key)" />
                }
            </g>

            <!-- You, at the centre. Ringed while there is still work to do. -->
            <circle cx="130" cy="130" r="19" class="wme-ring @(Warm.IsWarm ? "done" : null)" />
            <circle cx="130" cy="130" r="10" class="wme @Lit("identity")" />
        </svg>
    </div>

    <div class="warm-name">Aether</div>

    @* What is happening, one line, in the words someone would use. Not a log — the node that is
       lighting up already says where we are. *@
    <div class="warm-line">@Now</div>

    @* The radio survey, shown as a list rather than one line at a time. A person seeing four of
       eight found learns where the ceiling is — and that it is their device's, not ours. *@
    @if (Warm.Found.Count > 0)
    {
        <div class="warm-radios">
            <div class="warm-radios-head">@Warm.Found.Count(r => r.Present) of @Warm.Found.Count radios on this device</div>
            @foreach (var radio in Warm.Found)
            {
                <div class="warm-radio @(radio.Present ? "has" : "hasnt")">
                    <span class="wr-mark">@(radio.Present ? "✓" : "—")</span>
                    <span class="wr-name">@radio.Name</span>
                    @* "carries", not "carrying": every radio comes up at once and the widest one
                       through does the work, so no list drawn once can say which is moving traffic. *@
                    <span class="wr-note">@(radio.Present && radio.Carries ? "carries" : radio.Present ? "present" : "not on this device")</span>
                </div>
            }
        </div>
    }

@*  There was a "@Done of 10 ready" counter here.

    It counted warm-up steps, and warm-up steps are not on the screen: a person watching saw eight
    radios listed and a number counting to ten, so the one figure they were tracking was the one
    thing they could not name. The mesh already is the progress — a node lights per step, and you can
    see how many are left — and the line above says which step by name. The count above the radio
    list stays, because that one counts something you are looking at.  *@
</div>

@code {
    private CancellationTokenSource? _cts;

    /// <summary>Where each capability sits. The centre is you; everything else radiates from it.</summary>
    private sealed record Node(string Key, int X, int Y);

    /// <remarks>
    /// Every key here must be a key in <see cref="WarmUpService.Steps"/>. This one drifted: the node at
    /// (36,152) was keyed "bluetooth", and no step has been called that for some time, so it sat dark
    /// through every launch. A node that can never light is worse than no node — it reads as something
    /// that failed. It is the radio bring-up step, which is keyed "radiosup".
    ///
    /// The radio survey has no node of its own and does not need one: its whole display is the list
    /// underneath the mesh.
    /// </remarks>
    private static readonly Node[] Nodes =
    [
        new("identity",   130, 130),
        new("store",      130,  38),
        new("cards",      206,  74),
        new("chat",       224, 152),
        new("notes",      172, 216),
        new("calls",       88, 216),
        new("radiosup",    36, 152),
        new("wifidirect",  54,  74),
        new("internet",   130, 232),
    ];

    private WarmState State(string key) =>
        Warm.Steps.FirstOrDefault(s => s.Key == key)?.State ?? WarmState.Waiting;

    /// <summary>The class that decides how a node and its link are drawn.</summary>
    private string Lit(string key) => State(key) switch
    {
        WarmState.Ready => "on",
        WarmState.Working => "busy",
        WarmState.Absent => "absent",
        WarmState.Failed => "failed",
        _ => "",
    };

    /// <summary>The step being worked on, or the last thing that had something to say.</summary>
    private string Now
    {
        get
        {
            var busy = Warm.Steps.FirstOrDefault(s => s.State == WarmState.Working);
            if (busy is not null) return busy.Detail is { Length: > 0 } d ? $"{busy.Title} — {d}" : busy.Title;

            if (Warm.IsWarm) return "Ready";

            var last = Warm.Steps.LastOrDefault(s => s.State != WarmState.Waiting);
            return last?.Title ?? "Starting up";
        }
    }

    protected override async Task OnInitializedAsync()
    {
        Warm.Changed += OnChanged;
        _cts = new CancellationTokenSource();

        // Nothing to navigate to at the end. This is not a route any more: Routes renders it
        // INSTEAD of the router while the app is cold, so the handover is Routes noticing that the
        // warm-up finished. The one decision that came with it — a phone that has never been set up
        // belongs on the wizard — MainLayout was already making, and still does.
        await Warm.WarmAsync(_cts.Token);
    }

    private void OnChanged() => _ = InvokeAsync(StateHasChanged);

    public void Dispose()
    {
        Warm.Changed -= OnChanged;
        _cts?.Cancel();
        _cts?.Dispose();
    }
}

<style>
    /* Sized so eight lines fit the shortest phone we ship to without scrolling — the list is the
       point, and a list you have to scroll is a list nobody reads. */
    .warm-radios {
        display: flex; flex-direction: column; gap: 2px;
        margin: 10px auto 14px; width: 100%; max-width: 300px;
    }
    /* Quiet is said with a token, never with opacity.

       These three rules reached for opacity, and opacity on a parent multiplies with opacity on a
       child — so an absent radio's note rendered at 0.6 x 0.55 = 0.33 and measured 1.53:1 against the
       light ground. app.css raised --ink-3 from #8a97a6 to #5b6b7b for exactly this reason (2.6:1 was
       not enough), and this file threw the improvement away. --ink-3 alone is 4.7:1 light and 8.2:1
       dark, and still reads as quieter beside --ink at 13.7:1. Dark mode hid all of it: on a dark
       ground everything is muted, so washed-out text looks deliberate. */
    .warm-radios-head {
        font-size: 0.72rem; letter-spacing: 0.04em; text-transform: uppercase;
        color: var(--ink-3); margin-bottom: 6px;
    }
    .warm-radio {
        display: flex; align-items: baseline; gap: 8px;
        font-size: 0.78rem; line-height: 1.35;
    }
    .warm-radio .wr-mark { width: 12px; flex: none; text-align: center; }
    .warm-radio .wr-name { flex: 1 1 auto; }
    .warm-radio .wr-note { color: var(--ink-3); font-size: 0.72rem; }
    .warm-radio.has { color: var(--ink); }
    .warm-radio.has .wr-mark { color: var(--brand); }
    .warm-radio.hasnt { color: var(--ink-3); }

    .warm {
        position: fixed; inset: 0; background: var(--bg);
        display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 3px;
        overflow: hidden;
    }

    .warm-stage { width: min(66vw, 260px); aspect-ratio: 1; color: var(--brand); }
    .warm-stage svg { width: 100%; height: 100%; overflow: visible; }

    /* Waiting is faint, working pulses, ready is solid. Absent is drawn dashed and dim — present in
       the picture, honestly not there. Failed is the one warm colour on the screen. */
    .wl { stroke: var(--line); transition: stroke .5s ease, opacity .5s ease; opacity: .5; }
    .wl.busy { stroke: var(--brand); opacity: .5; animation: wpulse 1.1s ease-in-out infinite; }
    .wl.on { stroke: var(--brand); opacity: .75; }
    .wl.absent { stroke: var(--line); opacity: .3; stroke-dasharray: 3 5; }
    /* Absent is dashed and dim — nothing is there. Failed is a solid link to a HOLLOW node —
       something is there and did not come up. Shape rather than a second colour, so it reads the same
       to somebody who cannot tell one hue from another. */
    .wl.failed { stroke: var(--ink-3); opacity: .55; }

    .wn { fill: var(--line); transition: fill .5s ease, r .35s cubic-bezier(.2,1.5,.4,1); }
    .wn.busy { fill: var(--brand); animation: wpulse 1.1s ease-in-out infinite; }
    .wn.on { fill: var(--brand); r: 9; }
    .wn.absent { fill: var(--line); opacity: .45; }
    .wn.failed { fill: var(--bg); stroke: var(--ink-3); stroke-width: 2.5; }

    @@keyframes wpulse { 0%, 100% { opacity: 1; } 50% { opacity: .35; } }

    .wme { fill: var(--line); transition: fill .5s ease; }
    .wme.on { fill: var(--brand); }

    .wme-ring { fill: none; stroke: var(--brand); stroke-width: 2; opacity: .3;
                transform-box: fill-box; transform-origin: center;
                animation: wbreathe 2.4s ease-in-out infinite; }
    .wme-ring.done { animation: none; opacity: .5; }
    @@keyframes wbreathe {
        0%, 100% { transform: scale(1);    opacity: .3; }
        50%      { transform: scale(1.28); opacity: .06; }
    }

    .wp { opacity: .85; }

    .warm-name {
        margin-top: 30px; font-size: 1.9rem; font-weight: 830; letter-spacing: -0.03em; color: var(--ink);
    }
    .warm-line { color: var(--ink-2); font-size: .92rem; text-align: center; padding: 0 28px; min-height: 1.3em; }

    /* Someone who has asked for less movement gets the same information, still. */
    @@media (prefers-reduced-motion: reduce) {
        .wl.busy, .wn.busy, .wme-ring { animation: none; }
        .wp { display: none; }
    }
</style>
