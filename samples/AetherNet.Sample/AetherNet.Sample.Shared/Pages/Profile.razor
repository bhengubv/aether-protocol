@page "/you"
@using AetherNet.Sample.Shared.Data
@using AetherNet.Sample.Shared.Services
@inject IIdentityService Me
@inject IJSRuntime JS
@inject AetherStore Store
@inject NavigationManager Nav

@* Who you are on the mesh. How the app BEHAVES lives behind the gear, in Settings — one screen for
   identity, another for configuration, because a profile card was never a place a settings surface
   could grow, which is exactly why settings had nowhere to be. *@

<PageTitle>Aether — you</PageTitle>

<div class="you">
    <div class="profile">
        <span class="pav">@Initial</span>
        <div class="pinfo">
            <input class="pname pname-edit" @bind="_name" @bind:event="oninput" @onchange="SaveName"
                   placeholder="Add your name" maxlength="40" aria-label="Your display name" />
            <button class="ptag" @onclick="CopyTag">@(_copied ? "Copied ✓" : Me.AetherTag)</button>
        </div>
        <button class="gear" @onclick='() => Nav.NavigateTo("settings")' aria-label="Settings">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="3"/><path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 1 1-2.83 2.83l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-4 0v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 1 1-2.83-2.83l.06-.06a1.65 1.65 0 0 0 .33-1.82 1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1 0-4h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 1 1 2.83-2.83l.06.06a1.65 1.65 0 0 0 1.82.33H9a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 4 0v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 1 1 2.83 2.83l-.06.06a1.65 1.65 0 0 0-.33 1.82V9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 0 4h-.09a1.65 1.65 0 0 0-1.51 1z"/></svg>
        </button>
    </div>

    @* Your presence on AetherNet — pages this phone hosts, addressed by your tag. That is identity, so
       it sits with you rather than in Settings. *@
    <section class="group">
        <div class="glabel">You</div>
        <button class="about" @onclick="@(() => Nav.NavigateTo("/meshweb?mine=1"))">
            <span class="about-body">
                <span class="about-t">Your pages</span>
                <span class="about-s">what this phone puts on AetherNet — your tag is the domain</span>
            </span>
            <span class="chev">→</span>
        </button>
    </section>
</div>

@code {
    private bool _copied;

    /// <summary>Your chosen display name — loaded from the account, persisted on change. Local only.</summary>
    private string? _name;

    protected override void OnInitialized() => _name = Store.GetAccount().DisplayName;

    /// <summary>The avatar glyph: the initial of your name if you have set one, else of your tag.</summary>
    private string Initial
    {
        get
        {
            var source = !string.IsNullOrWhiteSpace(_name) ? _name!.Trim() : Me.AetherTag;
            return string.IsNullOrEmpty(source) ? "?" : source[..1].ToUpperInvariant();
        }
    }

    /// <summary>Persist the chosen name and its initial avatar. Never sent anywhere — the tag is the identity.</summary>
    private void SaveName() => Store.SaveAccount(_name?.Trim() ?? string.Empty, Initial);

    private async Task CopyTag()
    {
        try { await JS.InvokeVoidAsync("navigator.clipboard.writeText", Me.AetherTag); } catch { }
        _copied = true;
    }
}

<style>
    .you { max-width: 720px; margin: 0 auto; display: flex; flex-direction: column; gap: 26px; }

    .profile { display: flex; align-items: center; gap: 16px; padding: 12px 4px 4px; }
    .pav { width: 72px; height: 72px; border-radius: 50%; background: linear-gradient(135deg, var(--brand), var(--brand-deep)); color: #fff; display: flex; align-items: center; justify-content: center; font-weight: 800; font-size: 2rem; }
    .pinfo { display: flex; flex-direction: column; gap: 4px; min-width: 0; flex: 1 1 auto; }
    .pname { font-size: 1.5rem; font-weight: 800; color: var(--ink); }
    .pname-edit { appearance: none; border: none; background: transparent; padding: 0; width: 100%; min-width: 0; font-family: inherit; }
    .pname-edit::placeholder { color: var(--ink-3); opacity: .65; font-weight: 700; }
    .pname-edit:focus { outline: none; }
    .ptag { appearance: none; border: none; background: transparent; cursor: pointer; text-align: left; padding: 0; font-family: var(--mono); font-size: 0.95rem; font-weight: 700; letter-spacing: 1px; color: var(--brand); }
    .gear { appearance: none; border: none; background: transparent; color: var(--ink-2); cursor: pointer; padding: 8px; flex: none; width: 40px; height: 40px; }
    .gear svg { width: 100%; height: 100%; }

    .group { display: flex; flex-direction: column; gap: 10px; }
    .glabel { font-size: 0.68rem; font-weight: 800; letter-spacing: 1px; text-transform: uppercase; color: var(--ink-3); padding-left: 4px; }

    .about { display: flex; align-items: center; justify-content: space-between; gap: 12px; background: var(--surface); color: var(--on-surface); --ink: var(--on-surface); --ink-2: var(--on-surface); --ink-3: var(--on-surface); --brand: var(--on-surface); --line: rgba(255,255,255,.35); border: 1px solid var(--line); border-radius: 14px; padding: 15px 17px; box-shadow: var(--shadow-sm); }
    .about-body { display: flex; flex-direction: column; gap: 2px; }
    .about-t { font-weight: 700; color: var(--ink); font-size: 0.98rem; }
    .about-s { font-size: 0.82rem; color: var(--ink-2); }
    .chev { color: var(--ink-3); font-size: 1.2rem; font-weight: 700; }
</style>
