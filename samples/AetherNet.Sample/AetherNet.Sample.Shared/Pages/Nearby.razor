@page "/nearby"
@using AetherNet.Sample.Shared.Data
@using AetherNet.Sample.Shared.Services
@implements IDisposable
@inject ContactService Contacts
@inject IRadioMesh Radio
@inject NavigationManager Nav

<PageTitle>Aether — nearby</PageTitle>

<div class="nearby">
    <h1 class="scr-title">Nearby</h1>

    @if (Radio.IsLinked && Radio.PeerTag is { } peer)
    {
        <div class="linked-now">
            <span class="near-dot"></span>
            <span><span class="mono">@peer</span> is connected to this phone over @Radio.SelectedRadio</span>
        </div>
    }

    <div class="people">
        @foreach (var p in _people)
        {
            <button class="prow" @onclick="@(() => Nav.NavigateTo($"chat/{p.Tag}"))">
                <span class="av" style="background:@TagPalette.For(p.Tag)">
                    @TagPalette.Initial(p.Tag)@if (p.IsMutual) { <span class="near"></span> }
                </span>
                <span class="pmid">
                    <span class="pname">@p.Tag</span>
                    <span class="pstat">@State(p)</span>
                </span>
                <span class="msg">Message</span>
            </button>
        }
        @if (_people.Count == 0)
        {
            <div class="none">Nobody added yet.</div>
        }
    </div>

    <button class="connect" @onclick='() => Nav.NavigateTo("add")'>
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 5v14M5 12h14"/></svg><span>Add someone by their Aether name</span>
    </button>

    @if (Radio.Radios.Count > 0)
    {
        <div class="radios">
            <div class="radios-label">Connect over</div>
            <div class="chips">
                @foreach (var r in Radio.Radios)
                {
                    <button class="chip @(r.Name == Radio.SelectedRadio ? "on" : null) @(r.Available ? null : "off")"
                            disabled="@(!r.Available)" title="@r.Reason" @onclick="@(() => Pick(r.Name))">@r.Name</button>
                }
            </div>
            @{ var off = Radio.Radios.Where(r => !r.Available && r.Reason is not null).ToArray(); }
            @if (off.Length > 0)
            {
                <div class="why">
                    @foreach (var r in off)
                    {
                        <div><span class="why-name">@r.Name</span> — @r.Reason</div>
                    }
                </div>
            }
        </div>
    }

    @if (Radio.IsSupported)
    {
        <button class="connect @(Radio.IsLinked ? "linked" : null)" disabled="@Radio.IsLinked" @onclick="Radio.Link">
            @if (Radio.IsLinked)
            {
                <text>● Connected to a phone near you</text>
            }
            else
            {
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 5v14M5 12h14"/></svg><span>Connect a phone near you</span>
            }
        </button>
    }
</div>

@code {
    private IReadOnlyList<ContactRecord> _people = Array.Empty<ContactRecord>();

    protected override void OnInitialized()
    {
        Contacts.Changed += OnChanged;
        Radio.Changed += OnChanged;
        _people = Contacts.Contacts;
    }

    private void OnChanged() => _ = InvokeAsync(() => { _people = Contacts.Contacts; StateHasChanged(); });

    private void Pick(string name) { Radio.SelectRadio(name); StateHasChanged(); }

    private static string State(ContactRecord c) =>
        c.IsMutual ? "connected" : c.IsIncoming ? "wants to connect" : "waiting for them";

    public void Dispose() { Contacts.Changed -= OnChanged; Radio.Changed -= OnChanged; }
}

<style>
    .nearby { max-width: 720px; margin: 0 auto; }
    .scr-title { font-size: 1.9rem; font-weight: 830; letter-spacing: -0.02em; color: var(--ink); padding: 4px 4px 12px; }

    .people { display: flex; flex-direction: column; }
    .prow { appearance: none; border: none; background: transparent; cursor: pointer; display: flex; align-items: center; gap: 13px; padding: 11px 6px; border-bottom: 1px solid var(--line); text-align: left; }
    .prow:active { background: var(--surface-2); }

    .av { position: relative; flex: 0 0 auto; width: 50px; height: 50px; border-radius: 50%; background: var(--brand-deep); display: flex; align-items: center; justify-content: center; color: #fff; font-weight: 750; font-size: 1.2rem; }
    .pname { font-family: var(--mono); }
    .none { color: var(--ink-3); font-style: italic; padding: 18px 6px; }
    .linked-now { display: flex; align-items: center; gap: 10px; background: var(--surface); border: 1px solid var(--brand); border-radius: 12px; padding: 12px 14px; margin-bottom: 14px; color: var(--ink-2); font-size: 0.88rem; }
    .linked-now .mono { font-family: var(--mono); font-weight: 700; color: var(--ink); }
    .near-dot { width: 10px; height: 10px; border-radius: 50%; background: var(--brand); box-shadow: 0 0 0 4px var(--brand-tint); flex: 0 0 auto; }
    .radios { margin: 14px 0 4px; }
    .radios-label { font-size: 0.68rem; font-weight: 800; letter-spacing: 1px; text-transform: uppercase; color: var(--ink-3); padding-left: 4px; margin-bottom: 8px; }
    .chips { display: flex; flex-wrap: wrap; gap: 8px; }
    .chip { appearance: none; border: 1px solid var(--line); background: var(--surface); color: var(--ink-2); font-weight: 650; font-size: 0.82rem; padding: 8px 14px; border-radius: 999px; cursor: pointer; }
    .chip.on { border-color: var(--brand); color: var(--brand); background: var(--brand-tint); }
    .chip.off { opacity: .4; cursor: default; }
    .why { margin-top: 10px; padding-left: 4px; display: flex; flex-direction: column; gap: 3px; font-size: 0.78rem; color: var(--ink-3); line-height: 1.4; }
    .why-name { font-weight: 700; color: var(--ink-2); }
    .near { position: absolute; right: -1px; bottom: -1px; width: 14px; height: 14px; border-radius: 50%; background: var(--brand); border: 3px solid var(--bg); }

    .pmid { flex: 1 1 auto; min-width: 0; display: flex; flex-direction: column; gap: 2px; }
    .pname { font-weight: 680; font-size: 1.02rem; color: var(--ink); }
    .pstat { font-size: 0.8rem; color: var(--brand); font-weight: 600; }
    .msg { flex: 0 0 auto; font-size: 0.82rem; font-weight: 700; color: var(--brand); background: var(--brand-tint); padding: 7px 13px; border-radius: 999px; }

    .connect {
        width: 100%; margin-top: 18px; appearance: none; cursor: pointer;
        display: flex; align-items: center; justify-content: center; gap: 8px;
        background: transparent; border: 1.5px dashed var(--line); color: var(--ink-2);
        border-radius: 14px; padding: 15px; font-weight: 650; font-size: 0.95rem;
    }
    .connect:hover:not(:disabled) { border-color: var(--brand); color: var(--brand); }
    .connect svg { width: 20px; height: 20px; }
    .connect.linked { color: var(--brand); border-style: solid; border-color: var(--brand); }
</style>
