@page "/chat/{Peer}"
@using AetherNet.Sample.Shared.Data
@using AetherNet.Sample.Shared.Services
@using AetherNet.Voice.Models
@implements IDisposable
@inject ChatService Messages
@inject ContactService Contacts
@inject CallService Calls
@inject IRadioMesh Radio
@inject IMediaCapture Recorder
@inject GroupCallService GroupCalls
@inject NavigationManager Nav
@inject IJSRuntime JS

<PageTitle>Aether</PageTitle>

<div class="cv">
    <header class="cv-head">
        <button class="back" @onclick="Back" aria-label="Back">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M15 18l-6-6 6-6"/></svg>
        </button>
        <span class="av" style="background:@TagPalette.For(Peer)">
            @if (_group is not null)
            {
                <svg class="grp" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87M16 3.13a4 4 0 0 1 0 7.75"/></svg>
            }
            else
            {
                @TagPalette.Initial(Peer)
            }
        </span>
        <span class="cv-title">
            <span class="cv-name @(_group is not null ? "grp-name" : null)">@(_group?.Name ?? Peer)</span>
            <span class="cv-sub @(Connected && _secure ? "secure" : null) @(Connected ? null : "offline")">
                @if (Connected && _secure)
                {
                    <svg class="lock" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><rect x="4" y="10.5" width="16" height="10.5" rx="2.5"/><path d="M8 10.5V7a4 4 0 0 1 8 0v3.5"/></svg>
                }
                <span>@Status</span>
            </span>
        </span>

        @* Only offered when it could actually work. A greyed button with the reason beats one that
           rings out into nothing. *@
        @if (_group is not null)
        {
            <button class="callbtn" @onclick="CallGroup" aria-label="Call the group"
                    title="@("Call " + _group.Name)">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87M16 3.13a4 4 0 0 1 0 7.75"/></svg>
            </button>
        }
        else
        {
            <button class="callbtn" disabled="@(!CanCall)" title="@(CanCall ? $"Call {Peer}" : Calls.CannotCallReason)"
                    @onclick="Call" aria-label="Call">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6A19.79 19.79 0 0 1 2.12 4.18 2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.13.96.36 1.9.7 2.81a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.9.34 1.85.57 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
            </button>
        }
    </header>

    @* The call has its own screen — CallOverlay — which covers this one while it is up, and a bar
       pinned to the bottom while it is put away. There used to be a third call bar here, above the
       thread, from before that screen existed; it could only ever appear as a duplicate of the
       minimised one, so it is gone. *@

    <div class="cv-thread" @ref="_thread">
        @if (_messages.Count == 0)
        {
            <div class="cv-empty">Nothing here yet. Whatever you send is encrypted end-to-end and
                goes straight to their phone.</div>
        }
        @foreach (var m in _messages)
        {
            <div class="brow @(m.Mine ? "mine" : null)">
                @if (m.Mine)
                {
                    <div class="bub mine">
                        @if (m.HasAttachment) { <NoteBubble Message="m" /> } else { @m.Body }
                    </div>
                    <span class="tick @(m.State == ChatMessage.Failed ? "bad" : null)">@Tick(m.State)</span>
                }
                else
                {
                    var who = m.SenderTag ?? m.PeerTag;
                    <div class="bubwrap">
                        @if (_group is not null)
                        {
                            @* With more than two people you can no longer tell who is speaking from
                               which side the bubble is on, so the name is said outright, in theirs. *@
                            <span class="who" style="color:@TagPalette.For(who)">@who</span>
                        }
                        <div class="bub" style="box-shadow: inset 7px 0 0 @TagPalette.For(who)">
                            @if (m.HasAttachment) { <NoteBubble Message="m" /> } else { @m.Body }
                        </div>
                    </div>
                }
            </div>
        }
    </div>

    @* ONE composer, always. The recording state changes what is shown beside the microphone — it
       must never replace the microphone itself.

       The button is what receives the press. Swapping the composer out when recording began removed
       that button from the page mid-gesture, so the matching pointerup had nothing to land on and the
       recorder ran on after the finger lifted. Watched on merlin 2026-08-20: a four-second hold left
       it recording at 0:12. Same shape as the call buttons dropping taps — an element that handles a
       gesture cannot be destroyed part-way through one. *@
    <div class="cv-composer @(Calls.IsMinimised ? "under-call" : null) @(_recording ? "recording" : null)">
        @if (_recording)
        {
            <span class="rdot"></span>
            <span class="rtime">@Clock(Recorder.Elapsed)</span>
            <span class="rhint">Release to send · slide away to cancel</span>
        }
        else
        {
            <input class="cv-input" @bind="_draft" @bind:event="oninput" @onkeydown="OnKey" placeholder="Message" />
        }

        @if (string.IsNullOrWhiteSpace(_draft))
        {
            @* The buttons swap on what is typed, the way every messenger does it: nothing typed
               means you are more likely to be recording, and a draft means you are not. *@
            @if (Recorder.CanRecordVideo && !_recording)
            {
                <button class="cv-note" @onclick="RecordVideo" title="Video note" aria-label="Video note">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M23 7l-7 5 7 5V7z"/><rect x="1" y="5" width="15" height="14" rx="2"/></svg>
                </button>
            }

            <button class="cv-note mic @(_recording ? "live" : null) @(_starting ? "arming" : null)"
                    disabled="@(!Recorder.CanRecordVoice)"
                    title="@(Recorder.CanRecordVoice ? "Hold to record" : Recorder.UnavailableReason)"
                    aria-label="Hold to record a voice note"
                    @onpointerdown="StartNote" @onpointerup="StopNote"
                    @onpointerleave="CancelNote" @onpointercancel="CancelNote">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 1a3 3 0 0 0-3 3v8a3 3 0 0 0 6 0V4a3 3 0 0 0-3-3z"/><path d="M19 10v2a7 7 0 0 1-14 0v-2M12 19v4"/></svg>
            </button>
        }
        else
        {
            <button class="cv-send" @onclick="Send" aria-label="Send">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 2 11 13M22 2l-7 20-4-9-9-4z"/></svg>
            </button>
        }
    </div>

    @if (_noteProblem is not null)
    {
        <div class="cv-note-problem">@_noteProblem</div>
    }
</div>

@code {
    [Parameter] public string Peer { get; set; } = "";

    private IReadOnlyList<ChatMessage> _messages = Array.Empty<ChatMessage>();
    private string _draft = "";
    private bool _secure;

    private ElementReference _thread;
    private int _shown = -1;

    /// <summary>Set when this conversation is a group rather than a person.</summary>
    private GroupRecord? _group;

    /// <summary>
    /// The header answers two questions and never guesses at either: who this is, and whether the
    /// words are actually going anywhere. Reachability is Nearby's answer, not ours — this reads the
    /// radio rather than inferring a connection from the fact that a session key exists.
    /// </summary>
    private bool Connected => _group is not null
        ? Radio.IsLinked                                   // a group only needs the mesh, not one peer
        : Radio.IsLinked && Radio.PeerTag == Peer;

    private string Status =>
        _group is not null
            ? (Radio.IsLinked
                ? $"{Messages.GroupMembers(Peer).Count} people · end-to-end encrypted"
                : $"{Messages.GroupMembers(Peer).Count} people · not connected")
        : !Connected ? (Radio.IsLinked ? $"connected to someone else — not {Peer}" : "not connected")
        : _secure ? $"end-to-end encrypted over {Radio.LinkRadio}"
        : Contacts.Contacts.FirstOrDefault(c => c.Tag == Peer)?.IsMutual == true
            ? "setting up encryption…"
            : "waiting for them to add you back";

    protected override void OnInitialized()
    {
        Messages.Changed += OnChanged;
        Contacts.Changed += OnChanged;
        Radio.Changed += OnChanged;
        Calls.Changed += OnChanged;
        Recorder.Ticked += OnTicked;
        Recorder.Capped += OnCapped;

        // While this conversation is open it answers for itself, because a route can say WHICH chat
        // and nothing more. What makes a handoff feel alive is the half-written sentence and the
        // place in the thread, and only this page knows those.
        Messages.Holding = async () => Handoff.Describe(
            $"/chat/{Uri.EscapeDataString(Peer)}", _draft, await ScrollFractionAsync());

        // Somebody handed us this conversation. Pick up their sentence where they left it.
        if (Messages.TakeArriving() is { Kind: Handoff.Kind.Chat } handed &&
            string.Equals(handed.Target, Peer, StringComparison.Ordinal))
        {
            if (!string.IsNullOrEmpty(handed.Draft)) _draft = handed.Draft;
            _landOn = handed.At;
        }
    }

    /// <summary>Where they were in the thread, until it has been applied once.</summary>
    private double? _landOn;

    /// <summary>How far down this thread is scrolled, 0 to 1.</summary>
    private async Task<double?> ScrollFractionAsync()
    {
        try { return await JS.InvokeAsync<double>("aetherScrollFraction", _thread); }
        catch { return null; }          // a host without the helper, or a thread not yet rendered
    }

    // ── Calling ───────────────────────────────────────────────────────────────

    /// <summary>
    /// A call needs a microphone, a radio with a link on it, and a secure session — the same one the
    /// messages use, because a call is not sent in clear either.
    ///
    /// <para>
    /// Deliberately does <b>not</b> require the radio to have worked out who is on the other end yet.
    /// A link rebuilt seconds ago carries a fresh wire address and is anonymous again until something
    /// decrypts over it, and on BLE between two handsets that happens every minute or two — which left
    /// the call button greyed out most of the time for no good reason. The call is addressed to an
    /// AetherTag and sealed to it: if someone else is on the radio, they cannot open it. Who the radio
    /// currently thinks is there does not change who can read it.
    /// </para>
    /// </summary>
    private bool CanCall => Calls.Current is null && Radio.IsLinked && _secure && Calls.CanCall;

    private Task Call() => Calls.CallAsync(Peer);

    protected override async Task OnParametersSetAsync()
    {
        Refresh();
        // Start the Signal handshake as soon as the conversation opens, so the first message a person
        // types can leave immediately instead of sitting pending.
        await Messages.EnsureSessionAsync(Peer);
        Refresh();
    }

    /// <summary>
    /// Keep the newest message in view. A conversation is read from the bottom — opening one at the
    /// first thing ever said, or leaving a reply below the fold, is not what a messenger does.
    /// Only scrolls when the message count actually changed, so it never fights the user scrolling
    /// back through history.
    /// </summary>
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        // Land where they were standing, once, before the usual scroll-to-end takes over. Applied
        // after a render because the thread has to exist and have a height before a fraction of it
        // means anything.
        if (_landOn is { } where)
        {
            _landOn = null;
            _shown = _messages.Count;
            try { await JS.InvokeVoidAsync("aetherScrollToFraction", _thread, where); }
            catch { /* host without the helper */ }
            return;
        }

        if (_shown == _messages.Count) return;
        _shown = _messages.Count;
        try { await JS.InvokeVoidAsync("aetherScrollToEnd", _thread); } catch { /* host without the helper */ }
    }

    private void OnChanged() => _ = InvokeAsync(() => { Refresh(); StateHasChanged(); });

    private void Refresh()
    {
        _group = Messages.Group(Peer);
        _messages = Messages.Conversation(Peer);
        _secure = _group is not null || Messages.IsSecure(Peer);
    }

    private async Task Send()
    {
        var text = _draft;
        _draft = "";
        if (_group is not null) await Messages.SendToGroupAsync(Peer, text);
        else await Messages.SendAsync(Peer, text);
        Refresh();
    }

    private async Task OnKey(KeyboardEventArgs e)
    {
        if (e.Key == "Enter") await Send();
    }

    // ── Notes ─────────────────────────────────────────────────────────────────

    private bool _recording;
    private bool _starting;
    private string? _noteProblem;

    /// <summary>
    /// Press and hold. Asking for the microphone happens here, at the tap, because that is the moment
    /// the reason for asking is obvious — and the permission dialog is why the button shows an
    /// "arming" state rather than jumping straight to recording.
    /// </summary>
    private async Task StartNote()
    {
        if (_recording || _starting) return;

        _noteProblem = null;
        _starting = true;
        StateHasChanged();

        try
        {
            if (!await Recorder.EnsurePermissionAsync(video: false))
            {
                _noteProblem = "Aether needs the microphone to record a note.";
                return;
            }

            if (!await Recorder.StartVoiceAsync())
            {
                _noteProblem = Recorder.UnavailableReason ?? "Could not start recording.";
                return;
            }

            _recording = true;
        }
        finally
        {
            _starting = false;
            StateHasChanged();
        }
    }

    /// <summary>Let go, and it goes. Anything too short to be deliberate comes back as nothing.</summary>
    private async Task StopNote()
    {
        if (!_recording) return;
        _recording = false;
        StateHasChanged();

        var note = await Recorder.StopVoiceAsync();
        await SendNote(note, tooShort: "Hold the button to record.");
    }

    /// <summary>
    /// Sliding off the button throws the recording away. Every messenger has this, and people use it
    /// constantly — a note you have thought better of halfway through must not be sendable by
    /// accident.
    /// </summary>
    private async Task CancelNote()
    {
        if (!_recording) return;
        _recording = false;
        await Recorder.CancelAsync();
        StateHasChanged();
    }

    private async Task RecordVideo()
    {
        _noteProblem = null;

        if (!await Recorder.EnsurePermissionAsync(video: true))
        {
            _noteProblem = "Aether needs the camera and microphone to record a video note.";
            StateHasChanged();
            return;
        }

        var note = await Recorder.RecordVideoAsync();
        await SendNote(note, tooShort: "That was too short to send.");
    }

    /// <summary>
    /// One place where a finished recording becomes a message, so voice, video and the recorder's own
    /// cap all behave identically. A group has no attachment path yet — the transfer is addressed to
    /// one peer — and this says so rather than dropping the note without a word.
    /// </summary>
    private async Task SendNote(RecordedNote? note, string tooShort)
    {
        if (note is null)
        {
            _noteProblem = tooShort;
            StateHasChanged();
            return;
        }

        if (_group is not null)
        {
            _noteProblem = "Notes go to one person at a time for now.";
            StateHasChanged();
            return;
        }

        var sent = await Messages.SendNoteAsync(
            Peer, note.Bytes, note.ContentType, note.SuggestedName);

        if (!sent) _noteProblem = "Could not send that note.";

        Refresh();
        StateHasChanged();
    }

    /// <summary>The recorder stopped itself at the cap. Send what it got, and say what happened.</summary>
    private void OnCapped(RecordedNote? note)
    {
        _ = InvokeAsync(async () =>
        {
            _recording = false;
            await SendNote(note, tooShort: "That was too short to send.");
            _noteProblem = "A note can be up to " + (int)Recorder.MaxDuration.TotalSeconds + " seconds.";
            StateHasChanged();
        });
    }

    /// <summary>Redraw the running time. Ticks land on a timer thread, so it has to be marshalled.</summary>
    private void OnTicked()
    {
        if (_recording) _ = InvokeAsync(StateHasChanged);
    }

    private static string Clock(TimeSpan d) => d.Minutes + ":" + d.Seconds.ToString("00");

    private void Back() => Nav.NavigateTo("");

    /// <summary>
    /// Call everyone in the group. The service refuses and says why if nobody can be reached, so
    /// there is nothing to check here that it does not check better.
    /// </summary>
    private async Task CallGroup()
    {
        if (_group is null) return;
        await GroupCalls.StartAsync(_group.Id);
    }

    /// What we actually know, never more. One tick is not a delivery claim — only two is.
    private static string Tick(string state) => state switch
    {
        ChatMessage.Delivered => "✓✓",  // their phone confirmed it
        ChatMessage.Sent      => "✓",   // the radio took it; nothing has come back yet
        ChatMessage.Failed    => "!",   // no confirmation — treat it as not delivered
        _                     => "🕘",  // still here, waiting for a secure session
    };

    public void Dispose()
    {
        // Stop answering for a screen that is no longer open, or a tap would hand over a conversation
        // the person has already walked away from.
        Messages.Holding = null;

        Messages.Changed -= OnChanged;
        Contacts.Changed -= OnChanged;
        Radio.Changed -= OnChanged;
        Calls.Changed -= OnChanged;
        Recorder.Ticked -= OnTicked;
        Recorder.Capped -= OnCapped;

        // Leaving the conversation must not leave the microphone open. Nobody expects a note to keep
        // recording after they have navigated away, and one that did would be sent to whoever they
        // opened next.
        if (_recording) _ = Recorder.CancelAsync();
    }
}

<style>
    /* Height comes from the visual viewport, so when the keyboard opens the screen gets shorter
       rather than sliding — the header stays pinned at the top and the composer stays above the
       keys. --vvh is published by the host page; 100dvh is the fallback. */
    .cv { position: fixed; top: var(--vvt, 0px); left: 0; right: 0; height: var(--vvh, 100dvh); z-index: 40; display: flex; flex-direction: column; background: var(--bg); }

    /* Pinned: who you are talking to, and whether it is encrypted, must never scroll away — not
       when the thread scrolls and not when the keyboard opens. */
    .cv-head {
        flex: 0 0 auto; position: sticky; top: 0; z-index: 3;
        display: flex; align-items: center; gap: 11px;
        padding: max(env(safe-area-inset-top), 28px) 14px 10px;
        background: var(--surface); border-bottom: 1px solid var(--line);
    }
    .back { appearance: none; border: none; background: transparent; color: var(--ink); cursor: pointer; padding: 4px; margin: -4px; display: flex; }
    .back svg { width: 26px; height: 26px; }
    .cv-head .av { flex: 0 0 auto; width: 40px; height: 40px; border-radius: 50%; background: var(--brand); display: flex; align-items: center; justify-content: center; color: #fff; font-weight: 750; font-size: 1.05rem; }
    .cv-title { display: flex; flex-direction: column; gap: 1px; min-width: 0; flex: 1 1 auto; }

    /* Calling sits at the far end of the header, where a phone icon belongs. */
    .callbtn {
        flex: 0 0 auto; appearance: none; border: none; background: transparent;
        color: var(--brand); cursor: pointer; padding: 6px; margin: -6px -2px -6px 0; display: flex;
    }
    .callbtn svg { width: 23px; height: 23px; }
    .callbtn:disabled { color: var(--ink-3); opacity: .5; cursor: default; }

    .cv-name { font-family: var(--mono); font-weight: 700; font-size: 1rem; color: var(--ink); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
    /* A group has a name someone chose, not a tag — so it reads as words, not as an address. */
    .cv-name.grp-name { font-family: inherit; font-weight: 750; font-size: 1.06rem; }
    .cv-head .av .grp { width: 21px; height: 21px; }
    .bubwrap { display: flex; flex-direction: column; gap: 3px; max-width: 80%; }
    .who { font-size: 0.72rem; font-weight: 750; font-family: var(--mono); padding-left: 6px; }
    .cv-sub { font-size: 0.74rem; color: var(--ink-3); display: flex; align-items: center; gap: 4px; }
    .cv-sub.secure { color: var(--brand); font-weight: 600; }
    /* Not reachable is a state you must be able to see before you type, not after you send. */
    .cv-sub.offline { color: var(--ink-3); font-weight: 600; }
    .cv-sub.offline::before { content: ""; width: 7px; height: 7px; border-radius: 50%; background: var(--ink-3); flex: 0 0 auto; }
    .lock { width: 12px; height: 12px; flex: 0 0 auto; }

    .cv-thread { flex: 1 1 auto; overflow-y: auto; scrollbar-width: none; display: flex; flex-direction: column; gap: 8px; padding: 16px 14px; }
    .cv-thread::-webkit-scrollbar { display: none; }
    .cv-empty { color: var(--ink-3); font-size: 0.88rem; line-height: 1.5; text-align: center; padding: 32px 20px; }

    .brow { display: flex; align-items: flex-end; gap: 5px; }
    .brow.mine { justify-content: flex-end; }
    /* One bubble shape. Both fills are quiet — a thread is read for minutes at a time, so neither
       side is a saturated block of colour. Theirs is the page's inset; yours is a muted brand
       wash. The tail corner is the only thing that flips. */
    .bub { max-width: 100%; padding: 10px 14px 10px 21px; border-radius: 18px; border-bottom-left-radius: 5px; font-size: 0.96rem; line-height: 1.38; background: var(--surface-2); color: var(--ink); border: none; }
    .bub.mine { padding: 10px 14px; background: var(--brand-tint); border-bottom-left-radius: 18px; border-bottom-right-radius: 5px; }
    .tick { font-size: 0.68rem; color: var(--ink-3); padding-bottom: 2px; }
    /* A failure has to be seen, so it is the one place the app leaves the brand palette. */
    .tick.bad { color: #e5484d; font-weight: 850; font-size: 0.86rem; }

    .cv-composer {
        flex: 0 0 auto; display: flex; align-items: center; gap: 9px;
        padding: 10px 12px calc(env(safe-area-inset-bottom) + 12px);
        background: var(--surface); border-top: 1px solid var(--line);
    }
    .cv-input { flex: 1 1 auto; min-width: 0; border: 1px solid var(--line); background: var(--bg); color: var(--ink); border-radius: 22px; padding: 12px 16px; font-size: 0.98rem; }
    .cv-input:focus { outline: 2px solid var(--brand-tint); border-color: var(--brand); }

    /* Recording buttons match the send button's footprint exactly, so the composer does not jump as
       they swap on what is typed. */
    .cv-note {
        flex: 0 0 auto; width: 44px; height: 44px; border-radius: 50%; border: none; cursor: pointer;
        display: flex; align-items: center; justify-content: center;
        background: var(--surface-2); color: var(--ink-2); touch-action: none; user-select: none;
    }
    .cv-note svg { width: 20px; height: 20px; }
    .cv-note:disabled { opacity: 0.45; cursor: not-allowed; }
    .cv-note.mic:active, .cv-note.arming { background: var(--brand); color: #fff; }

    .cv-composer.recording { gap: 10px; align-items: center; }
    .cv-note.mic.live { background: var(--brand-deep); color: #fff; }
    .rdot { flex: 0 0 auto; width: 10px; height: 10px; border-radius: 50%; background: var(--brand-deep); animation: rpulse 1s ease-in-out infinite; }
    @@keyframes rpulse { 0%, 100% { opacity: 1; } 50% { opacity: 0.25; } }
    .rtime { font-variant-numeric: tabular-nums; font-weight: 700; color: var(--ink); }
    .rhint { flex: 1 1 auto; font-size: 0.78rem; color: var(--ink-3); min-width: 0; }
    .rcancel { flex: 0 0 auto; appearance: none; border: none; background: transparent; color: var(--brand-deep); font-weight: 650; cursor: pointer; padding: 8px; }

    /* The height of the minimised-call bar, so the composer clears it. */
    .cv-composer.under-call { margin-bottom: 46px; }

    .cv-note-problem { padding: 6px 16px 10px; font-size: 0.82rem; color: var(--brand-deep); background: var(--bg); }
