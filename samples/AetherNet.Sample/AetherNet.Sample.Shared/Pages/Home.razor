@page "/"
@using AetherNet.Sample.Shared.Data
@using AetherNet.Sample.Shared.Services
@implements IDisposable
@inject ContactService Contacts
@inject ChatService Chat
@inject NavigationManager Nav

<PageTitle>Aether</PageTitle>

<div class="chats">
    <h1 class="scr-title">Chats</h1>

    @if (_people.Count == 0)
    {
        <div class="empty">
            <div class="empty-mark"></div>
            <p class="empty-title">No one here yet</p>
            <p class="empty-body">Aether has no directory — you and a friend add each other, like
                swapping numbers. Then you can message with no towers and no accounts.</p>
            <button class="primary" @onclick='() => Nav.NavigateTo("add")'>Add someone</button>
        </div>
    }
    else
    {
        <div class="list">
            @foreach (var p in _people)
            {
                <button class="row" @onclick="@(() => Nav.NavigateTo($"chat/{p.Contact.Tag}"))">
                    <span class="av" style="background:@Colour(p.Contact.Tag)">
                        @p.Contact.Tag[..1]
                        @if (p.Contact.IsMutual)
                        {
                            <span class="near"></span>
                        }
                    </span>
                    <span class="mid">
                        <span class="top">
                            <span class="name">@p.Contact.Tag</span>
                            <span class="time">@Stamp(p.Last?.SentMs)</span>
                        </span>
                        <span class="prev">@Preview(p)</span>
                    </span>
                </button>
            }
        </div>

        <button class="fab" @onclick='() => Nav.NavigateTo("add")' aria-label="Add someone">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 20h9"/><path d="M16.5 3.5a2.1 2.1 0 0 1 3 3L7 19l-4 1 1-4z"/></svg>
        </button>
    }
</div>

@code {
    private sealed record Row(ContactRecord Contact, ChatMessage? Last);

    private IReadOnlyList<Row> _people = Array.Empty<Row>();

    protected override void OnInitialized()
    {
        Contacts.Changed += OnChanged;
        Chat.Changed += OnChanged;
        Refresh();
    }

    private void OnChanged() => _ = InvokeAsync(() => { Refresh(); StateHasChanged(); });

    private void Refresh()
    {
        var latest = Chat.Latest().ToDictionary(m => m.PeerTag, StringComparer.Ordinal);
        _people = Contacts.Contacts
            .Select(c => new Row(c, latest.TryGetValue(c.Tag, out var m) ? m : null))
            .OrderByDescending(r => r.Last?.SentMs ?? r.Contact.LastSeenMs)
            .ToArray();
    }

    private static string Preview(Row row)
    {
        if (row.Last is { } m)
            return (m.Mine ? "You: " : "") + m.Body;
        if (row.Contact.IsIncoming) return "Wants to connect — add them back";
        if (row.Contact.IsPending) return "Waiting for them to add you back";
        return "Say hello";
    }

    private static string Stamp(long? ms)
    {
        if (ms is null) return "";
        var when = DateTimeOffset.FromUnixTimeMilliseconds(ms.Value).ToLocalTime();
        var age = DateTimeOffset.Now - when;
        if (age < TimeSpan.FromMinutes(1)) return "now";
        if (age < TimeSpan.FromDays(1)) return when.ToString("HH:mm");
        return age < TimeSpan.FromDays(7) ? when.ToString("ddd") : when.ToString("dd/MM");
    }

    /// A stable colour per person, so the same tag always looks the same.
    private static string Colour(string tag)
    {
        var palette = new[] { "#2196F3", "#1976D2", "#4aa8ff", "#2c3e50", "#5c6f80" };
        var h = 0;
        foreach (var c in tag) h = unchecked(h * 31 + c);
        return palette[Math.Abs(h) % palette.Length];
    }

    public void Dispose()
    {
        Contacts.Changed -= OnChanged;
        Chat.Changed -= OnChanged;
    }
}

<style>
    .chats { max-width: 720px; margin: 0 auto; }
    .scr-title { font-size: 1.9rem; font-weight: 830; letter-spacing: -0.02em; color: var(--ink); padding: 4px 4px 10px; }

    .list { display: flex; flex-direction: column; }
    .row {
        appearance: none; border: none; background: transparent; cursor: pointer;
        display: flex; align-items: center; gap: 13px; padding: 11px 6px; text-align: left;
        border-bottom: 1px solid var(--line);
    }
    .row:active { background: var(--surface-2); }

    .av {
        position: relative; flex: 0 0 auto; width: 52px; height: 52px; border-radius: 50%;
        display: flex; align-items: center; justify-content: center;
        color: #fff; font-weight: 750; font-size: 1.25rem;
    }
    .near {
        position: absolute; right: -1px; bottom: -1px; width: 15px; height: 15px; border-radius: 50%;
        background: var(--brand); border: 3px solid var(--bg);
    }

    .mid { flex: 1 1 auto; min-width: 0; display: flex; flex-direction: column; gap: 3px; }
    .top { display: flex; align-items: baseline; justify-content: space-between; gap: 10px; }
    .name { font-family: var(--mono); font-weight: 700; font-size: 0.98rem; color: var(--ink); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
    .time { flex: 0 0 auto; font-size: 0.74rem; color: var(--ink-3); }
    .prev { font-size: 0.9rem; color: var(--ink-2); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }

    .empty { display: flex; flex-direction: column; align-items: center; text-align: center; gap: 12px; padding: 48px 24px; }
    .empty-mark { width: 56px; height: 56px; border-radius: 50%; background: conic-gradient(from 210deg, var(--brand), var(--brand-deep), var(--brand)); box-shadow: inset 0 0 0 10px var(--bg), 0 0 0 2px var(--brand); }
    .empty-title { font-size: 1.2rem; font-weight: 750; color: var(--ink); }
    .empty-body { font-size: 0.92rem; line-height: 1.55; color: var(--ink-2); max-width: 34ch; }

    .primary { appearance: none; border: none; background: var(--brand); color: #fff; font-weight: 700; font-size: 0.98rem; padding: 14px 22px; border-radius: 12px; cursor: pointer; margin-top: 6px; }

    .fab {
        position: fixed; right: 18px; z-index: 15;
        bottom: calc(var(--tab-h) + env(safe-area-inset-bottom) + 18px);
        width: 58px; height: 58px; border-radius: 20px; border: none;
        background: var(--brand); color: #fff; cursor: pointer;
        display: flex; align-items: center; justify-content: center;
        box-shadow: 0 10px 24px rgba(33, 150, 243, .4);
    }
    .fab:active { filter: brightness(.95); }
    .fab svg { width: 25px; height: 25px; }
</style>
