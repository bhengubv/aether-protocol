<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <RootNamespace>AetherMesh.BleRfTest</RootNamespace>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <Description>RF bring-up test: sends an Aether packet to the Android BLE node and verifies the echo response. Closes OPEN_ISSUES item 8.</Description>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../../src/AetherMesh.Transport.Windows/AetherMesh.Transport.Windows.csproj" />
    <ProjectReference Include="../../src/AetherMesh.Core/AetherMesh.Core.csproj" />
    <ProjectReference Include="../../src/AetherMesh.Security/AetherMesh.Security.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Logging.Console" Version="10.0.2" />
  </ItemGroup>

</Project>
