<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <RootNamespace>Aether.RelayRfTest</RootNamespace>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <Description>
      RF end-to-end test for the Aether Purple HTTP relay transport.
      Starts an in-process relay server on port 5200, creates two HttpRelayTransportService
      nodes (A and B), sends a packet A→B, echoes B→A, and prints round-trip latency.
    </Description>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../../src/Aether.Transport.Windows/Aether.Transport.Windows.csproj" />
    <ProjectReference Include="../../src/Aether.Core/Aether.Core.csproj" />
  </ItemGroup>


</Project>
