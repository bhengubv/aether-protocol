<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net9.0;net10.0</TargetFrameworks>
    <RootNamespace>AetherNet.Vault</RootNamespace>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <Description>Erasure-coded encrypted distributed backup for the Aether mesh — files sharded across peers, any K-of-N reconstruction.</Description>
    <PackageTags>mesh;vault;backup;erasure-coding;distributed;aether;encrypted</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../AetherNet.Core/AetherNet.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleToAttribute">
      <_Parameter1>AetherNet.Vault.Tests</_Parameter1>
    </AssemblyAttribute>
    <!-- Cross-language fixture generator (CrossLangFixtureGenerator) in AetherNet.Core.Tests
         uses the internal ReedSolomonCodec directly to emit fixtures/vault/. -->
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleToAttribute">
      <_Parameter1>AetherNet.Core.Tests</_Parameter1>
    </AssemblyAttribute>
  </ItemGroup>

</Project>
