@page "/welcome"
@layout EmptyLayout
@using Aether.Shared.Data
@using Aether.Shared.Services
@using Microsoft.Extensions.DependencyInjection
@using Microsoft.Extensions.Logging
@inject IIdentityService Me
@inject IRadioSetup Radios
@inject ContactService Contacts
@inject AetherStore Store
@inject NavigationManager Nav
@inject IServiceProvider Services
@implements IDisposable
@implements AetherNetNodeService.IAetherNodeEvents

<PageTitle>Aether — set up</PageTitle>

<div class="wiz">
    <div class="wiz-body">

        @if (_step == Step.Hello)
        {
            <div class="pane">
                <div class="mark"></div>
                <h1>Aether</h1>
                <p class="lede">Message the people around you with no towers, no accounts and no
                    company in the middle. Let's switch on the radios your phone already has.</p>
            </div>
        }
        else if (_step == Step.You)
        {
            <div class="pane">
                <div class="idcard">
                    <span class="id-label">This is you</span>
                    <span class="id-tag">@Me.AetherTag</span>
                    <span class="id-note">@Me.ProtectionDescription</span>
                </div>
                <h1>Your name on Aether</h1>
                <p class="lede">Nobody assigned it and nobody can take it — it comes from a key that
                    was just made on this phone and never leaves it. Share it and people can reach you.</p>
            </div>
        }
        else if (_step == Step.AetherNet)
        {
            <div class="pane">
                <h1>Switch on AetherNet?</h1>
                <p class="lede">AetherNet lets this phone reach the ones around it directly — no towers,
                    no accounts, no company in the middle — over the radios it already has. Leave it off
                    and Aether works over your normal internet instead. You can change this any time.</p>
                <label class="toggle">
                    <input type="checkbox" checked="@_aetherNet" @onchange="e => _aetherNet = (bool)(e.Value ?? false)" />
                    <span>Use the radios near me (AetherNet)</span>
                </label>
            </div>
        }
        else if (_step == Step.Radios)
        {
            <div class="pane">
                <h1>Switch on your radios</h1>
                <p class="lede">This is how your phone reaches the ones near it.</p>

                <div class="radios">
                    @foreach (var r in _radios)
                    {
                        <div class="radio @Css(r.State)">
                            <div class="r-top">
                                <span class="r-name">@r.Name</span>
                                <span class="r-pill">@Label(r)</span>
                            </div>
                            <div class="r-detail">@r.Detail</div>
                            @if (ActionFor(r) is { } action)
                            {
                                <button class="r-btn" disabled="@_busy" @onclick="() => Fix(r)">@action</button>
                            }
                        </div>
                    }
                </div>

                @if (_couldNotOpen is { } where)
                {
                    <p class="warn">@where</p>
                }

                @if (_blocking)
                {
                    <p class="warn">Aether can't reach anyone until Bluetooth is on.</p>
                }
            </div>
        }
        else if (_step == Step.Gateway)
        {
            <div class="pane">
                <h1>Share your connection?</h1>
                <p class="lede">If you have data, your phone can carry messages for people near you
                    who don't. They pay nothing, you choose, and you can switch it off any time.</p>
                <label class="toggle">
                    <input type="checkbox" checked="@_gateway" @onchange="e => _gateway = (bool)(e.Value ?? false)" />
                    <span>Let nearby phones use my connection</span>
                </label>
            </div>
        }
        else if (_step == Step.AddFirst)
        {
            <div class="pane">
                <h1>Add your first person</h1>
                <p class="lede">Aether has no search and no directory — you add each other, like
                    swapping numbers. Type their AetherTag, or have them show you theirs.</p>

                <input class="tagbox" @bind="_theirTag" @bind:event="oninput"
                       placeholder="e.g. KXJB7-MN2P4" spellcheck="false" autocapitalize="characters" />
                <button class="primary block" disabled="@(_busy || string.IsNullOrWhiteSpace(_theirTag))"
                        @onclick="AddFirst">Add them</button>

                @if (_addError is { } err)
                {
                    <p class="warn">@err</p>
                }
                @if (_added is { } who)
                {
                    <p class="ok">Added @who — they'll show up once they add you back.</p>
                }
                <p class="fineprint">You can skip this and add people later.</p>
            </div>
        }

    </div>

    <div class="wiz-foot">
        <div class="dots">
            @foreach (var s in AllSteps)
            {
                <span class="dot @(s == _step ? "on" : null)"></span>
            }
        </div>
        <button class="primary block" disabled="@(_busy || _blocking)" @onclick="Next">@NextLabel</button>
    </div>
</div>

@code {
    private enum Step { Hello, You, AetherNet, Radios, Gateway, AddFirst }

    private static readonly Step[] AllSteps = Enum.GetValues<Step>();

    private Step _step = Step.Hello;
    private IReadOnlyList<RadioStatus> _radios = Array.Empty<RadioStatus>();
    private bool _busy;
    private bool _gateway;
    private bool _aetherNet = true;
    private string _theirTag = "";
    private string? _addError;
    private string? _added;
    private IDisposable? _nodeSub;
    private IPhoneSettings? _phone;

    /// <summary>Where to go instead, when the phone would not open the page a radio's button asked for.</summary>
    private string? _couldNotOpen;

    private const string NoServicePage =
        "This phone would not open its settings — find AetherNetService under Settings, then Apps, and allow it there.";

    private const string NoPhonePage = "This phone would not open its settings — switch it on from the phone's Settings.";

    private bool _blocking => _step == Step.Radios && _radios.Any(r => r.IsBlocking);

    private string NextLabel => _step switch
    {
        Step.Hello => "Get started",
        Step.AddFirst => "Done",
        _ => "Continue",
    };

    protected override async Task OnInitializedAsync()
    {
        _gateway = Store.GetFlag(SetupKeys.GatewayEnabled);
        _aetherNet = Store.GetSetting(SetupKeys.AetherNet) != "0";   // default on
        _nodeSub = Services.GetService<AetherNetNodeService.IAetherNodeClient>()?.Subscribe(this);
        _phone = Services.GetService<IPhoneSettings>();
        if (_phone is not null) _phone.Back += OnBack;
        await RefreshRadios();
    }

    /// <summary>
    /// On a phone with AetherNetService the nearby radios are the service's, for every app there, so the choice made
    /// here goes to it — only when it changes something, because the service restarts to apply it. A head with no
    /// such switch keeps the choice in its own store, already written.
    /// </summary>
    private async Task TellServiceAsync(bool on)
    {
        // Named in full: this page's RadioStatus is the mesh's, and the service's namespace has one too.
        if (Services.GetService<AetherNetNodeService.IAetherNodeClient>() is not { } node) return;
        try
        {
            if ((await node.GetLinkAsync()).NearbyOn != on) await node.SetNearbyAsync(on);
        }
        catch (Exception ex)
        {
            // No service here, or one with no switch: the store has the choice, and Settings shows the service's.
            Services.GetService<ILogger<Welcome>>()?.LogInformation(ex, "AetherNetService did not take the AetherNet choice");
        }
    }

    private async Task RefreshRadios()
    {
        _radios = await Radios.CheckAsync();
        StateHasChanged();
    }

    private async Task Fix(RadioStatus radio)
    {
        if (_busy) return;
        _busy = true;
        StateHasChanged();
        try
        {
            // Both buttons have AetherNetService put up the phone's own prompt over this page — its "Allow?", or its
            // switch for Bluetooth, NFC or the networks — because the radios and what they need are the service's, and
            // the phone asks only for the app whose screen asks. The person stays here; back from the prompt, the radios
            // are asked again. Asked of the service through the menu, the button did nothing (1.4, 1.5); opening the
            // service's page in the phone's settings left the person to find the switch there (1.6 as first built).
            var serviceSettings = Services.GetService<AetherNetNodeService.Client.IAetherNetServiceSettings>();
            if ((radio.State is RadioState.NeedsPermission or RadioState.NeedsSystemToggle)
                && serviceSettings?.Ask(radio.Name) == true)
            {
                _couldNotOpen = null;
            }
            // An AetherNetService that cannot ask (1.5 and older): the page where it is done, opened from here.
            else if (radio.State == RadioState.NeedsPermission && serviceSettings is not null)
            {
                _couldNotOpen = serviceSettings.Open(AetherNetNodeService.PermissionPage.AppInfo) ? null : NoServicePage;
            }
            else if (radio.State == RadioState.NeedsSystemToggle && _phone is not null && SwitchFor(radio) is { } setting)
            {
                _couldNotOpen = _phone.Open(setting) ? null : NoPhonePage;
            }
            else
            {
                await Radios.RequestAsync(radio.Name);
            }
            await RefreshRadios();
        }
        finally { _busy = false; }
    }

    /// <summary>
    /// The phone's switch a radio is waiting on, read from what AetherNetService says is wrong — for an AetherNetService
    /// that cannot put up the phone's prompt itself — or null for the internet waiting on somebody in the Circle to
    /// relay, which no switch on this phone changes.
    /// </summary>
    private static PhoneSetting? SwitchFor(RadioStatus radio)
    {
        var why = radio.Detail ?? "";
        if (radio.Name == "Internet")
            return why.StartsWith("no internet", StringComparison.OrdinalIgnoreCase) ? PhoneSetting.Internet : null;

        // Below Android 12 Bluetooth, and below 13 Wi-Fi Direct and Wi-Fi Aware, find nobody with Location off.
        if (why.Contains("location", StringComparison.OrdinalIgnoreCase)) return PhoneSetting.Location;

        return radio.Name switch
        {
            "BLE" => PhoneSetting.Bluetooth,
            "NFC" => PhoneSetting.Nfc,
            _ => PhoneSetting.Settings,
        };
    }

    /// <summary>Switched off, but by nobody on this phone: the internet, until somebody in the Circle offers to relay.</summary>
    private static bool WaitsOnOthers(RadioStatus radio) =>
        radio.State == RadioState.NeedsSystemToggle && SwitchFor(radio) is null;

    private static string? ActionFor(RadioStatus radio) => WaitsOnOthers(radio) ? null : radio.ActionLabel;

    private static string Label(RadioStatus radio) => WaitsOnOthers(radio) ? "waiting" : Label(radio.State);

    // The phone tells no app when one of AetherNetService's permissions is allowed, at its prompt or on its page; the
    // service looks again every few seconds and pushes its link when that changes. So the radios show what was allowed
    // with nothing pressed.
    void AetherNetNodeService.IAetherNodeEvents.OnLinkChanged(AetherNetNodeService.NodeLinkStatus status) =>
        _ = InvokeAsync(RecheckRadios);

    // Nor does the service hear when Bluetooth, Location, NFC or the networks are switched, so the radios are asked
    // again whenever the person comes back to the app — from the phone's prompt or page for that switch, or from anywhere.
    private void OnBack() => _ = InvokeAsync(RecheckRadios);

    void AetherNetNodeService.IAetherNodeEvents.OnInbound(AetherNetNodeService.InboundMessage message) { }

    void AetherNetNodeService.IAetherNodeEvents.OnGrantChanged(AetherNetNodeService.GrantState state) { }

    private async Task RecheckRadios()
    {
        try
        {
            await RefreshRadios();
        }
        catch (Exception ex)
        {
            // The page keeps what it last showed; the next change, or the next press, asks again.
            Services.GetService<ILogger<Welcome>>()?.LogInformation(ex, "AetherNetService did not say how its radios stand");
        }
    }

    public void Dispose()
    {
        _nodeSub?.Dispose();
        if (_phone is not null) _phone.Back -= OnBack;
    }

    private async Task AddFirst()
    {
        _addError = null;
        _added = null;
        if (_busy) return;
        _busy = true;
        try
        {
            if (await Contacts.AddAsync(_theirTag, via: "typed"))
            {
                _added = _theirTag.Trim().ToUpperInvariant();
                _theirTag = "";
            }
            else
            {
                _addError = "That doesn't look like an AetherTag. They look like KXJB7-MN2P4.";
            }
        }
        finally { _busy = false; }
    }

    private async Task Next()
    {
        // Re-check on the way into the radio step so the state is live, not stale from page load.
        if (_step == Step.You) await RefreshRadios();

        if (_step == Step.AetherNet)
        {
            Store.SetFlag(SetupKeys.AetherNet, _aetherNet);
            _ = TellServiceAsync(_aetherNet);
            // With the mesh off there is nothing to switch on — skip the radio-permissions step.
            _step = _aetherNet ? Step.Radios : Step.Gateway;
            return;
        }

        if (_step == Step.Gateway) Store.SetFlag(SetupKeys.GatewayEnabled, _gateway);

        if (_step == Step.AddFirst)
        {
            Store.SetFlag(SetupKeys.Complete, true);
            Nav.NavigateTo("", replace: true);
            return;
        }

        _step = AllSteps[Array.IndexOf(AllSteps, _step) + 1];
    }

    private static string Label(RadioState s) => s switch
    {
        RadioState.Ready => "ready",
        RadioState.Partial => "ready",
        RadioState.NeedsPermission => "needs you",
        RadioState.NeedsSystemToggle => "switched off",
        RadioState.Unsupported => "not on this phone",
        _ => "checking",
    };

    private static string Css(RadioState s) => s switch
    {
        RadioState.Ready or RadioState.Partial => "ok",
        RadioState.Unsupported => "na",
        _ => "todo",
    };
}

<style>
    .wiz { position: fixed; inset: 0; display: flex; flex-direction: column; background: var(--bg); z-index: 60; }
    .wiz-body { flex: 1 1 auto; overflow-y: auto; scrollbar-width: none; padding: max(env(safe-area-inset-top), 28px) 22px 8px; }
    .wiz-body::-webkit-scrollbar { display: none; }
    .wiz-foot { flex: 0 0 auto; padding: 12px 22px calc(env(safe-area-inset-bottom) + 18px); display: flex; flex-direction: column; gap: 14px; }

    .pane { display: flex; flex-direction: column; gap: 14px; padding-top: 12px; max-width: 560px; margin: 0 auto; }
    .pane h1 { font-size: 1.9rem; font-weight: 830; letter-spacing: -0.02em; color: var(--ink); }
    .lede { font-size: 1rem; line-height: 1.55; color: var(--ink-2); }
    .fineprint { font-size: 0.8rem; color: var(--ink-3); text-align: center; }

    .mark { width: 64px; height: 64px; border-radius: 50%; background: conic-gradient(from 210deg, var(--brand), var(--brand-deep), var(--brand)); box-shadow: inset 0 0 0 12px var(--bg), 0 0 0 2px var(--brand); margin: 24px auto 8px; }

    .idcard { display: flex; flex-direction: column; gap: 6px; padding: 20px; border-radius: var(--radius); color: #fff; background: linear-gradient(135deg, var(--brand), var(--brand-deep)); box-shadow: 0 12px 30px rgba(33,150,243,.28); }
    .id-label { font-size: 0.7rem; font-weight: 800; letter-spacing: 1.2px; text-transform: uppercase; opacity: .9; }
    .id-tag { font-family: var(--mono); font-size: 2rem; font-weight: 800; letter-spacing: 2px; }
    .id-note { font-size: 0.78rem; opacity: .9; }

    .radios { display: flex; flex-direction: column; gap: 10px; }
    .radio { background: var(--surface); color: var(--on-surface); --ink: var(--on-surface); --ink-2: var(--on-surface); --ink-3: var(--on-surface); --brand: var(--on-surface); --line: rgba(255,255,255,.35); border: 1px solid var(--line); border-radius: 14px; padding: 14px 16px; display: flex; flex-direction: column; gap: 8px; }
    .radio.ok { border-color: var(--brand); }
    .radio.na { opacity: .55; }
    .r-top { display: flex; align-items: center; justify-content: space-between; gap: 10px; }
    .r-name { font-weight: 700; color: var(--ink); }
    .r-pill { font-size: 0.68rem; font-weight: 800; text-transform: uppercase; letter-spacing: .5px; padding: 4px 10px; border-radius: 999px; background: var(--surface-2); color: var(--on-surface-2); --ink: var(--on-surface-2); --ink-2: var(--on-surface-2); --ink-3: var(--on-surface-2); --brand: var(--on-surface-2); color: var(--ink-3); }
    .radio.ok .r-pill { background: var(--brand-tint); color: var(--brand); }
    .r-detail { font-size: 0.86rem; line-height: 1.45; color: var(--ink-2); }
    .r-btn { align-self: flex-start; appearance: none; border: 1.5px solid var(--brand); background: transparent; color: var(--brand); font-weight: 650; font-size: 0.86rem; padding: 9px 16px; border-radius: 10px; cursor: pointer; }

    .toggle { display: flex; align-items: center; gap: 12px; background: var(--surface); color: var(--on-surface); --ink: var(--on-surface); --ink-2: var(--on-surface); --ink-3: var(--on-surface); --brand: var(--on-surface); --line: rgba(255,255,255,.35); border: 1px solid var(--line); border-radius: 14px; padding: 16px; color: var(--ink); font-weight: 600; }
    /* Drawn here, not left to the phone: on the card the text colour is white in the light theme, and a phone's own box
       given that as its accent drew white on white. Outlined in the card's text colour, filled with it when on, the tick
       in the card's own colour — so it shows on blue and on black alike. */
    .toggle input { appearance: none; -webkit-appearance: none; flex: 0 0 auto; width: 24px; height: 24px; margin: 0; border: 2px solid var(--on-surface); border-radius: 7px; background: transparent; display: grid; place-content: center; cursor: pointer; }
    .toggle input::before { content: ""; width: 6px; height: 12px; margin-top: -2px; border: solid var(--surface); border-width: 0 3px 3px 0; transform: rotate(45deg) scale(0); transition: transform .12s ease; }
    .toggle input:checked { background: var(--on-surface); }
    .toggle input:checked::before { transform: rotate(45deg) scale(1); }
    .toggle input:focus-visible { outline: 3px solid var(--on-surface); outline-offset: 2px; }
    @@media (prefers-reduced-motion: reduce) { .toggle input::before { transition: none; } }

    .tagbox { width: 100%; box-sizing: border-box; border: 1px solid var(--line); background: var(--surface); color: var(--on-surface); --ink: var(--on-surface); --ink-2: var(--on-surface); --ink-3: var(--on-surface); --brand: var(--on-surface); color: var(--ink); border-radius: 12px; padding: 14px 16px; font-family: var(--mono); font-size: 1.05rem; letter-spacing: 1px; text-transform: uppercase; }
    .tagbox:focus { outline: 2px solid var(--brand-tint); border-color: var(--brand); }

    .primary { appearance: none; border: none; background: var(--surface-2); color: var(--on-surface-2); --ink: var(--on-surface-2); --ink-2: var(--on-surface-2); --ink-3: var(--on-surface-2); --brand: var(--on-surface-2); border: 1.5px solid var(--on-surface-2); font-weight: 700; font-size: 1rem; padding: 15px 18px; border-radius: 14px; cursor: pointer; }
    .primary:disabled { opacity: .45; cursor: default; }
    .block { display: block; width: 100%; }

    .warn { color: var(--brand-deep); font-size: 0.86rem; font-weight: 600; }
    .ok { color: var(--brand); font-size: 0.86rem; font-weight: 600; }

    .dots { display: flex; gap: 7px; justify-content: center; }
    .dot { width: 7px; height: 7px; border-radius: 50%; background: var(--line); }
    .dot.on { background: var(--brand); color: #fff; --ink: #fff; --ink-2: #fff; --ink-3: #fff; width: 22px; border-radius: 999px; }
</style>
