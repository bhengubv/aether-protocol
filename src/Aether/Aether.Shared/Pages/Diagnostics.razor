@page "/diag"
@using Aether.Shared.Services
@using Aether.Shared.Services.Lab
@inject IIdentityService Me
@implements IDisposable

@* A developer diagnostics surface for exercising protocol primitives across two real devices. Not a
   shipping feature — it is driven over the devtools bridge to test the two-node primitives with each
   phone's real keystore identity. *@
<div style="padding:16px; font-family:var(--mono, monospace); color:var(--ink); display:flex; flex-direction:column; gap:14px;">
    <div>My tag: <b id="mytag">@Me.AetherTag</b></div>

    <fieldset>
        <legend>Rendezvous (D1) — both phones derive the same point</legend>
        <input id="peerTag" @bind="_peerTag" placeholder="their tag" style="width:100%" />
        <button id="deriveBtn" @onclick="Derive">Derive</button>
        <div>rendezvous: <b id="rv">@_rv</b></div>
        <div>i_start: <b id="istart">@_iStart</b></div>
    </fieldset>

    <fieldset>
        <legend>Ownership (H3) — prove you hold your tag</legend>
        <button id="issueBtn" @onclick="Issue">Issue challenge (verifier)</button>
        <div>challenge: <b id="challengeOut">@_challengeOut</b></div>
        <input id="challengeIn" @bind="_challengeIn" placeholder="challenge json" style="width:100%" />
        <button id="proveBtn" @onclick="Prove">Prove (holder)</button>
        <div>proof: <b id="proofOut">@_proofOut</b></div>
        <input id="proofIn" @bind="_proofIn" placeholder="proof json" style="width:100%" />
        <input id="expectTag" @bind="_expectTag" placeholder="expected tag" style="width:100%" />
        <button id="verifyBtn" @onclick="Verify">Verify (verifier)</button>
        <div>result: <b id="verifyOut">@_verifyOut</b></div>
    </fieldset>
</div>

@code {
    // The diagnostics run in AetherNetService, with this phone's real identity; this page shows them and passes on
    // what the person does.
    private DiagnosticsLabService _lab = null!;

    private string _peerTag { get => _lab.PeerTag; set => _lab.PeerTag = value; }
    private string _rv => _lab.Rv;
    private string _iStart => _lab.IStart;
    private string _challengeOut => _lab.ChallengeOut;
    private string _challengeIn { get => _lab.ChallengeIn; set => _lab.ChallengeIn = value; }
    private string _proofOut => _lab.ProofOut;
    private string _proofIn { get => _lab.ProofIn; set => _lab.ProofIn = value; }
    private string _expectTag { get => _lab.ExpectTag; set => _lab.ExpectTag = value; }
    private string _verifyOut => _lab.VerifyOut;

    protected override void OnInitialized()
    {
        _lab = new DiagnosticsLabService();
        _lab.Changed += OnChanged;
    }

    private void OnChanged() => InvokeAsync(StateHasChanged);

    private void Derive() => _lab.Derive();
    private void Issue() => _lab.Issue();
    private Task Prove() => _lab.Prove();
    private void Verify() => _lab.Verify();

    public void Dispose()
    {
        _lab.Changed -= OnChanged;
        _lab.Dispose();
    }
}
