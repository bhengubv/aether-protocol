<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net9.0;net10.0</TargetFrameworks>
    <RootNamespace>AetherNetNodeService.Ipc</RootNamespace>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <Description>The wire language for binding to the Aether Node Service across a process boundary: the operation codes, the message keys, and the byte encoding of the bind-contract DTOs (tag, link status, inbox, send result). Platform-neutral and self-contained so the marshalling is unit-tested off-device; the Android host and client proxy carry it over an android.os.Messenger.</Description>
    <PackageTags>mesh;aether;node;ipc;bind;wire</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../AetherNetNodeService/AetherNetNodeService.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="AetherNetNodeService.Ipc.Tests" />
  </ItemGroup>

</Project>
