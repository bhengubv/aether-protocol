<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Aether.Space</RootNamespace>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <Description>Geo-pinned community noticeboards (aether-space Phase-2 extension). Nodes drop breadcrumbs at geohash coordinates; passing devices auto-pull and re-host them for other passersby. All propagation is fully offline — no internet required.</Description>
    <PackageTags>mesh;geo;geohash;noticeboard;breadcrumb;space;aether;offline;community</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../Aether.Core/Aether.Core.csproj" />
    <ProjectReference Include="../Aether.Content/Aether.Content.csproj" />
  </ItemGroup>

</Project>
