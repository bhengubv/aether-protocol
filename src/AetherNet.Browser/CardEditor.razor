    /// <summary>The look off another card, and nothing else off it.</summary>
    private static CardDocument Wearing(CardDocument from)
    {
        var mine = new CardDocument();

        foreach (var block in from.Blocks ?? [])
        {
            if (block.Kind is not (CardBlock.Theme or CardBlock.Style)) continue;

            mine.Blocks.Add(new CardBlock
            {
                Kind = block.Kind,
                Value = block.Value,
                Items = block.Items is null ? null : [.. block.Items],
            });
        }

        if (from.Blocks?.FirstOrDefault(b => b.Kind == CardBlock.Css)?.Value is { Length: > 0 } css)
            OwnCard.SetCss(mine, css);

        return mine;
    }

    /// <summary>
    /// A page's address follows its title, rather than being a second thing to fill in.
    /// </summary>
    /// <remarks>
    /// The address was a field beside the title, which is one more blank between somebody and their
    /// page for no gain — nobody wants a path that disagrees with the heading. It is derived once,
    /// while the page is still a draft, and then left alone: once published the address is out in the
    /// world on somebody's screen or written down, and retitling must not move it.
    /// </remarks>
    private void NameIt()
    {
        if (_live || _name.Length > 0 || _doc.Title is not { Length: > 0 } said) return;

        var slug = new StringBuilder();

        foreach (var c in said.ToLowerInvariant())
        {
            if (char.IsAsciiLetterOrDigit(c)) slug.Append(c);
            else if (slug.Length > 0 && slug[^1] != '-') slug.Append('-');
        }

        _name = Mine.Free(slug.ToString().Trim('-') is { Length: > 0 } made ? made : "page");
    }

    /// <summary>Whether the stylesheet is safely down, in the author's words rather than a log.</summary>
    private string _penSaid = "";

    /// <summary>What of their stylesheet will not be carried, said plainly.</summary>
    private string SheetNote
    {
        get
        {
            var written = Sheet;
            if (written.Length == 0) return "";

            var safe = CardCss.Safe(written);
            if (safe.Length == 0 && written.Trim().Length > 0)
                return "The braces do not balance, so none of this will travel yet.";

            return written.Contains("url(", StringComparison.OrdinalIgnoreCase)
                || written.Contains("@import", StringComparison.OrdinalIgnoreCase)
                ? "A stylesheet cannot fetch: url() and @import are removed before this card is handed "
                  + "to anybody. On a network where nobody is watched, one request would say who opened "
                  + "your page and when. Pictures go in as blocks instead."
                : "";
        }
    }

