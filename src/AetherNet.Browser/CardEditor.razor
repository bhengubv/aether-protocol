    private void OnName(ChangeEventArgs e)
    {
        var wanted = MyPages.Clean(e.Value?.ToString());
        if (wanted == _name) return;

        // Renaming is moving: the old name would otherwise stay behind as a second page holding the
        // same words.
        if (_page is not null && !string.IsNullOrEmpty(_page.Name) && wanted.Length > 0)
            Mine.Remove(_page.Name);

        _name = wanted;
        if (_name.Length > 0) Save();
    }


    /// <summary>The only alignment a block may ask for besides its default.</summary>
