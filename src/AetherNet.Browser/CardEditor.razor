@using System.Text
@implements IDisposable
@inject MyPages Mine
@inject MeshWebService Mesh
@inject IJSRuntime JS

@* Four steps, and never more than one decision on screen at a time.
   A page written as one long form is a page most people abandon halfway down, and an abandoned page
   is a node with nothing on it — which is the only failure mode that actually matters here. Steps
   give the work a beginning, a visible middle and an end you can reach. *@
<div class="wiz">
    <header class="top">
        <button class="back" @onclick="Leave" aria-label="Close">✕</button>
        <div class="rail">
            @foreach (var step in Steps)
            {
                <span class="pip @(step < _step ? "done" : step == _step ? "now" : null)"></span>
            }
        </div>
        <span class="count">@(Steps.IndexOf(_step) + 1) of @Steps.Count</span>

        @* Always here, at every step. Somebody wondering how a page is doing what it is doing should
           not have to finish what they are doing to find out. *@
        <button class="under @(_under ? "on" : null)" @onclick="() => _under = !_under"
                title="How this page is made">&lt;/&gt;</button>
    </header>

    @if (_under)
    {
        @* How this page is made.

           MySpace taught a generation HTML and CSS and never once called it a lesson: you saw a page
           you liked, looked at how it was made, copied it, changed the colours, broke it, fixed it.
           Wanting the aesthetic was the whole curriculum. This is that — four layers, and a person can
           stop at any of them, and each one is the real thing rather than a description of it. *@
        var src = CardSource.Of(_doc);

        <section class="under-panel">
            <div class="under-h">
                <h2>How this page is made</h2>
                <button class="tiny" @onclick="() => _under = false">Close</button>
            </div>

            <p class="under-say">
                Nothing here is a description of the page. It <em>is</em> the page — change any of it
                and the page changes, because a card is the data and the design, and nothing else.
            </p>

            <h3 class="under-t">1 · It is a list of pieces</h3>
            <p class="under-b">
                @src.Pieces.Count pieces, in the order a reader meets them. Not a wall of formatting —
                each one knows what kind of thing it is, which is why the same page can be drawn on a
                phone, on the web, and by a program that has never heard of any of this.
            </p>
            <ol class="under-list">
                @foreach (var piece in src.Pieces)
                {
                    <li><span class="under-k">@piece.Kind</span><span class="under-v">@piece.Said</span></li>
                }
            </ol>

            <h3 class="under-t">2 · The look is @src.Tokens.Count values</h3>
            <p class="under-b">
                “@src.LookName” is a name, and a name teaches nothing. This is what it actually is.
                Change one of these and every page wearing this look changes with it — that is what a
                design system is, and you are looking at one.
            </p>
            <dl class="under-tok">
                @foreach (var token in src.Tokens)
                {
                    <div>
                        <dt>@token.Name</dt>
                        <dd class="mono">@token.Value</dd>
                        <dd class="under-s">@token.Says</dd>
                    </div>
                }
            </dl>

            @if (src.Field is { Length: > 0 })
            {
                <h3 class="under-t">3 · The background is a function</h3>
                <p class="under-b">
                    “@src.BackName” is not a picture. It is one function, run once for every pixel on
                    the page: give it a point, it gives back a number, and the number becomes a shade.
                    That is what a shader is, and this is the whole of it.
                </p>
                <pre class="under-code">@src.Field</pre>
            }

            <h3 class="under-t">4 · And you own the whole thing</h3>
            <p class="under-b">
                The entire page is @src.Bytes bytes of text, plus @src.Pictures
                @(src.Pictures == 1 ? "picture" : "pictures"). No server, no account, no build. This is
                the file — it is on this phone, you can hand it to somebody, and nobody can take it
                back.
            </p>
            <pre class="under-code">@src.Json</pre>
        </section>
    }

    else
    {
    <div class="head">
        <h1 class="h">@Title</h1>
        <p class="sub">@Sub</p>
    </div>

    <div class="body">
        @switch (_step)
        {
            case Step.Kind:
                <div class="picks">
                    @foreach (var template in PageTemplate.All)
                    {
                        <button class="pick @(template.Key == _template.Key ? "on" : null)"
                                @onclick="() => ChooseKind(template)">
                            <span class="pick-n">@template.Name</span>
                            <span class="pick-b">@template.Blurb</span>
                        </button>
                    }
                </div>
                break;

            case Step.Look:
                @* Shown, not named. "Studio" is a word; a picture of Studio is a decision somebody can
                   actually make — and it is drawn by the same renderer a reader's phone will use, so
                   what they pick is what arrives. *@
                <div class="looks">
                    @foreach (var look in CardLook.All)
                    {
                        <button class="look @(look.Key == _look.Key ? "on" : null)"
                                @onclick="() => ChooseLook(look)">
                            <span class="shot">
                                <iframe class="mini" tabindex="-1" title="@look.Name"
                                        srcdoc="@Sample(look)"></iframe>
                            </span>
                            <span class="look-t">
                                <span class="look-n">@look.Name</span>
                                <span class="look-b">@look.Blurb</span>
                            </span>
                        </button>
                    }
                </div>

                @*  The editor.

                    Sliders are not coding. A panel of dials is a settings screen, and a settings
                    screen has never taught anybody anything — MySpace taught a generation because the
                    page was theirs to break: you saw one you liked, looked at how it was made, copied
                    it, changed a line, broke it, fixed it.

                    So this is a stylesheet and the page it makes, side by side. You type, and the
                    thing you are typing about redraws. Everything is allowed except the two things
                    that reach off the card — a request, and a selector pointing outside its own page
                    — and both are refused at RENDER as well as here, because a card arriving over the
                    radio never passed through this screen at all.  *@
                <div class="studio">
                    <div class="studio-h">
                        <span class="studio-t">Your stylesheet</span>
                        <span class="studio-b">
                            Your rules come last, so they win. Every selector is kept inside your own
                            card — @CardCss.Root is added for you — and anything that would fetch is
                            refused.
                        </span>
                    </div>

                    @*  A real editing surface, not a text box: the written text is drawn underneath,
                        coloured, and the textarea sits on top of it holding nothing but the caret and
                        the selection. No library — a card renders with no network, so an editor that
                        needs a CDN is an editor that does not work where this app is used.  *@
                    <div class="pen" data-aether-code>
                        <pre class="ink" aria-hidden="true"></pre>
                        <textarea class="raw" spellcheck="false" autocapitalize="off"
                                  autocomplete="off" autocorrect="off" wrap="off"
                                  placeholder="h1 { letter-spacing: -.04em }&#10;p { column-count: 2 }&#10;@@media (max-width: 520px) { h1 { font-size: 28px } }"
                                  @bind="Sheet" @bind:event="oninput"></textarea>
                    </div>

                    @if (SheetNote is { Length: > 0 } note)
                    {
                        <p class="told">@note</p>
                    }

                    <div class="studio-h wide">
                        <span class="studio-t">What it looks like</span>
                        <button class="whole" @onclick="() => _whole = true">See the whole page</button>
                    </div>

                    @*  The real renderer, on the real card, with the stylesheet applied — so what is
                        on screen here is what a stranger's phone will draw, not an approximation of
                        it. *@
                    <iframe class="seen" tabindex="-1" title="Your page"
                            srcdoc="@Seen()"></iframe>
                </div>

                @if (_whole)
                {
                    @*  The page at the size somebody will actually hold it, over everything else.

                        A preview in a 46vh window is a swatch: you cannot judge a measure, a leading
                        or where a page breaks by looking at a third of it. This is the same renderer
                        and the same document, given the whole screen.  *@
                    <div class="whole-page">
                        <div class="whole-bar">
                            <span class="whole-t">@(_doc.Title is { Length: > 0 } t ? t : "Your page")</span>
                            <button class="whole-x" @onclick="() => _whole = false">Back to writing</button>
                        </div>
                        <iframe class="whole-in" title="Your page" srcdoc="@Seen()"></iframe>
                    </div>
                }

                break;

            case Step.Back:
                @* Shown, not named. A grid, because choosing between fourteen is a different act from
                   choosing between five — you scan a catalogue, you do not read it. *@
                <div class="backs">
                    @foreach (var back in CardShader.All)
                    {
                        <button class="back-pick @(back.Key == _shader.Key ? "on" : null)"
                                @onclick="() => ChooseShader(back)">
                            <span class="back-shot">
                                <iframe class="back-mini" tabindex="-1" title="@back.Name"
                                        srcdoc="@Backdrop(back)"></iframe>
                            </span>
                            <span class="back-n">@back.Name</span>
                            <span class="back-b">@back.Blurb</span>
                        </button>
                    }
                </div>
                break;

            case Step.Write:
                <section class="panel open">
                    <div class="phead">
                        <span class="plabel">The basics</span>
                    </div>
                    <div class="pbody">
                        <label class="field">
                            <span class="flabel">Title</span>
                            <input class="in" maxlength="60" placeholder="@TitleHint"
                                   value="@_doc.Title" @oninput="OnTitle" />
                            @if (string.IsNullOrWhiteSpace(_doc.Title))
                            {
                                <p class="hint">A page needs this — it is the first thing anybody reads.</p>
                            }
                        </label>

                        <label class="field">
                            <span class="flabel">Address</span>
                            @if (_live)
                            {
                                <div class="addr fixed">
                                    <span class="tag">@Mesh.LocalTag/</span><span class="nm">@_name</span>
                                </div>
                                <p class="hint">Published — the address stays put now, so anyone who wrote it down still finds you.</p>
                            }
                            else
                            {
                                <div class="addr">
                                    <span class="tag">@Mesh.LocalTag/</span>
                                    <input class="in bare" maxlength="@MyPages.LongestName" placeholder="me"
                                           value="@_name" @oninput="OnName" />
                                </div>
                                <p class="hint">Lowercase, no spaces. This is what someone types to reach the page.</p>
                            }
                        </label>
                    </div>
                </section>

                @* One panel open at a time. Every field visible at once is what turned this into a
                   scroll; a page is a handful of small decisions, so it is shown as a handful of
                   small decisions. *@
                @for (var i = 0; i < _doc.Blocks.Count; i++)
                {
                    var index = i;
                    var block = _doc.Blocks[index];
                    if (!OwnCard.IsEditable(block)) { continue; }

                    <section class="panel @(_open == index ? "open" : null)" @key="block">
                        <button class="phead" @onclick="() => Toggle(index)">
                            <span class="ptext">
                                <span class="plabel">@OwnCard.Label(block.Kind)</span>
                                <span class="psay">@Summary(block)</span>
                            </span>
                            <span class="chev">@(_open == index ? "▾" : "▸")</span>
                        </button>

                        @if (_open == index)
                        {
                            <div class="pbody">
                                @switch (block.Kind)
                                {
                                    case CardBlock.Index:
                                    case CardBlock.List:
                                        @for (var j = 0; j < (block.Items?.Count ?? 0); j++)
                                        {
                                            var item = j;
                                            <input class="in" maxlength="@OwnCard.Longest(block.Kind)"
                                                   placeholder="@OwnCard.Placeholder(block.Kind)"
                                                   value="@block.Items![item]" @oninput="e => OnItem(index, item, e)" />
                                        }
                                        <button class="ghost" @onclick="() => AddItem(index)">Add a line</button>
                                        @if (block.Kind == CardBlock.Index)
                                        {
                                            <p class="hint">Put an = between the name and where it belongs. They come out numbered.</p>
                                        }
                                        break;

                                    case CardBlock.Title:
                                        <input class="in" maxlength="@OwnCard.LongestTitle"
                                               placeholder="@OwnCard.Placeholder(block.Kind)"
                                               value="@block.Value" @oninput="e => OnName(index, e)" />
                                        <div class="asrow">
                                            <button class="tiny @(block.IsSmall ? null : "on")"
                                                    @onclick="() => OnAs(index, null)">A headline</button>
                                            <button class="tiny @(block.IsSmall ? "on" : null)"
                                                    @onclick="() => OnAs(index, Small)">A wordmark</button>
                                        </div>
                                        <p class="hint">Move it with the arrows — a page can open with a picture and put its name underneath.</p>
                                        break;

                                    case CardBlock.Rule:
                                        <div class="orns">
                                            @foreach (var orn in CardOrnament.All)
                                            {
                                                <button class="orn-pick @(CardOrnament.Of(block.Value).Key == orn.Key ? "on" : null)"
                                                        @onclick="() => OnValueSet(index, orn.Key)">
                                                    <span class="orn-draw">@((MarkupString)orn.Svg())</span>
                                                    <span class="orn-n">@orn.Name</span>
                                                </button>
                                            }
                                        </div>
                                        break;

                                    case CardBlock.Text:
                                    case CardBlock.Quote:
                                        @* Formatting you can see while you write it. The card still
                                           stores plain words — see CardMarks — so this is a view of
                                           the writing rather than a second way of storing it. *@
                                        <div class="in area rtf" contenteditable="true" role="textbox"
                                             aria-multiline="true" aria-label="@OwnCard.Label(block.Kind)"
                                             data-w="@index" data-text="@block.Value"></div>

                                        @* Under the words, not over them. Android puts its own
                                           Cut / Copy bar above whatever you have selected, and above
                                           the field is exactly where that lands — on the phone it
                                           covered Underline and Link completely, and the only way to
                                           find that out was to select a word with a finger. *@
                                        <div class="rtbar">
                                            <button class="rtb" title="Bold" @onmousedown:preventDefault
                                                    @onclick="() => Mark(index, Bold)"><b>B</b></button>
                                            <button class="rtb" title="Italic" @onmousedown:preventDefault
                                                    @onclick="() => Mark(index, Italic)"><i>I</i></button>
                                            <button class="rtb" title="Underline" @onmousedown:preventDefault
                                                    @onclick="() => Mark(index, Under)"><u>U</u></button>
                                            <button class="rtb wide @(_linking == index ? "on" : null)"
                                                    title="Link" @onmousedown:preventDefault
                                                    @onclick="() => Linking(index)">Link</button>
                                        </div>

                                        @if (_linking == index)
                                        {
                                            <div class="linkto">
                                                <input class="in" maxlength="@CardBlock.LongestTip"
                                                       placeholder="https://… or one of your pages"
                                                       value="@_linkTo" @oninput="OnLinkTo" />

                                                @if (Mine.All.Any(p => p.Name != _name))
                                                {
                                                    <select class="in" @onchange="OnLinkPick">
                                                        <option value="">One of your pages…</option>
                                                        @foreach (var other in Mine.All.Where(p => p.Name != _name))
                                                        {
                                                            <option value="@Mesh.Address(other.Name)">@other.Name</option>
                                                        }
                                                    </select>
                                                }

                                                <div class="prow">
                                                    <button class="tiny" @onmousedown:preventDefault
                                                            @onclick="() => Link(index)">Add link</button>
                                                    <button class="tiny" @onmousedown:preventDefault
                                                            @onclick="() => Mark(index, AsLink)">Remove link</button>
                                                </div>
                                                <p class="hint">Select the words first, then add the link.</p>
                                            </div>
                                        }
                                        break;

                                    case CardBlock.KeyValue:
                                        <input class="in" maxlength="@OwnCard.Longest(block.Kind)"
                                               placeholder="@OwnCard.Placeholder(block.Kind)"
                                               value="@block.Value" @oninput="e => OnValue(index, e)" />
                                        <p class="hint">Put an = between the label and what it says.</p>
                                        break;

                                    case CardBlock.Link:
                                        <input class="in" maxlength="@OwnCard.Longest(block.Kind)"
                                               placeholder="@OwnCard.Placeholder(block.Kind)"
                                               value="@block.Value" @oninput="e => OnValue(index, e)" />
                                        <select class="in" @onchange="e => OnTarget(index, e)">
                                            <option value="">Which of your pages?</option>
                                            @foreach (var other in Mine.All.Where(p => p.Name != _name))
                                            {
                                                <option value="@Mesh.Address(other.Name)"
                                                        selected="@(block.Target == Mesh.Address(other.Name))">
                                                    @other.Name
                                                </option>
                                            }
                                        </select>
                                        @if (Mine.All.Count(p => p.Name != _name) == 0)
                                        {
                                            <p class="hint">You have no other pages yet. Make one and this can point at it.</p>
                                        }
                                        break;

                                    @* A real file input rather than one summoned from script: a
                                       chooser opens only from a genuine tap, and a click synthesised
                                       after an await has lost the gesture that would allow it — the
                                       chooser then silently never appears. *@
                                    case CardBlock.Image:
                                        <div class="pic">
                                            @if (Shown(block) is { Length: > 0 } shown)
                                            {
                                                <img class="pic-art" src="@shown" alt="@block.Value" />
                                            }
                                            else
                                            {
                                                <div class="pic-none">No picture yet</div>
                                            }

                                            <label class="pick @(_busyPic ? "waiting" : null)">
                                                @(_busyPic ? "Working…" : Shown(block) is null ? "Choose a picture" : "Choose another")
                                                <input type="file" accept="image/*" class="hidden"
                                                       @ref="_picker" />
                                            </label>
                                        </div>

                                        <input class="in" maxlength="@OwnCard.Longest(block.Kind)"
                                               placeholder="@OwnCard.Placeholder(block.Kind)"
                                               value="@block.Value" @oninput="e => OnValue(index, e)" />

                                        <div class="asrow">
                                            <button class="tiny @(block.As is null ? "on" : null)"
                                                    @onclick="() => OnAs(index, null)">In the page</button>
                                            <button class="tiny @(block.IsWide ? "on" : null)"
                                                    @onclick="() => OnAs(index, Wide)">Whole, edge to edge</button>
                                            <button class="tiny @(block.IsWash ? "on" : null)"
                                                    @onclick="() => OnAs(index, Wash)">Behind everything</button>
                                        </div>

                                        @if (_picNote is { Length: > 0 } && _picking == index)
                                        {
                                            <p class="hint bad">@_picNote</p>
                                        }
                                        else if (_weights.TryGetValue(block.ContentHash ?? "", out var weight))
                                        {
                                            <p class="hint">@PagePhoto.Size(weight) · @PagePhoto.OverSlowLink(weight)</p>
                                        }
                                        else
                                        {
                                            <p class="hint">Shrunk on this phone before it goes anywhere. Nothing of the original file travels — no location, no camera, no date.</p>
                                        }
                                        break;

                                    case CardBlock.Tip:
                                        <input class="in" maxlength="@OwnCard.Longest(block.Kind)"
                                               placeholder="@OwnCard.Placeholder(block.Kind)"
                                               value="@block.Value" @oninput="e => OnValue(index, e)" />
                                        <input class="in" maxlength="200" inputmode="url" spellcheck="false"
                                               placeholder="https://buymeacoffee.com/you"
                                               value="@block.Target" @oninput="e => OnTarget(index, e)" />
                                        @if (CardBlock.IsUsableTip(block.Target))
                                        {
                                            <p class="hint good">Money goes to @CardBlock.TipHost(block.Target).</p>
                                        }
                                        else if (!string.IsNullOrWhiteSpace(block.Target))
                                        {
                                            <p class="hint bad">Has to be an https address. This one is not one we'll show.</p>
                                        }
                                        else
                                        {
                                            <p class="hint">Buy Me a Coffee, Ko-fi, your own page — whoever you already use.</p>
                                        }
                                        break;

                                    default:
                                        <input class="in" maxlength="@OwnCard.Longest(block.Kind)"
                                               placeholder="@OwnCard.Placeholder(block.Kind)"
                                               value="@block.Value" @oninput="e => OnValue(index, e)" />
                                        break;
                                }

                                @if (block.Kind is CardBlock.Eyebrow or CardBlock.Heading
                                        or CardBlock.Text or CardBlock.Quote)
                                {
                                    <div class="alignrow">
                                        <button class="tiny @(block.IsCentred ? null : "on")"
                                                @onclick="() => OnAlign(index, null)">Left</button>
                                        <button class="tiny @(block.IsCentred ? "on" : null)"
                                                @onclick="() => OnAlign(index, Centre)">Centred</button>
                                    </div>
                                }

                                <div class="prow">
                                    <button class="tiny" @onclick="() => Move(index, -1)" aria-label="Move up">↑</button>
                                    <button class="tiny" @onclick="() => Move(index, 1)" aria-label="Move down">↓</button>
                                    <button class="tiny drop" @onclick="() => Drop(index)" aria-label="Remove">Remove</button>
                                </div>
                            </div>
                        }
                    </section>
                }

                @* Taking a page down is the other half of putting one up. Without it the only way out
                   of a page somebody regrets is to leave it standing under their own tag. *@
                @if (_page is not null)
                {
                    <section class="adds">
                        <span class="plabel">This page</span>
                        <button class="ghost drop" @onclick="Down">Take it down</button>
                        <p class="hint">
                            Removes it from this phone, so nobody can reach it here any more. A copy on
                            somebody else's phone is theirs — it stays.
                        </p>
                    </section>
                }

                <section class="adds">
                    <span class="plabel">Add</span>
                    <div class="addrow">
                        @foreach (var kind in OwnCard.Writable)
                        {
                            <button class="ghost" disabled="@Full" @onclick="() => Add(kind)">@OwnCard.Label(kind)</button>
                        }
                    </div>
                    @if (Full)
                    {
                        <p class="hint">That is as long as a page gets. It stays something a person reads.</p>
                    }
                </section>
                break;

            case Step.Publish:
                <div class="done">
                    <div class="shot big">
                        <iframe class="full" title="Your page" srcdoc="@_preview"></iframe>
                    </div>

                    <div class="where">
                        <span class="wlabel">It will answer at</span>
                        <span class="waddr">aether://@Mesh.LocalTag/@_name</span>
                    </div>

                    @if (_said is { Length: > 0 })
                    {
                        <p class="said">@_said</p>
                    }
                </div>
                break;
        }
    </div>
    }

    <footer class="foot @(_under ? "away" : null)">
        @if (Steps.IndexOf(_step) > 0)
        {
            <button class="ghost wide" @onclick="Back">Back</button>
        }

        @if (_step == Step.Publish)
        {
            <button class="go" disabled="@(_busy || !CanPublish)" @onclick="Publish">
                @(_busy ? "Publishing…" : _live ? "Publish changes" : "Publish")
            </button>
        }
        else
        {
            <button class="go" disabled="@(!CanGo)" @onclick="Next">Next</button>
        }
    </footer>
</div>

@code {
    /// <summary>The page to edit, or null / "new" to make one.</summary>
    [Parameter] public string? Name { get; set; }

    /// <summary>
    /// Raised when the person is finished — published, cancelled, or took the page down.
    /// </summary>
    /// <remarks>
    /// A callback rather than a navigation. The editor has no idea what is hosting it: one tab of a
    /// sample app today, a system browser later, somebody else's app after that. Deciding where to go
    /// next is the host's, and an editor that navigated would have to be told about routes it should
    /// never have heard of.
    /// </remarks>
    [Parameter] public EventCallback Done { get; set; }

    private enum Step { Kind, Look, Back, Write, Publish }

    private List<Step> Steps = [];
    private Step _step = Step.Look;

    private WebCard? _page;
    private CardDocument _doc = new();
    private PageTemplate _template = PageTemplate.All[0];
    private CardLook _look = CardLook.Of(null);
    private CardShader _shader = CardShader.Of(null);
    private string _name = "";
    private bool _live;

    private int _open = -1;
    private string _preview = "";
    private string _said = "";
    private bool _busy;

    private ElementReference? _picker;
    private DotNetObjectReference<CardEditor>? _me;
    private int _picking = -1;
    private bool _busyPic;
    private string _picNote = "";

    /// <summary>Pictures already resolved, by content hash, so a panel draws without waiting.</summary>
    private readonly Dictionary<string, string> _pics = new(StringComparer.Ordinal);

    /// <summary>And what each weighs, so the author sees the cost they are asking others to pay.</summary>
    private readonly Dictionary<string, long> _weights = new(StringComparer.Ordinal);

    private bool Fresh => string.IsNullOrWhiteSpace(Name) || Name == "new";

    private string? Shown(CardBlock block) =>
        block.ContentHash is { Length: > 0 } hash && _pics.TryGetValue(hash, out var uri) ? uri : null;
    private bool Full => _doc.Blocks.Count >= OwnCard.MostBlocks;

    private string Title => _step switch
    {
        Step.Kind => "What is this page?",
        Step.Look => "Pick a look",
        Step.Back => "Pick a background",
        Step.Write => "Write it",
        _ => "Ready",
    };

    private string Sub => _step switch
    {
        Step.Kind => "It starts you off with the right shape. You can change anything after.",
        Step.Look => "Every one of these is finished. You are choosing a design, not making one.",
        Step.Back => "All of them take your colour. Pick the one that feels like the page.",
        Step.Write => "Fill in what you want. Anything you leave blank simply does not appear.",
        _ => "This is your page as somebody else's phone will draw it.",
    };

    private string TitleHint => _template.Key switch
    {
        "business" => "Urban Plumbers",
        "notice" => "Water off Thursday",
        _ => "Your name",
    };

    // A page needs a name a reader sees and an address a reader types. Everything else on it is
    // optional — somebody with a title and nothing else has a short page, not a broken one.
    private bool CanGo => _step switch
    {
        Step.Write => Named,
        _ => true,
    };

    private bool CanPublish => Named;

    private bool Named => _name.Length > 0 && !string.IsNullOrWhiteSpace(_doc.Title);

    protected override void OnInitialized()
    {
        if (Fresh)
        {
            Steps = [Step.Kind, Step.Look, Step.Back, Step.Write, Step.Publish];
            _step = Step.Kind;
            _template = PageTemplate.All[0];
            _doc = _template.Build(Mine.OwnerName);
            _name = Mine.Free(_template.Suggests);
        }
        else
        {
            Steps = [Step.Look, Step.Back, Step.Write, Step.Publish];
            _step = Step.Look;
            _page = Mine.Get(Name);

            if (_page is null)
            {
                _ = Done.InvokeAsync();
                return;
            }

            _doc = _page.Doc;
            _name = _page.Name;
            _live = _page.Live;
        }

        _look = CardLook.FromCard(_doc);
        _shader = CardShader.FromCard(_doc);
        Draw();

        // Whatever this page already names. Fetched rather than remembered, because the bytes live in
        // the content store and the card only ever carries the hash.
        _ = Load();
    }

    private async Task Load()
    {
        foreach (var hash in _doc.Blocks
            .Where(b => b.Kind == CardBlock.Image && CardBlock.IsUsableAssetHash(b.ContentHash))
            .Select(b => b.ContentHash!)
            .Distinct(StringComparer.Ordinal)
            .ToArray())
        {
            if (_pics.ContainsKey(hash)) continue;
            if (await Mesh.AssetAsync(hash) is not { Length: > 0 } uri) continue;

            _pics[hash] = uri;
            Draw();
            StateHasChanged();
        }
    }

    /// <summary>
    /// Hand the newly-rendered file input to the picker script.
    /// </summary>
    /// <remarks>
    /// After the render, because the element does not exist before it. The script refuses to attach
    /// twice to the same input, so calling this on every render costs nothing.
    /// </remarks>
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        _me ??= DotNetObjectReference.Create(this);

        try
        {
            // Cheap when there is nothing new: a field that is already wired is skipped, and its
            // contents are never redrawn underneath somebody's caret.
            await JS.InvokeVoidAsync("aetherWrite.wire", _me, nameof(Wrote));
        }
        catch (Exception)
        {
            // No writing surface on this head. Prose is still typed and still saved.
        }

        if (_picker is not { } input) return;

        try
        {
            await JS.InvokeVoidAsync("aetherPhoto.watch", input, _me, nameof(Picked));
        }
        catch (Exception)
        {
            // No picker on this head. The panel still shows whatever picture is already there.
        }
    }

    /// <summary>
    /// A picture came back from the browser, already redrawn and shrunk.
    /// </summary>
    /// <remarks>
    /// Everything here is a claim until it is checked. The size, the type and the bytes all crossed a
    /// JavaScript boundary, so <see cref="PagePhoto"/> looks at the bytes themselves rather than at
    /// what they say they are — and the content store hashes them, which is what a card names.
    /// </remarks>
    [JSInvokable]
    public async Task Picked(PickedPicture got)
    {
        _picNote = "";

        if (got is null || !got.Ok || string.IsNullOrEmpty(got.Base64))
        {
            _picNote = got?.Why is { Length: > 0 } why
                ? why + " — try a smaller one"
                : "could not use that picture";
            StateHasChanged();
            return;
        }

        _busyPic = true;
        StateHasChanged();

        try
        {
            var bytes = Convert.FromBase64String(got.Base64);

            if (!PagePhoto.IsUsable(got.Mime, bytes))
            {
                _picNote = $"that came to {PagePhoto.Size(bytes.Length)}, and a page carries {PagePhoto.Size(PagePhoto.MostBytes)}";
                return;
            }

            if (await Mesh.KeepPictureAsync(bytes, got.Mime!) is not { Length: > 0 } hash)
            {
                _picNote = "could not keep that picture";
                return;
            }

            _pics[hash] = $"data:{got.Mime};base64,{got.Base64}";
            _weights[hash] = bytes.LongLength;

            if (_picking >= 0 && _picking < _doc.Blocks.Count)
            {
                _doc.Blocks[_picking].ContentHash = hash;
                Save();
            }
        }
        catch (FormatException)
        {
            _picNote = "could not read that picture";
        }
        finally
        {
            _busyPic = false;
            StateHasChanged();
        }
    }

    /// <summary>What the picker hands back.</summary>
    public sealed class PickedPicture
    {
        public bool Ok { get; set; }
        public string? Why { get; set; }
        public string? Mime { get; set; }
        public string? Base64 { get; set; }
        public long Bytes { get; set; }
        public int Width { get; set; }
        public int Height { get; set; }
    }

    public void Dispose() => _me?.Dispose();

    // ─── Steps ──────────────────────────────────────────────────────────────────

    private void Next()
    {
        var at = Steps.IndexOf(_step);
        if (at < 0 || at + 1 >= Steps.Count) return;

        _step = Steps[at + 1];
        if (_step == Step.Publish) Draw();
    }

    private void Back()
    {
        var at = Steps.IndexOf(_step);
        if (at > 0) _step = Steps[at - 1];
    }

    private Task Leave() => Done.InvokeAsync();

    /// <summary>Take this page off the device.</summary>
    private async Task Down()
    {
        Mine.Remove(_name);
        await Done.InvokeAsync();
    }

    private void ChooseKind(PageTemplate template)
    {
        _template = template;
        _doc = template.Build(Mine.OwnerName);
        _look = CardLook.FromCard(_doc);
        _shader = CardShader.FromCard(_doc);
        _name = Mine.Free(template.Suggests);
        _open = -1;
        Draw();
    }

    /// <summary>Whether the page is being looked at whole rather than beside the editor.</summary>
    private bool _whole;

    /// <summary>
    /// The card as a reader's phone will draw it, stylesheet and all.
    /// </summary>
    /// <remarks>
    /// The real renderer on the real document, not a mock-up of one — so a rule that will not travel
    /// does not appear to work here and then vanish on somebody else's phone. It is the same call
    /// <see cref="Draw"/> makes; this one just goes straight into the frame beside the editor.
    /// </remarks>
    private string Seen() =>
        CardPage.Render(
            OwnCard.ForPublish(_doc), _doc.Title, 0,
            downloadPath: null, assetPath: Picture, fontBase: PageAssets.WebFontBase);

    /// <summary>The author's own stylesheet, as they typed it.</summary>
    /// <remarks>
    /// Kept as written, not as sanitised. Somebody who typed a url() and had it silently deleted out
    /// from under their cursor has been told nothing and cannot learn anything; they see their own
    /// text, and a line underneath saying what will not travel and why.
    /// </remarks>
    private string Sheet
    {
        get => _doc?.Blocks?.FirstOrDefault(b => b.Kind == CardBlock.Css)?.Value ?? "";
        set
        {
            OwnCard.SetCss(_doc, value);
            if (!Fresh || _page is not null) Save(); else Draw();
        }
    }

    /// <summary>What of their stylesheet will not be carried, said plainly.</summary>
    private string SheetNote
    {
        get
        {
            var written = Sheet;
            if (written.Length == 0) return "";

            var safe = CardCss.Safe(written);
            if (safe.Length == 0 && written.Trim().Length > 0)
                return "The braces do not balance, so none of this will travel yet.";

            return written.Contains("url(", StringComparison.OrdinalIgnoreCase)
                || written.Contains("@import", StringComparison.OrdinalIgnoreCase)
                ? "A stylesheet cannot fetch: url() and @import are removed before this card is handed "
                  + "to anybody. On a network where nobody is watched, one request would say who opened "
                  + "your page and when. Pictures go in as blocks instead."
                : "";
        }
    }

    private void ChooseLook(CardLook look)
    {
        OwnCard.SetLook(_doc, look.Key);
        _look = CardLook.FromCard(_doc);
        if (!Fresh || _page is not null) Save(); else Draw();
    }

    private void ChooseShader(CardShader shader)
    {
        OwnCard.SetShader(_doc, shader.Key);
        _shader = shader;
        if (!Fresh || _page is not null) Save(); else Draw();
    }

    /// <summary>
    /// This background on this page, drawn small.
    /// </summary>
    /// <remarks>
    /// The real renderer with the real catalogue entry — their look, their colour, their title. A
    /// swatch would be quicker and would answer a different question: what somebody wants to know is
    /// what their own page looks like wearing this, not what the background looks like on its own.
    /// </remarks>
    private string Backdrop(CardShader shader)
    {
        var shown = new CardDocument
        {
            Title = _doc.Title.Length > 0 ? _doc.Title : (Mine.OwnerName ?? "Your page"),
            Blocks = [CardBlock.Of(CardBlock.Theme, _look.Key), CardBlock.Of(CardBlock.Theme, shader.Key)],
        };

        return CardPage.Render(
            shown, shown.Title, 0, downloadPath: null,
            fontBase: PageAssets.WebFontBase, still: true, sample: true);
    }

    /// <summary>
    /// Open one panel, close the rest — and remember which one a picture would belong to.
    /// </summary>
    /// <remarks>
    /// The open panel is the only one whose file input is rendered, so opening a panel is what makes
    /// it the destination. Deciding this from a click handler on the input instead re-rendered the
    /// page mid-tap, replaced the element, and cancelled the gesture that was about to open the
    /// chooser — a button that visibly did nothing.
    /// </remarks>
    private void Toggle(int index)
    {
        _open = _open == index ? -1 : index;
        _picking = _open;
        _picNote = "";
    }

    // ─── Fields ─────────────────────────────────────────────────────────────────

    private void OnTitle(ChangeEventArgs e)
    {
        OwnCard.SetTitle(_doc, e.Value?.ToString());
        Save();
    }

    private void OnName(ChangeEventArgs e)
    {
        var wanted = MyPages.Clean(e.Value?.ToString());
        if (wanted == _name) return;

        // Renaming is moving: the old name would otherwise stay behind as a second page holding the
        // same words.
        if (_page is not null && !string.IsNullOrEmpty(_page.Name) && wanted.Length > 0)
            Mine.Remove(_page.Name);

        _name = wanted;
        if (_name.Length > 0) Save();
    }

    /// <summary>Set a block's value directly, from a picker rather than a field.</summary>
    private void OnValueSet(int index, string value)
    {
        if (index < 0 || index >= _doc.Blocks.Count) return;
        _doc.Blocks[index].Value = value;
        Save();
    }

    /// <summary>The only alignment a block may ask for besides its default.</summary>
    private const string Centre = "centre";

    /// <summary>Left or centred. Two values, because a third is a design nobody asked for.</summary>
    private void OnAlign(int index, string? how)
    {
        if (index < 0 || index >= _doc.Blocks.Count) return;
        _doc.Blocks[index].Align = how;
        Save();
    }

    /// <summary>A name set as a wordmark rather than a headline.</summary>
    private const string Small = "small";

    /// <summary>A picture shown whole rather than cropped into the masthead.</summary>
    private const string Wide = "wide";

    /// <summary>A picture used as the page's ground rather than placed on it.</summary>
    private const string Wash = "wash";

    /// <summary>
    /// How a picture sits: in the flow, whole across the page, or behind everything.
    /// </summary>
    /// <remarks>
    /// Three named places rather than a set of switches. Somebody choosing between three finished
    /// answers gets one of three good pages; the same person given size, position and repeat gets a
    /// hundred bad ones.
    /// </remarks>
    private void OnAs(int index, string? how)
    {
        if (index < 0 || index >= _doc.Blocks.Count) return;
        _doc.Blocks[index].As = how;
        Save();
    }

    /// <summary>
    /// The name, typed in the block rather than in the basics.
    /// </summary>
    /// <remarks>
    /// Both places set the same thing. The page's name is metadata — a deck, an address bar and a
    /// file name all use it — and the block is what a reader sees, so they may never disagree.
    /// </remarks>
    private void OnName(int index, ChangeEventArgs e)
    {
        if (index < 0 || index >= _doc.Blocks.Count) return;

        var said = e.Value?.ToString();
        _doc.Blocks[index].Value = said;
        _doc.Title = said ?? "";
        Save();
    }

    /// <summary>Whether the page is opened up to show how it is made.</summary>
    private bool _under;

    /// <summary>The four things the toolbar does, named because a lambda cannot hold a literal.</summary>
    private const string Bold = "bold";

    private const string Italic = "italic";

    private const string Under = "underline";

    private const string AsLink = "link";

    /// <summary>Which block, if any, is having a link put on it.</summary>
    private int? _linking;

    /// <summary>Where that link is going, as typed or as picked.</summary>
    private string _linkTo = "";

    private void Linking(int index)
    {
        _linking = _linking == index ? null : index;
        _linkTo = "";
    }

    private void OnLinkTo(ChangeEventArgs e) => _linkTo = e.Value?.ToString() ?? "";

    private void OnLinkPick(ChangeEventArgs e)
    {
        if (e.Value?.ToString() is { Length: > 0 } picked) _linkTo = picked;
    }

    /// <summary>
    /// Bold, italic or underline on whatever the writer has selected.
    /// </summary>
    /// <remarks>
    /// The work happens in the field, and the words come back through <see cref="Wrote"/> like any
    /// other keystroke — so there is one path into the document rather than two, and a mark applied
    /// by a button is indistinguishable from a mark somebody typed.
    /// </remarks>
    private async Task Mark(int index, string how)
    {
        try
        {
            await JS.InvokeAsync<bool>("aetherWrite.mark", index.ToString(), how, null);
        }
        catch (Exception)
        {
            // No writing surface on this head. The field is still a field and the words still save.
        }
    }

    /// <summary>
    /// Put a link on the selected words.
    /// </summary>
    /// <remarks>
    /// Checked here as well as when the page is drawn. The renderer refuses anything that is not a
    /// mesh address or an https one — but a person who pastes something else deserves to find that
    /// out while they are writing, not by looking at the page afterwards and wondering.
    /// </remarks>
    private async Task Link(int index)
    {
        var to = _linkTo.Trim();
        if (to.Length == 0) return;

        if (!CardBlock.IsMeshAddress(to) && !CardBlock.IsUsableWeb(to))
        {
            _linkTo = to.StartsWith("http://", StringComparison.OrdinalIgnoreCase)
                ? "https://" + to["http://".Length..]
                : to.Contains('.') && !to.Contains(' ') ? "https://" + to : to;

            if (!CardBlock.IsUsableWeb(_linkTo)) return;
            to = _linkTo;
        }

        try
        {
            await JS.InvokeAsync<bool>("aetherWrite.mark", index.ToString(), AsLink, to);
            _linking = null;
            _linkTo = "";
        }
        catch (Exception)
        {
            // Same as above: without the surface there is nothing to attach a link to.
        }
    }

    /// <summary>
    /// The writer typed, and this is what the card now says.
    /// </summary>
    /// <remarks>
    /// Plain words, always. What crossed the bridge is text — the field's formatting was turned back
    /// into the card's own marks on the other side — so nothing here has to trust or clean markup,
    /// which is the property that makes a rich field safe to have at all.
    /// </remarks>
    [JSInvokable]
    public void Wrote(string which, string said)
    {
        if (!int.TryParse(which, out var index)) return;
        if (index < 0 || index >= _doc.Blocks.Count) return;

        var most = OwnCard.Longest(_doc.Blocks[index].Kind);
        _doc.Blocks[index].Value = said.Length > most ? said[..most] : said;

        Save();
        StateHasChanged();
    }

    private void OnValue(int index, ChangeEventArgs e)
    {
        if (index < 0 || index >= _doc.Blocks.Count) return;
        _doc.Blocks[index].Value = e.Value?.ToString();
        Save();
    }

    private void OnTarget(int index, ChangeEventArgs e)
    {
        if (index < 0 || index >= _doc.Blocks.Count) return;
        _doc.Blocks[index].Target = e.Value?.ToString();
        Save();
    }

    private void OnItem(int index, int item, ChangeEventArgs e)
    {
        if (index < 0 || index >= _doc.Blocks.Count) return;
        if (_doc.Blocks[index].Items is not { } items) return;
        if (item < 0 || item >= items.Count) return;

        items[item] = e.Value?.ToString() ?? "";
        Save();
    }

    private void AddItem(int index)
    {
        if (index < 0 || index >= _doc.Blocks.Count) return;
        (_doc.Blocks[index].Items ??= []).Add("");
        Save();
    }

    private void Add(string kind)
    {
        if (kind == CardBlock.Image && _doc.Blocks.Count(b => b.Kind == CardBlock.Image) >= PagePhoto.MostPerPage)
        {
            _said = $"That is {PagePhoto.MostPerPage} pictures — as many as a page carries. Every one is another wait for whoever opens it on the slow radio.";
            return;
        }

        OwnCard.Add(_doc, kind);
        _open = _doc.Blocks.Count - 1;
        _picking = _open;
        Save();
    }

    private void Move(int index, int by)
    {
        OwnCard.Move(_doc, index, by);
        if (_open == index) _open = Math.Clamp(index + by, 0, _doc.Blocks.Count - 1);
        Save();
    }

    private void Drop(int index)
    {
        OwnCard.Remove(_doc, index);
        _open = -1;
        Save();
    }

    // ─── Keeping it ─────────────────────────────────────────────────────────────

    /// <summary>
    /// Written on every keystroke, deliberately.
    /// </summary>
    /// <remarks>
    /// There is no save button and nothing to lose. A page is a few hundred bytes of JSON into this
    /// device's own database; writing it constantly costs nothing, and somebody closing the screen
    /// having forgotten to press something costs them the page. Saving is not publishing — this only
    /// moves the draft, and the copy other people can read is untouched until they say so.
    /// </remarks>
    private void Save()
    {
        if (_name.Length == 0) return;

        // A page comes into existence when it is given a name a reader would see — not when somebody
        // taps through a look. Tapping through used to leave a nameless draft behind on every pass,
        // and drafts of nothing are what a person's list of pages fills up with.
        if (_page is null && string.IsNullOrWhiteSpace(_doc.Title)) { Draw(); return; }

        _page ??= new WebCard();
        _page.Name = _name;
        _page.Doc = _doc;

        Mine.Save(_page);
        _page = Mine.Get(_name) ?? _page;
        _doc = _page.Doc;
        _live = _page.Live;
        Draw();
    }

    /// <summary>
    /// The preview is the renderer a stranger's phone uses, and the document it will actually receive.
    /// </summary>
    /// <remarks>
    /// Drawn from the published form, not from the draft. A template arrives as a shape with its
    /// values blank, and showing those blanks here would tell the author their page has empty boxes on
    /// it — which is the opposite of what a reader sees, and would send them off filling in fields
    /// nobody was ever going to read.
    /// </remarks>
    private void Draw() =>
        _preview = CardPage.Render(
            OwnCard.ForPublish(_doc), _doc.Title, 0,
            downloadPath: null, assetPath: Picture, fontBase: PageAssets.WebFontBase);

    /// <summary>A picture this editor already holds, as something the preview can draw.</summary>
    private string? Picture(string hash) => _pics.GetValueOrDefault(hash);

    /// <summary>
    /// The same page in a different look, drawn small.
    /// </summary>
    /// <remarks>
    /// Their own title and their own words where they have written any, because a look is a decision
    /// about <i>their</i> page — a thumbnail of somebody else's content answers a different question.
    /// </remarks>
    private string Sample(CardLook look)
    {
        var shown = new CardDocument
        {
            Title = _doc.Title.Length > 0 ? _doc.Title : (Mine.OwnerName ?? "Your page"),
            Blocks =
            [
                CardBlock.Of(CardBlock.Theme, look.Key),
                CardBlock.Of(CardBlock.Theme, _shader.Key),
                .. Shown(),
            ],
        };

        return CardPage.Render(
            shown, shown.Title, 0, downloadPath: null,
            fontBase: PageAssets.WebFontBase, still: true);
    }

    /// <summary>
    /// Enough of a page for a thumbnail to be worth looking at.
    /// </summary>
    /// <remarks>
    /// Their own words come first, because a look is a decision about <i>their</i> page. But a page
    /// that is one heading long makes five identical thumbnails — the look is carried by body text
    /// beside a heading beside a labelled fact, and with none of those on screen there is nothing to
    /// choose between. So what they have written is topped up until there is a page to judge.
    /// </remarks>
    private IEnumerable<CardBlock> Shown()
    {
        var shown = OwnCard.ForPublish(_doc).Blocks
            .Where(b => b.Kind is CardBlock.Text or CardBlock.Heading or CardBlock.KeyValue)
            .Take(3)
            .ToList();

        foreach (var filler in Filler)
        {
            if (shown.Count >= 3) break;
            if (shown.Any(b => b.Kind == filler.Kind)) continue;
            shown.Add(filler);
        }

        return shown;
    }

    private static readonly CardBlock[] Filler =
    [
        CardBlock.Of(CardBlock.Text, "A few lines about what you do, in your own words."),
        CardBlock.Of(CardBlock.Heading, "Where to find me"),
        CardBlock.Of(CardBlock.KeyValue, "Open = Mon to Sat"),
    ];

    // ─── Publishing ─────────────────────────────────────────────────────────────

    private async Task Publish()
    {
        if (_busy || _name.Length == 0) return;

        _busy = true;
        _said = "";
        StateHasChanged();

        try
        {
            Save();
            var address = await Mesh.PublishAsync(_name);

            if (address is null)
            {
                _said = "Could not put it on the mesh. Nothing was lost — try again.";
                return;
            }

            _live = true;
            await Done.InvokeAsync();
        }
        catch (Exception ex)
        {
            _said = ex.Message;
        }
        finally
        {
            _busy = false;
        }
    }

    // ─── Reading a block at a glance ────────────────────────────────────────────

    /// <summary>What a closed panel says about itself.</summary>
    /// <remarks>
    /// A row of panels labelled only by kind — "Words", "Words", "Detail" — is a filing cabinet with
    /// no labels on the drawers. The content is the label.
    /// </remarks>
    private static string Summary(CardBlock block)
    {
        if (block.Kind == CardBlock.List)
        {
            var lines = (block.Items ?? []).Where(i => !string.IsNullOrWhiteSpace(i)).ToArray();
            return lines.Length == 0 ? "Empty" : string.Join(" · ", lines.Take(2));
        }

        if (block.Kind == CardBlock.Tip)
            return CardBlock.IsUsableTip(block.Target) ? CardBlock.TipHost(block.Target) : "Not set";

        if (block.Kind == CardBlock.Rule) return "A break";

        if (block.Kind == CardBlock.Index)
        {
            var plates = (block.Items ?? []).Where(i => !string.IsNullOrWhiteSpace(i)).ToArray();
            return plates.Length == 0 ? "Empty" : $"{plates.Length} lines";
        }

        if (block.Kind == CardBlock.Image)
            return CardBlock.IsUsableAssetHash(block.ContentHash)
                ? block.Value is { Length: > 0 } what ? what.Trim() : "A picture"
                : "None chosen";

        return string.IsNullOrWhiteSpace(block.Value) ? "Empty" : Plainly(block.Value.Trim());
    }

    /// <summary>The words of a piece of writing, without the marks around them.</summary>
    /// <remarks>
    /// A summary is a glance, and a glance at <c>**a car**d</c> is a glance at something that looks
    /// broken. The marks are how a card stores emphasis; nobody has to look at them.
    /// </remarks>
    private static string Plainly(string said)
    {
        var plain = new StringBuilder(said.Length);

        for (var i = 0; i < said.Length; i++)
        {
            // [the words](where they go) reads as the words.
            if (said[i] == ']' && i + 1 < said.Length && said[i + 1] == '(')
            {
                var ends = said.IndexOf(')', i + 2);
                if (ends > 0) { i = ends; continue; }
            }

            if (said[i] is '*' or '_' or '[') continue;

            plain.Append(said[i]);
        }

        return plain.ToString();
    }
}
