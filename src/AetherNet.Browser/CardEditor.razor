    private const string Wide = "wide";



    /// <summary>
    /// The name, typed in the block rather than in the basics.
    /// </summary>
    /// <remarks>
    /// Both places set the same thing. The page's name is metadata — a deck, an address bar and a
    /// file name all use it — and the block is what a reader sees, so they may never disagree.
    /// </remarks>
    private void OnName(int index, ChangeEventArgs e)
    {
        if (index < 0 || index >= _doc.Blocks.Count) return;

        var said = e.Value?.ToString();
        _doc.Blocks[index].Value = said;
        _doc.Title = said ?? "";
        Save();
    }

    /// <summary>Whether the page is opened up to show how it is made.</summary>
    private bool _under;

    /// <summary>The four things the toolbar does, named because a lambda cannot hold a literal.</summary>
    private const string Bold = "bold";

    private const string Italic = "italic";


    private const string AsLink = "link";


    /// <summary>Where that link is going, as typed or as picked.</summary>
    private string _linkTo = "";




    /// <summary>
    /// Bold, italic or underline on whatever the writer has selected.
    /// </summary>
    /// <remarks>
    /// The work happens in the field, and the words come back through <see cref="Wrote"/> like any
    /// other keystroke — so there is one path into the document rather than two, and a mark applied
    /// by a button is indistinguishable from a mark somebody typed.
    /// </remarks>
    private async Task Mark(int index, string how)
    {
        try
        {
            await JS.InvokeAsync<bool>("aetherWrite.mark", index.ToString(), how, null);
        }
        catch (Exception)
        {
            // No writing surface on this head. The field is still a field and the words still save.
        }
    }

    /// <summary>
    /// Put a link on the selected words.
    /// </summary>
    /// <remarks>
    /// Checked here as well as when the page is drawn. The renderer refuses anything that is not a
    /// mesh address or an https one — but a person who pastes something else deserves to find that
    /// out while they are writing, not by looking at the page afterwards and wondering.
    /// </remarks>
    private async Task Link(int index)
    {
        var to = _linkTo.Trim();
        if (to.Length == 0) return;

        if (!CardBlock.IsMeshAddress(to) && !CardBlock.IsUsableWeb(to))
        {
            _linkTo = to.StartsWith("http://", StringComparison.OrdinalIgnoreCase)
                ? "https://" + to["http://".Length..]
                : to.Contains('.') && !to.Contains(' ') ? "https://" + to : to;

            if (!CardBlock.IsUsableWeb(_linkTo)) return;
            to = _linkTo;
        }

        try
        {
            await JS.InvokeAsync<bool>("aetherWrite.mark", index.ToString(), AsLink, to);
            _linkTo = "";
        }
        catch (Exception)
        {
            // Same as above: without the surface there is nothing to attach a link to.
        }
    }






    private void Add(string kind)
    {
        if (kind == CardBlock.Image && _doc.Blocks.Count(b => b.Kind == CardBlock.Image) >= PagePhoto.MostPerPage)
        {
            _said = $"That is {PagePhoto.MostPerPage} pictures — as many as a page carries. Every one is another wait for whoever opens it on the slow radio.";
            return;
        }

        OwnCard.Add(_doc, kind);
        Save();
    }



    // ─── Keeping it ─────────────────────────────────────────────────────────────

    /// <summary>
    /// Written on every keystroke, deliberately.
    /// </summary>
    /// <remarks>
    /// There is no save button and nothing to lose. A page is a few hundred bytes of JSON into this
    /// device's own database; writing it constantly costs nothing, and somebody closing the screen
    /// having forgotten to press something costs them the page. Saving is not publishing — this only
    /// moves the draft, and the copy other people can read is untouched until they say so.
    /// </remarks>
    private void Save()
    {
        if (_name.Length == 0) return;

        // A page comes into existence when it is given a name a reader would see — not when somebody
        // taps through a look. Tapping through used to leave a nameless draft behind on every pass,
        // and drafts of nothing are what a person's list of pages fills up with.
        if (_page is null && string.IsNullOrWhiteSpace(_doc.Title)) { Draw(); return; }

        _page ??= new WebCard();
        _page.Name = _name;
        _page.Doc = _doc;

        Mine.Save(_page);
        _page = Mine.Get(_name) ?? _page;
        _doc = _page.Doc;
        _live = _page.Live;
        Draw();
    }

    /// <summary>
    /// The preview is the renderer a stranger's phone uses, and the document it will actually receive.
    /// </summary>
    /// <remarks>
    /// Drawn from the published form, not from the draft. A template arrives as a shape with its
    /// values blank, and showing those blanks here would tell the author their page has empty boxes on
    /// it — which is the opposite of what a reader sees, and would send them off filling in fields
    /// nobody was ever going to read.
    /// </remarks>
    private void Draw() =>
        _preview = CardPage.Render(
            OwnCard.ForPublish(_doc), _doc.Title, 0,
            downloadPath: null, assetPath: Picture, fontBase: PageAssets.WebFontBase);

    /// <summary>A picture this editor already holds, as something the preview can draw.</summary>
    private string? Picture(string hash) => _pics.GetValueOrDefault(hash);


    /// <summary>
    /// Enough of a page for a thumbnail to be worth looking at.
    /// </summary>
    /// <remarks>
    /// Their own words come first, because a look is a decision about <i>their</i> page. But a page
    /// that is one heading long makes five identical thumbnails — the look is carried by body text
    /// beside a heading beside a labelled fact, and with none of those on screen there is nothing to
    /// choose between. So what they have written is topped up until there is a page to judge.
    /// </remarks>
    private IEnumerable<CardBlock> Shown()
    {
        var shown = OwnCard.ForPublish(_doc).Blocks
            .Where(b => b.Kind is CardBlock.Text or CardBlock.Heading or CardBlock.KeyValue)
            .Take(3)
            .ToList();

        foreach (var filler in Filler)
        {
            if (shown.Count >= 3) break;
            if (shown.Any(b => b.Kind == filler.Kind)) continue;
            shown.Add(filler);
        }

        return shown;
    }

    private static readonly CardBlock[] Filler =
    [
        CardBlock.Of(CardBlock.Text, "A few lines about what you do, in your own words."),
        CardBlock.Of(CardBlock.Heading, "Where to find me"),
        CardBlock.Of(CardBlock.KeyValue, "Open = Mon to Sat"),
    ];

    // ─── Publishing ─────────────────────────────────────────────────────────────

    private async Task Publish()
    {
        if (_busy || _name.Length == 0) return;

        _busy = true;
        _said = "";
        StateHasChanged();

        try
        {
            Save();
            var address = await Mesh.PublishAsync(_name);

            if (address is null)
            {
                _said = "Could not put it on the mesh. Nothing was lost — try again.";
                return;
            }

            _live = true;
            await Done.InvokeAsync();
        }
        catch (Exception ex)
        {
            _said = ex.Message;
        }
        finally
        {
            _busy = false;
        }
    }

    // ─── Reading a block at a glance ────────────────────────────────────────────


