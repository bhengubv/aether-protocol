@implements IDisposable
@inject MeshWebService Mesh
@inject IJSRuntime JS

<PageTitle>Aether — AetherNet</PageTitle>

@* An AetherNet tab is a browser and a workshop. Browse is somebody else's tag; Mine is what this
   phone answers with. Separated because they are different jobs, and a person doing one of them
   should not be reading the other. *@
<div class="browser">
    <div class="where @(_view == View.Edit ? "away" : null)">
        <button class="seg @(_view == View.Browse ? "on" : null)" @onclick="() => Show(View.Browse)">Browse</button>
        <button class="seg @(_view == View.Mine ? "on" : null)" @onclick="() => Show(View.Mine)">Mine</button>
        <button class="seg @(_view == View.Deck ? "on" : null)" @onclick="() => Show(View.Deck)">
            Deck@(Mesh.Deck.Count > 0 ? $" · {Mesh.Deck.Count}" : "")
        </button>
    </div>

@if (_took is { Length: > 0 })
{
    <div class="took">@_took</div>
}

@if (_view == View.Edit)
{
    @* The editor, hosted rather than navigated to. The browser owns its own views, so writing a page
       is somewhere you are inside this component rather than a route its host has to know about. *@
    <CardEditor Name="@_editing" Done="Edited" @key="@("edit:" + (_editing ?? "new"))" />
}
else if (_view == View.Deck)
{
    @* Cards other people wrote, held here. A card is an object: it opens with no signal, with its
       author asleep or gone, and it can be handed on to somebody who has never met them — who still
       checks it against the author's own key, not against ours. *@
    <div class="mine">
        <p class="lede">Cards people gave you. They open with no signal and no author — and you can hand any of them on.</p>

        @if (Mesh.Deck.Count == 0)
        {
            <div class="empty">
                <span class="empty-t">Nothing yet</span>
                <span class="empty-s">Open somebody's address and you keep their card. Stand next to them and they can hand you one.</span>
            </div>
        }

        @foreach (var held in Mesh.Deck.All)
        {
            <div class="held">
                <button class="rmain" @onclick="@(() => Go(held.Address))">
                    <span class="rtitle">@(held.Title is { Length: > 0 } t ? t : held.Name)</span>
                    <span class="raddr">@held.Address.Replace("aether://", "")</span>
                    <span class="by">by @held.AuthorTag@(held.GotFrom is { Length: > 0 } f && f != held.AuthorTag ? $" · from {f}" : "")</span>
                </button>
                <div class="hacts">
                    <button class="hact" disabled="@(!Mesh.RadioLinked || _busy)" @onclick="@(() => Give(held.Address))">Give</button>
                    <button class="hact drop" @onclick="@(() => Drop(held.Address))">Let go</button>
                </div>
            </div>
        }
    </div>
}
else if (_view == View.Mine)
{
    <div class="mine">
        <p class="lede">Your AetherTag is your domain. Every page below is a path under it, served off this phone — nobody issued it, so nobody can take it back.</p>

        @foreach (var card in Mesh.Mine.All)
        {
            <div class="row">
                <button class="rmain" @onclick="@(() => Go(Mesh.Address(card.Name)))">
                    <span class="rtitle">@(string.IsNullOrWhiteSpace(card.Doc.Title) ? card.Name : card.Doc.Title)</span>
                    <span class="raddr">@(Mesh.LocalTag + "/" + card.Name)</span>
                    <span class="rstate @(card.Live ? "live" : "draft")">@(card.Live ? "published" : "draft")</span>
                </button>
                <div class="hacts">
                    <button class="redit" @onclick="@(() => Edit(card.Name))">Edit</button>
                    @if (card.Live)
                    {
                        <button class="hact" disabled="@(!Mesh.RadioLinked || _busy)" @onclick="@(() => Give(Mesh.Address(card.Name)))">Give</button>
                    }
                </div>
            </div>
        }

        <button class="new" disabled="@Mesh.Mine.Full" @onclick="@(() => Edit(null))">
            <span class="plus">+</span>
            <span class="ntext">
                <span class="nt">Create a web card</span>
                <span class="ns">Four steps. Pick a look, write it, publish it.</span>
            </span>
        </button>

        @if (Mesh.Mine.Full)
        {
            <p class="lede">That is as many pages as one device offers.</p>
        }
    </div>
}
else
{
    <div class="omnibox">
        <span class="lock" aria-hidden="true">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round"><rect x="5" y="11" width="14" height="9" rx="2"/><path d="M8 11V8a4 4 0 0 1 8 0v3"/></svg>
        </span>
        <span class="scheme">aether://</span>
        <input class="addr" @bind="_address" @bind:event="oninput" @onkeydown="OnKey"
               placeholder="tag / name" spellcheck="false" autocapitalize="off" />
        <button class="go" disabled="@_busy" @onclick="Typed" aria-label="Go">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
        </button>
    </div>

    <div class="tabs">
        @foreach (var name in Mesh.Pages)
        {
            <button class="bm @(_address == $"{Mesh.LocalTag}/{name}" ? "on" : null)" @onclick="@(() => Go(Mesh.Address(name)))">@name</button>
        }
        @foreach (var card in Mesh.Deck.All)
        {
            <button class="bm saved @(_address == TrimScheme(card.Address) ? "on" : null)" @onclick="@(() => Go(card.Address))">🔖 @(card.Title is { Length: > 0 } t ? t : card.Name)</button>
        }
        @if (Mesh.PeerSiteAddress is { } peer && !Mesh.Deck.Holds(peer))
        {
            <button class="bm peer" @onclick="@(() => Go(peer))">★ nearby phone</button>
        }
    </div>

    <div class="page">
        @if (_page is { Ok: true } p)
        {
            @* One renderer, not two.

               This drew the blocks itself in Blazor — a second implementation of the card model that
               had to be kept in step with the real one by hand, and never was: four block kinds were
               added and this silently drew none of them. It renders the same document CardPage
               produces now, so what an author sees in the editor, what a stranger gets on a tap, and
               what a reader sees here are the same bytes.

               An iframe because a card is a page and should own its whole surface — its own ground,
               its own typeface, its own measure — rather than inheriting this app's. Nothing in it
               can reach anywhere: the document declares default-src 'none' for itself. *@
            <iframe class="page" title="@(p.Card?.Title ?? p.Name)" srcdoc="@_html"
                    style="@($"height:{_tall}px")" @ref="_frame" @key="p.Address"></iframe>

            <div class="siteinfo">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="5" y="11" width="14" height="9" rx="2"/><path d="M8 11V8a4 4 0 0 1 8 0v3"/></svg>
                @if (p.Own)
                {
                    <span>your page · <span class="mono">@p.AuthorTag</span></span>
                }
                else
                {
                    <span>signed by <span class="mono">@p.AuthorTag</span></span>
                    @if (p.Remote)
                    {
                        <span class="air">· fetched over @Mesh.RadioName</span>
                    }
                    else
                    {
                        <span class="offline">· saved offline</span>
                    }
                }
            </div>
        }
        else if (_page is { Ok: false } f)
        {
            <div class="err">Couldn't reach <span class="mono">@f.Address</span><br />@f.Error</div>
        }
        else
        {
            <div class="muted">Resolving…</div>
        }
    </div>
}
</div>

@code {
    private string _address = "";
    private MeshWebService.MeshPage? _page;
    private bool _busy;
    private bool _autoOpened;
    /// <summary>
    /// What the browser is showing. Its own state, never a route.
    /// </summary>
    /// <remarks>
    /// A component that navigated would need its host to own URLs for the browser's insides — which
    /// is exactly the coupling that stops the same component being one tab here and a whole
    /// application somewhere else. Nothing in this library knows what a route is.
    /// </remarks>
    private enum View { Browse, Mine, Deck, Edit }

    private View _view;
    private string _took = "";
    private string? _editing;
    private string _html = "";
    private int _tall = 520;
    private DotNetObjectReference<AetherBrowser>? _me;
    private ElementReference? _frame;

    /// <summary>Artwork the page needs, as data it can draw without fetching anything.</summary>
    private string? Picture(string hash) => _assets.GetValueOrDefault(hash);

    /// <summary>
    /// Where the browser starts. A host that has just published something can open on the deck.
    /// </summary>
    [Parameter] public string? Start { get; set; }

    /// <summary>
    /// An address to open instead of this device's own front door.
    /// </summary>
    /// <remarks>
    /// For a host that already knows where the reader wants to go — a card somebody tapped over, an
    /// address off a link. Checked on the way in like any other, so a host cannot hand the browser
    /// somewhere off the mesh either.
    /// </remarks>
    [Parameter] public string? Open { get; set; }

    /// <summary>
    /// Raised with the address of whatever card is open, whenever it changes.
    /// </summary>
    /// <remarks>
    /// For a host that wants to do something with it — hand it to a phone you have touched, put it in
    /// a recents list, show it in a title bar. The browser does not care whether anybody listens.
    /// </remarks>
    [Parameter] public EventCallback<string> OnReading { get; set; }

    /// <summary>
    /// Artwork already assembled, by content hash. Held here rather than fetched during render because
    /// a picture may still be arriving over the radio, and a card must draw immediately either way.
    /// </summary>
    private readonly Dictionary<string, string> _assets = new(StringComparer.Ordinal);

    /// <summary>
    /// The card's own colour, applied to the card and nothing else.
    ///
    /// <para>
    /// A card is a blob from a stranger, so its accent is untrusted input written into a style
    /// attribute — the one place a card gets anywhere near CSS. It is admitted only as a plain hex
    /// colour, and it sets a variable the card's own rules read, so the worst a hostile card can do
    /// is choose an ugly colour for itself. Anything else, and the card keeps the app's blue.
    /// </para>
    /// </summary>
    private static string Dress(CardDocument? card)
    {
        var colour = card?.Blocks
            .FirstOrDefault(b => b.Kind == CardBlock.Theme && CardBlock.IsUsableAccent(b.Value))?.Value;

        // The look, on the other hand, is not untrusted: a card names one by key and an unknown key
        // falls back to the default, so the font stacks written here are always our own. Applying them
        // is what makes the choice somebody made in the editor mean anything to a reader — without it
        // every page on the mesh comes out in the same typeface whatever its author picked.
        var look = CardLook.FromCard(card);
        var dress = $"--card-display:{look.Display};--card-body:{look.Body}";

        return colour is null ? dress : $"--card-accent:{colour};{dress}";
    }

    /// <summary>The label half of a labelled fact — everything before the equals sign.</summary>
    private static string Label(string? value)
    {
        if (string.IsNullOrWhiteSpace(value)) return "";

        var cut = value.IndexOf('=');
        return (cut < 0 ? value : value[..cut]).Trim();
    }

    /// <summary>And what it says — everything after.</summary>
    private static string Said(string? value)
    {
        if (string.IsNullOrWhiteSpace(value)) return "";

        var cut = value.IndexOf('=');
        return cut < 0 ? "" : value[(cut + 1)..].Trim();
    }

    /// <summary>
    /// Draw the open card, with whatever pictures have arrived.
    /// </summary>
    /// <remarks>
    /// Fonts are linked rather than embedded here: this page is drawn inside the app, where the
    /// typefaces are already on the device. A card leaving the device carries its own copy, because
    /// the phone it lands on has no way to fetch one.
    /// </remarks>
    private void Draw() =>
        _html = _page is { Ok: true, Card: { } card }
            ? CardPage.Render(
                card, card.Title, 0, downloadPath: null,
                assetPath: Picture, fontBase: PageAssets.WebFontBase)
            : "";

    /// <summary>
    /// A card asked to be followed. Checked again here, because being rendered proves nothing.
    /// </summary>
    [JSInvokable]
    public Task Follow(string address) =>
        address.StartsWith("aether://", StringComparison.OrdinalIgnoreCase)
            ? InvokeAsync(() => Go(address))
            : Task.CompletedTask;

    /// <summary>
    /// A card said how tall it is, so it can be given exactly that much room.
    /// </summary>
    /// <remarks>
    /// Scrolling inside a fixed box is the difference between a web page and a widget, and it is the
    /// difference a reader feels first. The value is bounded on the way in — a page claiming to be
    /// enormous is a page that makes the app unusable.
    /// </remarks>
    [JSInvokable]
    public Task Grew(int px)
    {
        // Zero means "nothing to measure yet" — keep what we had rather than collapsing the page.
        if (px <= 0) return Task.CompletedTask;

        var wanted = Math.Clamp(px, 240, 20000);
        if (wanted == _tall) return Task.CompletedTask;

        _tall = wanted;
        return InvokeAsync(StateHasChanged);
    }

    /// <summary>The colour this card's masthead is painted in.</summary>
    /// <remarks>
    /// The card's own accent where it declared one, the look's colour otherwise — never a value from
    /// anywhere else. It is handed to a shader as a uniform, and it has already been through
    /// <see cref="CardBlock.IsUsableAccent"/>, so what reaches the GPU is six hexadecimal digits.
    /// </remarks>
    private static string Paint(CardDocument? card) =>
        card?.Blocks.FirstOrDefault(b => b.Kind == CardBlock.Theme && CardBlock.IsUsableAccent(b.Value))?.Value
        ?? CardLook.FromCard(card).Accent;

    /// <summary>
    /// How this page folds, as a number.
    /// </summary>
    /// <remarks>
    /// A number rather than the title, so the only things the shader is ever handed are a validated
    /// colour and an integer. A card is a blob written by a stranger, and the less of it that reaches
    /// anything executable, the fewer ways there are to be wrong about escaping.
    /// </remarks>
    private static int Seed(string? title, string? name)
    {
        var hash = 2166136261u;

        foreach (var c in (title is { Length: > 0 } ? title : name) ?? "")
        {
            hash ^= c;
            hash *= 16777619;
        }

        return (int)(hash % 100000);
    }

    /// <summary>The single character the masthead is built around.</summary>
    private static string Mark(string? title, string? name)
    {
        foreach (var source in new[] { title, name })
            foreach (var c in source ?? "")
                if (char.IsLetterOrDigit(c))
                    return char.ToUpperInvariant(c).ToString();

        return "A";
    }

    /// <summary>
    /// Paint whatever plate is now on screen.
    /// </summary>
    /// <remarks>
    /// After the render rather than during it, because the shader sizes itself from the element the
    /// browser has already laid out. Failures are swallowed: a card that could not be painted is a
    /// card drawn flat, which is a look, not a fault.
    /// </remarks>
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        try
        {
            if (firstRender)
            {
                _me ??= DotNetObjectReference.Create(this);
                await JS.InvokeVoidAsync("aetherCardHost.listen", _me, nameof(Follow), nameof(Grew));
            }

            // And ask, rather than only waiting to be told. A message that never arrives looks
            // exactly like a page that happens to be the default height, so the browser measures the
            // frame itself after every render — pictures arriving late are covered by the message.
            if (_frame is { } frame && _html.Length > 0)
                await Grew(await JS.InvokeAsync<int>("aetherCardHost.fit", frame));
        }
        catch (Exception)
        {
            // No host script on this head. Cards still render; their links simply do nothing and the
            // page keeps the height it was given — the safe way round.
        }
    }

    /// <summary>
    /// Pull in any picture this card names. Runs after the page is already on screen, so the card is
    /// readable while its artwork is still crossing the radio.
    /// </summary>
    private async Task LoadArtAsync(CardDocument? card)
    {
        if (card is null) return;

        foreach (var hash in card.Blocks
            .Where(b => b.Kind == CardBlock.Image)
            .Select(b => b.ContentHash)
            .Where(h => h is not null && !_assets.ContainsKey(h))
            .Distinct(StringComparer.Ordinal)
            .ToArray())
        {
            if (await Mesh.AssetAsync(hash) is { } uri)
            {
                _assets[hash!] = uri;
                Draw();
                StateHasChanged();
            }
        }
    }

    /// <summary>
    /// May this card send the reader somewhere? Only to another card on the mesh.
    /// <para>
    /// The card is a blob written by a stranger, so its link targets are untrusted input. An
    /// <c>http</c> or <c>javascript</c> target would turn a card into a way to reach out of the mesh
    /// — exactly what publishing cards as inert JSON instead of HTML exists to prevent. Anything that
    /// is not an <c>aether://</c> address is drawn as plain text and goes nowhere.
    /// </para>
    /// </summary>
    private static bool IsMeshAddress(string? target) =>
        !string.IsNullOrWhiteSpace(target) &&
        target.StartsWith("aether://", StringComparison.OrdinalIgnoreCase);

    private void Show(View view) { _view = view; _took = ""; }

    /// <summary>Open the editor on a page, or on a new one.</summary>
    private void Edit(string? name)
    {
        _editing = name;
        _view = View.Edit;
        _took = "";
    }

    /// <summary>The editor is finished. Back to the person's own pages.</summary>
    private void Edited()
    {
        _editing = null;
        _view = View.Mine;
    }

    /// <summary>
    /// Hand a card to whoever is standing next to us.
    /// </summary>
    private async Task Give(string address)
    {
        _took = await Mesh.GiveAsync(address)
            ? "Handed over. They have it now — it is theirs, and they can pass it on."
            : "Nobody is linked right now.";

        StateHasChanged();
    }

    /// <summary>Let a card go from this phone. Everyone else who holds it still does.</summary>
    private void Drop(string address)
    {
        Mesh.Deck.Drop(address);
        _took = "Let go. It is still on every other phone that holds it.";
    }

    /// <summary>
    /// Somebody handed us one.
    /// </summary>
    /// <remarks>
    /// Opening it is what takes it into the deck — and opening is fetch-and-verify, so an offer from
    /// a stranger is a reason to look rather than a reason to believe. A card that fails its own
    /// signature simply never lands.
    /// </remarks>
    private void OnOffered(string address) => _ = InvokeAsync(async () =>
    {
        await Go(address);

        if (_page is { Ok: true })
        {
            _view = View.Deck;
            _took = "Somebody handed you a card. It is yours now.";
        }

        StateHasChanged();
    });

    protected override async Task OnInitializedAsync()
    {
        Mesh.Changed += OnChanged;
        Mesh.Mine.Changed += OnChanged;
        Mesh.Deck.Changed += OnChanged;
        Mesh.Offered += OnOffered;

        // Somebody has just published. They are sent back to the list of their own pages, not to a
        // browser pointed at a stranger.
        _view = Start switch
        {
            "mine" => View.Mine,
            "deck" => View.Deck,
            _ => View.Browse,
        };

        await Mesh.EnsureReadyAsync();

        // A host may have opened the browser pointed at something — a card somebody just handed over,
        // an address off a tap. Told, not fetched: the browser has no idea what the host is doing.
        await Go(Open is { Length: > 0 } wanted ? wanted : Mesh.HomeAddress);
        if (Mesh.RadioAvailable && !Mesh.RadioLinked)
            Mesh.LinkRadio();
    }

    private void OnChanged() => _ = InvokeAsync(async () =>
    {
        if (!_autoOpened && !_busy && Mesh.PeerSiteAddress is { } peer)
        {
            _autoOpened = true;
            await Go(peer);
        }
        StateHasChanged();
    });

    /// <summary>Follow whatever is typed in the address bar.</summary>
    private async Task Typed()
        => await Go("aether://" + _address.Trim().TrimStart('/'));

    private async Task Go(string address)
    {
        if (_busy) return;
        _busy = true;
        StateHasChanged();
        try
        {
            _page = await Mesh.OpenAsync(address);
            _address = TrimScheme(address);
            _tall = 520;
            Draw();

            if (OnReading.HasDelegate) await OnReading.InvokeAsync(address);
        }
        finally
        {
            _busy = false;
        }

        await LoadArtAsync(_page?.Card);
    }

    private async Task OnKey(KeyboardEventArgs e)
    {
        if (e.Key == "Enter") await Typed();
    }

    private static string TrimScheme(string a) =>
        a.StartsWith("aether://", StringComparison.OrdinalIgnoreCase) ? a["aether://".Length..] : a;

    public void Dispose()
    {
        // Stop answering for a page that is no longer open.
        Mesh.Changed -= OnChanged;
        Mesh.Mine.Changed -= OnChanged;
        Mesh.Deck.Changed -= OnChanged;
        Mesh.Offered -= OnOffered;
        _me?.Dispose();
    }
}
