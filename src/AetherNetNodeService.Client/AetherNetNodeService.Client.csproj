<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- Shipped inside one of the packaging/ bundles, not as a package of its own. -->
    <IsPackable>false</IsPackable>
    <TargetFrameworks>net9.0;net10.0</TargetFrameworks>
    <RootNamespace>AetherNetNodeService.Client</RootNamespace>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <Description>The consumer-side client for the Aether Node Service: the detect -> install -> bind lifecycle (NodeBinder), and the integrity-checked package sources (INodePackageSource, HttpNodePackageSource, SHA-256 fingerprint verification) an app uses to obtain and install the node when it is missing. Every install path verifies before it installs. See docs/aether-node-service.md.</Description>
    <PackageTags>mesh;aether;node;bind;install;client</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../AetherNetNodeService/AetherNetNodeService.csproj" />
    <!-- NodeBackedMessaging answers an app's IMessagingService through the node, so an app keeps its own
         messaging code while the node does the radios and the keys. -->
    <ProjectReference Include="../AetherNet.Messaging/AetherNet.Messaging.csproj" />
    <ProjectReference Include="../AetherNet.Mesh/AetherNet.Mesh.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="AetherNetNodeService.Client.Tests" />
    <InternalsVisibleTo Include="AetherNetNodeService.Pipe.Tests" />
  </ItemGroup>

</Project>
