<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net9.0;net10.0</TargetFrameworks>
    <RootNamespace>AetherNet.Storage</RootNamespace>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <Description>Persistence layer for the Aether mesh networking protocol. Provides a generic key-value store abstraction with file-system and in-memory implementations, plus file-backed reference implementations of IRouteStore, IDtnBundleStore, and IMessageStore. No external storage dependencies — hosts that want SQLite or other databases ship their own adapters.</Description>
    <PackageTags>mesh;storage;persistence;key-value;aether;routing;dtn;encryption-at-rest</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.2" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../AetherNet.Core/AetherNet.Core.csproj" />
    <ProjectReference Include="../AetherNet.Messaging/AetherNet.Messaging.csproj" />
    <ProjectReference Include="../AetherNet.Security/AetherNet.Security.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="AetherNet.Core.Tests" />
  </ItemGroup>

</Project>
