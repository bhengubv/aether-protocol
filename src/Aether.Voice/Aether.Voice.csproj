<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>AetherMesh.Voice</RootNamespace>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <Description>Voice call signaling and frame transport for the Aether mesh networking protocol. Provides the call state machine, signaling-packet schema, frame metadata, jitter buffer, and codec abstraction. Host applications supply the actual codec implementation (Opus, Speex, etc.) via IVoiceCodec.</Description>
    <PackageTags>mesh;voice;voip;aether;call;audio;jitter-buffer;opus;speex</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.2" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../Aether.Core/Aether.Core.csproj" />
  </ItemGroup>

</Project>
