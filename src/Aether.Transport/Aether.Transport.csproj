<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>AetherMesh.Transport</RootNamespace>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <Description>Transport abstraction layer for the Aether mesh networking protocol. Defines ITransport, ITransportManager, and the in-process simulation transport; platform-specific BLE/Wi-Fi Direct/NearLink transports are supplied by the host application.</Description>
    <PackageTags>mesh;transport;networking;aether;ble;wifi-direct;nearlink;simulation</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.2" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../Aether.Core/Aether.Core.csproj" />
  </ItemGroup>

</Project>
