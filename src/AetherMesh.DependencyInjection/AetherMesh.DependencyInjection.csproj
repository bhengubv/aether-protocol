<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>AetherMesh.DependencyInjection</RootNamespace>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <Description>One-call DI registration and health checks for the Aether mesh networking protocol stack. Hosts call services.AddAetherMeshProtocol(...) to wire routing, DTN, Signal Protocol, and messaging — opt-in per capability.</Description>
    <PackageTags>mesh;di;dependency-injection;aether;aspnetcore;extensions;health-checks;signal-protocol;dtn;routing</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.2" />
    <PackageReference Include="Microsoft.Extensions.Options" Version="10.0.2" />
    <PackageReference Include="Microsoft.Extensions.Diagnostics.HealthChecks.Abstractions" Version="10.0.2" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.2" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../AetherMesh.Core/AetherMesh.Core.csproj" />
    <ProjectReference Include="../AetherMesh.Security/AetherMesh.Security.csproj" />
    <ProjectReference Include="../AetherMesh.Messaging/AetherMesh.Messaging.csproj" />
    <ProjectReference Include="../AetherMesh.Transport/AetherMesh.Transport.csproj" />
    <ProjectReference Include="../AetherMesh.Storage/AetherMesh.Storage.csproj" />
    <ProjectReference Include="../AetherMesh.Streaming/AetherMesh.Streaming.csproj" />
    <ProjectReference Include="../AetherMesh.Voice/AetherMesh.Voice.csproj" />
    <ProjectReference Include="../AetherMesh.Content/AetherMesh.Content.csproj" />
    <ProjectReference Include="../AetherMesh.Space/AetherMesh.Space.csproj" />
    <ProjectReference Include="../AetherMesh.Forge/AetherMesh.Forge.csproj" />
    <ProjectReference Include="../AetherMesh.Vault/AetherMesh.Vault.csproj" />
    <ProjectReference Include="../AetherMesh.Market/AetherMesh.Market.csproj" />
  </ItemGroup>

</Project>
