<Project Sdk="Microsoft.NET.Sdk">

  <!-- AetherNetService is a MAUI app, built the way Aether is: one project, a head for each system. The service and
       the app that asks it must be the same split on every system — on Android the app binds to it, on Windows it
       will reach it by a named pipe — and only that pipe differs. It has no pages: a screen is attack surface. -->
  <PropertyGroup>
    <TargetFrameworks>net10.0-android</TargetFrameworks>
    <OutputType>Exe</OutputType>
    <UseMaui>true</UseMaui>
    <SingleProject>true</SingleProject>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <RootNamespace>AetherNetService</RootNamespace>

    <!-- AetherNetService is its own installed app, with its own identity and package — distinct from any
         consumer app (the AetherNet sample is com.bhengubv.aethernet). One device, one node. The package name
         must never change: the phones that have it keep their AetherTag only while it is the same app. -->
    <ApplicationId>com.bhengubv.aethernetservice</ApplicationId>
    <ApplicationDisplayVersion>1.0</ApplicationDisplayVersion>
    <ApplicationVersion>1</ApplicationVersion>
    <SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">24.0</SupportedOSPlatformVersion>
  </PropertyGroup>

  <PropertyGroup Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">
    <RuntimeIdentifiers>android-arm64</RuntimeIdentifiers>
  </PropertyGroup>

  <!-- AetherNetService wears Aether's logo. The two drawings are Aether's own, used from where they live rather
       than copied; the ground colour must stay the same as Aether's MauiIcon. With no launcher entry, the icon
       shows wherever the phone names the app — App info, its permission page, the list of apps. -->
  <ItemGroup>
    <MauiIcon Include="..\..\samples\AetherNet.Sample\AetherNet.Sample\Resources\AppIcon\appicon.svg"
              ForegroundFile="..\..\samples\AetherNet.Sample\AetherNet.Sample\Resources\AppIcon\appiconfg.svg"
              Color="#16232f" />
  </ItemGroup>

  <!-- A Release build is signed with The Geek Network's key, or it is not a release: with no signing set, the SDK
       quietly signs with the debug key and the package installs, runs and can be shipped nowhere. An apk, as for
       Aether — the phones this is for install from a file, and an aab Install uninstalls first, which would take
       this device's identity with it. The password is never written here and never set machine-wide: Visual
       Studio's Archive signs with the key it manages, a one-off command line passes it with -p: (or sets
       ANDROID_KEYSTORE_PASS in that shell only), and CI reads it from its secret store. Debug never touches it. -->
  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <AndroidPackageFormat>apk</AndroidPackageFormat>
    <AndroidKeyStore>true</AndroidKeyStore>
    <AndroidSigningKeyStore>$(USERPROFILE)\AppData\Local\Xamarin\Mono for Android\Keystore\TheGeekAlias\TheGeekAlias.keystore</AndroidSigningKeyStore>
    <AndroidSigningKeyAlias>TheGeekAlias</AndroidSigningKeyAlias>
    <AndroidSigningKeyPass>$(ANDROID_KEYSTORE_PASS)</AndroidSigningKeyPass>
    <AndroidSigningStorePass>$(ANDROID_KEYSTORE_PASS)</AndroidSigningStorePass>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../AetherNetNodeService.Android/AetherNetNodeService.Android.csproj" />
    <ProjectReference Include="../AetherNetNodeService.Host/AetherNetNodeService.Host.csproj" />
    <ProjectReference Include="../AetherNet.Security/AetherNet.Security.csproj" />
    <ProjectReference Include="../AetherNet.Core/AetherNet.Core.csproj" />
    <!-- The mesh the node now hosts: the portable radio mesh + messaging core, and the Android radios that
         fill its transport seam. DTN and the routing/identity contracts come transitively through these
         (DtnService lives in AetherNet.Core; the storage backing it is AetherNet.Storage). -->
    <ProjectReference Include="../AetherNet.Mesh/AetherNet.Mesh.csproj" />
    <ProjectReference Include="../AetherNet.Transport.Android/AetherNet.Transport.Android.csproj" />
    <ProjectReference Include="../AetherNet.Messaging/AetherNet.Messaging.csproj" />
    <ProjectReference Include="../AetherNet.Storage/AetherNet.Storage.csproj" />
  </ItemGroup>

  <!-- The same MAUI as Aether, at the same version. -->
  <ItemGroup>
    <PackageReference Include="Microsoft.Maui.Controls" Version="$(MauiVersion)" />
  </ItemGroup>

  <!-- The node mints and signs with the same NSec/libsodium the sample uses, so it needs the same real
       Android libsodium.so — the libsodium NuGet ships no working Android native. Reuse the sample's own
       arm64-v8a build (ISC-licensed; see that project's Platforms/Android/native/README.md) rather than
       copying the binary. Without this, GetTag/Sign fail at runtime on the phone. -->
  <ItemGroup Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">
    <PackageReference Include="libsodium" Version="1.0.20.1" ExcludeAssets="native" />
    <AndroidNativeLibrary Include="..\..\samples\AetherNet.Sample\AetherNet.Sample\Platforms\Android\native\arm64-v8a\libsodium.so">
      <Abi>arm64-v8a</Abi>
    </AndroidNativeLibrary>
  </ItemGroup>

</Project>
