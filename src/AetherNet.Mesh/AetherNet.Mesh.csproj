<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- Shipped inside one of the packaging/ bundles, not as a package of its own. -->
    <IsPackable>false</IsPackable>
    <TargetFrameworks>net9.0;net10.0</TargetFrameworks>
    <RootNamespace>AetherNet.Mesh</RootNamespace>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <Description>Portable mesh implementation for the Aether protocol: the over-the-air radio-mesh abstraction (IRadioMesh), packet sender/router shims, wire framing and rotating-address wire resolution, link liveness/quality, send-lane prioritisation, the Circle recognition + proxy directories, and the per-call media cipher — all platform-neutral. The radio mesh (RadioMesh) is here too; each host adds its own radios (AetherNet.Transport.Android, AetherNet.Transport.Windows).</Description>
    <PackageTags>mesh;aether;radio;wifi-direct;ble;routing;framing;e2e-encryption</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.12" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../AetherNet.Core/AetherNet.Core.csproj" />
    <ProjectReference Include="../AetherNet.Security/AetherNet.Security.csproj" />
    <ProjectReference Include="../AetherNet.Messaging/AetherNet.Messaging.csproj" />
    <!-- The radio mesh itself (RadioMesh) runs over the protocol's transports: the Wi-Fi/LAN transport, the relay, and
         the choice of which linked radio carries (RadioChoice). A host adds its own radios on top. -->
    <ProjectReference Include="../AetherNet.Transport/AetherNet.Transport.csproj" />
    <!-- RadioMeshLink implements AetherNet.Browser's IMeshLink. AetherNet.Browser is a Razor class
         library targeting net10.0 only, so it is referenced only for the net10.0 build and
         RadioMeshLink is compiled only there (guarded with #if NET10_0_OR_GREATER). -->
    <ProjectReference Include="../AetherNet.Browser/AetherNet.Browser.csproj" Condition="'$(TargetFramework)' == 'net10.0'" />
  </ItemGroup>

</Project>
