<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net9.0;net10.0</TargetFrameworks>
    <RootNamespace>AetherMesh.Content</RootNamespace>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <Description>Chunked content distribution and integrity verification for the Aether mesh networking protocol. Splits files into SHA-256-addressed chunks, ships them via ChunkRequest/ChunkData packets, and verifies each chunk and the root descriptor against published hashes.</Description>
    <PackageTags>mesh;content;chunked;distribution;sha256;aether;file-sharing;integrity-verification</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.2" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../AetherMesh.Core/AetherMesh.Core.csproj" />
  </ItemGroup>

</Project>
