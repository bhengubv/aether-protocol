<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- Shipped inside one of the packaging/ bundles, not as a package of its own. -->
    <IsPackable>false</IsPackable>
    <TargetFrameworks>net9.0;net10.0</TargetFrameworks>
    <RootNamespace>AetherNet.BitTorrent.Gateway</RootNamespace>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <Description>Gateway bridging external BitTorrent swarms into the AetherNet mesh: translates BitTorrent (SHA-1) pieces to AetherNet SHA-256 content chunks and back, so an internet-connected node can ingest a torrent and re-seed it to offline peers over the mesh chunk protocol.</Description>
    <PackageTags>bittorrent;aether;mesh;gateway;content;bridge;sha256;sha1</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../AetherNet.BitTorrent/AetherNet.BitTorrent.csproj" />
    <ProjectReference Include="../AetherNet.Content/AetherNet.Content.csproj" />
  </ItemGroup>

</Project>
