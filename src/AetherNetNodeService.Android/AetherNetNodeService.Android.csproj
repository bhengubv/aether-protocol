<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- Shipped inside one of the packaging/ bundles, not as a package of its own. -->
    <IsPackable>false</IsPackable>
    <TargetFrameworks>net9.0-android;net10.0-android</TargetFrameworks>
    <RootNamespace>AetherNetNodeService.Android</RootNamespace>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <SupportedOSPlatformVersion>24.0</SupportedOSPlatformVersion>
    <Description>The Android binding for the Aether Node Service: an exported bound Service that hosts the one IAetherNodeClient and answers consumer apps over an Android binder — the system identifies the caller (Binder.CallingUid) so the per-app grant cannot be spoofed, and the private key never crosses. Ships the consumer-side connector, client proxy and package installer that implement AetherNetNodeService.Client's platform seams. See docs/aether-node-service.md §7.</Description>
    <PackageTags>mesh;aether;node;android;ipc;bind;service</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../AetherNetNodeService/AetherNetNodeService.csproj" />
    <ProjectReference Include="../AetherNetNodeService.Host/AetherNetNodeService.Host.csproj" />
    <ProjectReference Include="../AetherNetNodeService.Client/AetherNetNodeService.Client.csproj" />
    <ProjectReference Include="../AetherNetNodeService.Ipc/AetherNetNodeService.Ipc.csproj" />
  </ItemGroup>

</Project>
