<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net9.0;net10.0</TargetFrameworks>
    <RootNamespace>AetherNet</RootNamespace>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <Description>Core protocol library for the Aether mesh networking protocol. Provides MeshPacket, packet serialization, AODV routing contracts, DTN store-and-forward contracts, transport abstractions, and the incentive/feature-flag extension seams.</Description>
    <PackageTags>mesh;networking;protocol;aether;routing;dtn;signal-protocol;x25519;ed25519;ble;wifi-direct</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.2" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.2" />
  </ItemGroup>

</Project>
