<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net9.0;net10.0</TargetFrameworks>
    <RootNamespace>AetherMesh.Space</RootNamespace>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <Description>Geo-pinned community noticeboards (aether-space Phase-2 extension). Nodes drop breadcrumbs at geohash coordinates; passing devices auto-pull and re-host them for other passersby. All propagation is fully offline — no internet required.</Description>
    <PackageTags>mesh;geo;geohash;noticeboard;breadcrumb;space;aether;offline;community</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../AetherMesh.Core/AetherMesh.Core.csproj" />
    <ProjectReference Include="../AetherMesh.Content/AetherMesh.Content.csproj" />
  </ItemGroup>

</Project>
