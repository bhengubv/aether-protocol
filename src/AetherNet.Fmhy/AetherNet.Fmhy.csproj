<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- Shipped inside one of the packaging/ bundles, not as a package of its own. -->
    <IsPackable>false</IsPackable>
    <TargetFrameworks>net9.0;net10.0</TargetFrameworks>
    <RootNamespace>AetherNet.Fmhy</RootNamespace>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <Description>FMHY catalogue integration for the Aether protocol — bundles and propagates the Free Media Heck Yeah directory over the mesh, enabling offline content discovery without internet access.</Description>
    <PackageTags>mesh;fmhy;catalogue;content;discovery;offline;p2p;aether</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../AetherNet.Core/AetherNet.Core.csproj" />
  </ItemGroup>

</Project>
