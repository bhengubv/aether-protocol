<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <RootNamespace>Aether.Transport.Windows</RootNamespace>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <AllowUnsafeBlocks>false</AllowUnsafeBlocks>
    <Description>Windows BLE GATT transport for the Aether mesh protocol. Uses WinRT Windows.Devices.Bluetooth APIs to act as a BLE central connecting to Aether-compatible peripherals (phones, Pi nodes).</Description>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../Aether.Transport/Aether.Transport.csproj" />
    <ProjectReference Include="../Aether.Core/Aether.Core.csproj" />
    <ProjectReference Include="../Aether.DependencyInjection/Aether.DependencyInjection.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.2" />
  </ItemGroup>

</Project>
