<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Aether.DependencyInjection</RootNamespace>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <Description>One-call DI registration and health checks for the Aether mesh networking protocol stack. Hosts call services.AddAetherProtocol(...) to wire routing, DTN, Signal Protocol, and messaging — opt-in per capability.</Description>
    <PackageTags>mesh;di;dependency-injection;aether;aspnetcore;extensions;health-checks;signal-protocol;dtn;routing</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.2" />
    <PackageReference Include="Microsoft.Extensions.Options" Version="10.0.2" />
    <PackageReference Include="Microsoft.Extensions.Diagnostics.HealthChecks.Abstractions" Version="10.0.2" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.2" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../Aether.Core/Aether.Core.csproj" />
    <ProjectReference Include="../Aether.Security/Aether.Security.csproj" />
    <ProjectReference Include="../Aether.Messaging/Aether.Messaging.csproj" />
    <ProjectReference Include="../Aether.Transport/Aether.Transport.csproj" />
    <ProjectReference Include="../Aether.Storage/Aether.Storage.csproj" />
    <ProjectReference Include="../Aether.Streaming/Aether.Streaming.csproj" />
    <ProjectReference Include="../Aether.Voice/Aether.Voice.csproj" />
    <ProjectReference Include="../Aether.Content/Aether.Content.csproj" />
    <ProjectReference Include="../Aether.Space/Aether.Space.csproj" />
    <ProjectReference Include="../Aether.Forge/Aether.Forge.csproj" />
    <ProjectReference Include="../Aether.Vault/Aether.Vault.csproj" />
    <ProjectReference Include="../Aether.Market/Aether.Market.csproj" />
  </ItemGroup>

</Project>
