<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- Shipped inside one of the packaging/ bundles, not as a package of its own. -->
    <IsPackable>false</IsPackable>
    <TargetFrameworks>net9.0;net10.0</TargetFrameworks>
    <RootNamespace>AetherNetNodeService.Host</RootNamespace>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <Description>The reference in-process host for the Aether Node Service: AetherNodeService adapts the device's INodeIdentity, a messaging seam and a presence seam to the IAetherNodeClient bind contract, with AddAetherNode() DI and an in-memory grant store. A cross-process (Android AIDL) host wraps this same object. See docs/aether-node-service.md.</Description>
    <PackageTags>mesh;aether;node;identity;host;bind;service</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.12" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../AetherNetNodeService/AetherNetNodeService.csproj" />
    <ProjectReference Include="../AetherNet.Core/AetherNet.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="AetherNetNodeService.Host.Tests" />
  </ItemGroup>


  <!-- The services that joined from the Aether app. .NET 10 only, as they were there: the service and the app that
       use them are .NET 10, and nothing on .NET 9 does. These are the references they had in the app. -->
  <ItemGroup Condition="'$(TargetFramework)' == 'net9.0'">
    <Compile Remove="Services/**;Data/**" />
  </ItemGroup>
  <ItemGroup Condition="'$(TargetFramework)' == 'net10.0'">
    <ProjectReference Include="../AetherNet.BitTorrent/AetherNet.BitTorrent.csproj" />
    <ProjectReference Include="../AetherNet.BitTorrent.Gateway/AetherNet.BitTorrent.Gateway.csproj" />
    <ProjectReference Include="../AetherNet.Browser/AetherNet.Browser.csproj" />
    <ProjectReference Include="../AetherNet.Cards/AetherNet.Cards.csproj" />
    <ProjectReference Include="../AetherNet.Cartography/AetherNet.Cartography.csproj" />
    <ProjectReference Include="../AetherNet.Content/AetherNet.Content.csproj" />
    <ProjectReference Include="../AetherNet.Content.Sqlite/AetherNet.Content.Sqlite.csproj" />
    <ProjectReference Include="../AetherNet.Fmhy/AetherNet.Fmhy.csproj" />
    <ProjectReference Include="../AetherNet.Forge/AetherNet.Forge.csproj" />
    <ProjectReference Include="../AetherNet.Map/AetherNet.Map.csproj" />
    <ProjectReference Include="../AetherNet.Market/AetherNet.Market.csproj" />
    <ProjectReference Include="../AetherNet.Mesh/AetherNet.Mesh.csproj" />
    <ProjectReference Include="../AetherNet.Messaging/AetherNet.Messaging.csproj" />
    <ProjectReference Include="../AetherNet.Security/AetherNet.Security.csproj" />
    <ProjectReference Include="../AetherNet.Space/AetherNet.Space.csproj" />
    <ProjectReference Include="../AetherNet.Storage/AetherNet.Storage.csproj" />
    <ProjectReference Include="../AetherNet.Streaming/AetherNet.Streaming.csproj" />
    <ProjectReference Include="../AetherNet.Tipping/AetherNet.Tipping.csproj" />
    <ProjectReference Include="../AetherNet.Transport/AetherNet.Transport.csproj" />
    <ProjectReference Include="../AetherNet.Vault/AetherNet.Vault.csproj" />
    <ProjectReference Include="../AetherNet.Voice/AetherNet.Voice.csproj" />
    <ProjectReference Include="../AetherNetNodeService.Client/AetherNetNodeService.Client.csproj" />
    <!-- The menu (NodeOp), which NodeAnswers answers for these classes. -->
    <ProjectReference Include="../AetherNetNodeService.Ipc/AetherNetNodeService.Ipc.csproj" />
    <PackageReference Include="Microsoft.AspNetCore.Components.Web" Version="10.0.0" />
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.12" />
    <PackageReference Include="SQLitePCLRaw.bundle_e_sqlite3" Version="3.0.5" />
    <PackageReference Include="QRCoder" Version="1.6.0" />
    <PackageReference Include="Concentus" Version="2.2.2" />
  </ItemGroup>

</Project>
