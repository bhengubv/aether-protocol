<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- Shipped inside one of the packaging/ bundles, not as a package of its own. -->
    <IsPackable>false</IsPackable>
    <TargetFrameworks>net9.0;net10.0</TargetFrameworks>
    <RootNamespace>AetherNet.Map.Sqlite</RootNamespace>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <Description>Durable, queryable on-device SQLite store for AetherNet.Map. Backs IMapStore with a Microsoft.Data.Sqlite database — one row per map feature, the merge-authoritative CRDT state as a blob, and a geohash range index for fast proximity queries. Kept as a separate package so the AetherNet.Map core stays dependency-free and portable to the other 7 languages.</Description>
    <PackageTags>mesh;map;sqlite;crdt;geohash;offline;aether</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../AetherNet.Map/AetherNet.Map.csproj" />
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.12" />
    <!-- SQLite >= 3.50.2, which is the patched engine CVE-2025-6965 was waiting on. -->
    <PackageReference Include="SQLitePCLRaw.bundle_e_sqlite3" Version="3.0.5" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.12" />
  </ItemGroup>

  <!-- CVE-2025-6965 / GHSA-2m69-gcr7-jv3q was suppressed here for as long as SQLitePCLRaw shipped no bundle with a
       patched SQLite: every lib.e_sqlite3 up to 2.1.11 was affected, and the bug needs attacker-controlled SQL to
       reach, which this store never executes. The bundle has since shipped one. The suppression is gone with it,
       because a suppression that outlives its advisory is a place a real warning goes to die. -->

</Project>
