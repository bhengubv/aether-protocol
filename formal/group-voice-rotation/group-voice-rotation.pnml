<?xml version="1.0" encoding="UTF-8"?>
<pnml xmlns="http://www.pnml.org/version-2009/grammar/pnml">
  <net id="group-voice-rotation" type="http://www.pnml.org/version-2009/grammar/ptnet">
    <name><text>Group Voice Key Rotation</text></name>
    <page id="page-main">
      <place id="P_GroupKey_v1"><initialMarking><text>1</text></initialMarking></place>
      <place id="P_GroupKey_v2"><initialMarking><text>0</text></initialMarking></place>
      <place id="P_MemberLeaveEvent"><initialMarking><text>0</text></initialMarking></place>
      <place id="P_LeftMember_HasOldKey"><initialMarking><text>0</text></initialMarking></place>

      <transition id="T_MemberLeaves"/>
      <arc id="A1" source="T_MemberLeaves" target="P_MemberLeaveEvent"><inscription><text>1</text></inscription></arc>

      <transition id="T_CompromiseV1"/>
      <arc id="A2" source="P_GroupKey_v1" target="T_CompromiseV1"><inscription><text>1</text></inscription></arc>
      <arc id="A3" source="T_CompromiseV1" target="P_GroupKey_v1"><inscription><text>1</text></inscription></arc>
      <arc id="A4" source="T_CompromiseV1" target="P_LeftMember_HasOldKey"><inscription><text>1</text></inscription></arc>

      <transition id="T_RotateKey"/>
      <arc id="A5" source="P_MemberLeaveEvent" target="T_RotateKey"><inscription><text>1</text></inscription></arc>
      <arc id="A6" source="P_GroupKey_v1" target="T_RotateKey"><inscription><text>1</text></inscription></arc>
      <arc id="A7" source="T_RotateKey" target="P_GroupKey_v2"><inscription><text>1</text></inscription></arc>
    </page>
  </net>
</pnml>
