<?xml version="1.0" encoding="UTF-8"?>
<pnml xmlns="http://www.pnml.org/version-2009/grammar/pnml">
  <net id="forge-integrity" type="http://www.pnml.org/version-2009/grammar/ptnet">
    <name><text>Forge Hash Integrity</text></name>
    <page id="page-main">

      <place id="P_OriginalPkg"><initialMarking><text>1</text></initialMarking></place>
      <place id="P_Fetched"><initialMarking><text>0</text></initialMarking></place>
      <place id="P_HashVerified"><initialMarking><text>0</text></initialMarking></place>
      <place id="P_Cached"><initialMarking><text>0</text></initialMarking></place>
      <place id="P_TamperDetected"><initialMarking><text>0</text></initialMarking></place>

      <transition id="T_Fetch"/>
      <arc id="A1" source="P_OriginalPkg" target="T_Fetch"><inscription><text>1</text></inscription></arc>
      <arc id="A2" source="T_Fetch" target="P_OriginalPkg"><inscription><text>1</text></inscription></arc>
      <arc id="A3" source="T_Fetch" target="P_Fetched"><inscription><text>1</text></inscription></arc>

      <transition id="T_VerifyOK"/>
      <arc id="A4" source="P_Fetched" target="T_VerifyOK"><inscription><text>1</text></inscription></arc>
      <arc id="A5" source="T_VerifyOK" target="P_HashVerified"><inscription><text>1</text></inscription></arc>

      <transition id="T_TamperVerifyFail"/>
      <arc id="A6" source="P_Fetched" target="T_TamperVerifyFail"><inscription><text>1</text></inscription></arc>
      <arc id="A7" source="T_TamperVerifyFail" target="P_TamperDetected"><inscription><text>1</text></inscription></arc>

      <transition id="T_Cache"/>
      <arc id="A8" source="P_HashVerified" target="T_Cache"><inscription><text>1</text></inscription></arc>
      <arc id="A9" source="T_Cache" target="P_Cached"><inscription><text>1</text></inscription></arc>

    </page>
  </net>
</pnml>
