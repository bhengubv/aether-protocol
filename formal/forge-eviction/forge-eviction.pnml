<?xml version="1.0" encoding="UTF-8"?>
<pnml xmlns="http://www.pnml.org/version-2009/grammar/pnml">
  <net id="forge-eviction" type="http://www.pnml.org/version-2009/grammar/ptnet">
    <name><text>Forge Cache LRU</text></name>
    <page id="page-main">

      <place id="P_CacheSlotsFree"><initialMarking><text>2</text></initialMarking></place>
      <place id="P_Pkg1_Cached"><initialMarking><text>0</text></initialMarking></place>
      <place id="P_Pkg2_Cached"><initialMarking><text>0</text></initialMarking></place>
      <place id="P_Pkg3_Cached"><initialMarking><text>0</text></initialMarking></place>

      <transition id="T_CachePkg1"/>
      <arc id="A1" source="P_CacheSlotsFree" target="T_CachePkg1"><inscription><text>1</text></inscription></arc>
      <arc id="A2" source="T_CachePkg1" target="P_Pkg1_Cached"><inscription><text>1</text></inscription></arc>

      <transition id="T_CachePkg2"/>
      <arc id="A3" source="P_CacheSlotsFree" target="T_CachePkg2"><inscription><text>1</text></inscription></arc>
      <arc id="A4" source="T_CachePkg2" target="P_Pkg2_Cached"><inscription><text>1</text></inscription></arc>

      <transition id="T_CachePkg3_EvictsPkg1"/>
      <arc id="A5" source="P_Pkg1_Cached" target="T_CachePkg3_EvictsPkg1"><inscription><text>1</text></inscription></arc>
      <arc id="A6" source="T_CachePkg3_EvictsPkg1" target="P_Pkg3_Cached"><inscription><text>1</text></inscription></arc>

      <transition id="T_CachePkg3_EvictsPkg2"/>
      <arc id="A7" source="P_Pkg2_Cached" target="T_CachePkg3_EvictsPkg2"><inscription><text>1</text></inscription></arc>
      <arc id="A8" source="T_CachePkg3_EvictsPkg2" target="P_Pkg3_Cached"><inscription><text>1</text></inscription></arc>

    </page>
  </net>
</pnml>
