<?xml version="1.0" encoding="UTF-8"?>
<pnml xmlns="http://www.pnml.org/version-2009/grammar/pnml">
  <net id="multi-device-sync" type="http://www.pnml.org/version-2009/grammar/ptnet">
    <name><text>Multi-Device PreKey Sync</text></name>
    <page id="page-main">

      <place id="P_D1_HasKey"><initialMarking><text>1</text></initialMarking></place>
      <place id="P_D2_HasKey"><initialMarking><text>0</text></initialMarking></place>
      <place id="P_D3_HasKey"><initialMarking><text>0</text></initialMarking></place>
      <place id="P_Sync_to_D2"><initialMarking><text>0</text></initialMarking></place>
      <place id="P_Sync_to_D3"><initialMarking><text>0</text></initialMarking></place>

      <transition id="T_D1_Broadcast"/>
      <arc id="A1" source="P_D1_HasKey" target="T_D1_Broadcast"><inscription><text>1</text></inscription></arc>
      <arc id="A2" source="T_D1_Broadcast" target="P_D1_HasKey"><inscription><text>1</text></inscription></arc>
      <arc id="A3" source="T_D1_Broadcast" target="P_Sync_to_D2"><inscription><text>1</text></inscription></arc>
      <arc id="A4" source="T_D1_Broadcast" target="P_Sync_to_D3"><inscription><text>1</text></inscription></arc>

      <transition id="T_D2_Apply"/>
      <arc id="A5" source="P_Sync_to_D2" target="T_D2_Apply"><inscription><text>1</text></inscription></arc>
      <arc id="A6" source="T_D2_Apply" target="P_D2_HasKey"><inscription><text>1</text></inscription></arc>

      <transition id="T_D3_Apply"/>
      <arc id="A7" source="P_Sync_to_D3" target="T_D3_Apply"><inscription><text>1</text></inscription></arc>
      <arc id="A8" source="T_D3_Apply" target="P_D3_HasKey"><inscription><text>1</text></inscription></arc>

    </page>
  </net>
</pnml>
