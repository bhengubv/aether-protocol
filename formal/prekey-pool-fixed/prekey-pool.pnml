<?xml version="1.0" encoding="UTF-8"?>
<!--
  Pre-Key Pool — Fixed Model with Inhibitor Arcs
  Atomic consume-and-refill at threshold guarantees Pool >= 1.
  SPDX-License-Identifier: MIT
-->
<pnml xmlns="http://www.pnml.org/version-2009/grammar/pnml">
  <net id="prekey-pool-fixed" type="http://www.pnml.org/version-2009/grammar/ptnet">
    <name><text>Pre-Key Pool Fixed</text></name>
    <page id="page-main">

      <place id="P_Pool"><initialMarking><text>4</text></initialMarking></place>

      <!-- T_Consume_Safe: Pool >= 2 to fire (consume 1, produce nothing).
           Modelled via input weight 2, output weight 1 (test arc + consume) -->
      <transition id="T_Consume_Safe"/>
      <arc id="A1" source="P_Pool" target="T_Consume_Safe">
        <inscription><text>2</text></inscription>
      </arc>
      <arc id="A2" source="T_Consume_Safe" target="P_Pool">
        <inscription><text>1</text></inscription>
      </arc>

      <!-- T_Consume_LowAtomicRefill: fires when Pool < 2 (inhibitor).
           Atomically consumes 1 and refills 3 (net: +2 to Pool, restoring to 3+). -->
      <transition id="T_Consume_LowAtomicRefill"/>
      <arc id="A3" source="P_Pool" target="T_Consume_LowAtomicRefill" type="inhibitor">
        <inscription><text>2</text></inscription>
      </arc>
      <arc id="A4" source="P_Pool" target="T_Consume_LowAtomicRefill">
        <inscription><text>1</text></inscription>
      </arc>
      <arc id="A5" source="T_Consume_LowAtomicRefill" target="P_Pool">
        <inscription><text>3</text></inscription>
      </arc>

    </page>
  </net>
</pnml>
