<?xml version="1.0" encoding="UTF-8"?>
<pnml xmlns="http://www.pnml.org/version-2009/grammar/pnml">
  <net id="voice-jitter" type="http://www.pnml.org/version-2009/grammar/ptnet">
    <name><text>Voice Jitter Buffer</text></name>
    <page id="page-main">
      <place id="P_PacketInOrder"><initialMarking><text>3</text></initialMarking></place>
      <place id="P_Buffer"><initialMarking><text>0</text></initialMarking></place>
      <place id="P_Played"><initialMarking><text>0</text></initialMarking></place>
      <place id="P_LatePacket"><initialMarking><text>0</text></initialMarking></place>
      <place id="P_Discarded"><initialMarking><text>0</text></initialMarking></place>

      <transition id="T_Buffer"/>
      <arc id="A1" source="P_PacketInOrder" target="T_Buffer"><inscription><text>1</text></inscription></arc>
      <arc id="A2" source="T_Buffer" target="P_Buffer"><inscription><text>1</text></inscription></arc>

      <transition id="T_Play"/>
      <arc id="A3" source="P_Buffer" target="T_Play"><inscription><text>1</text></inscription></arc>
      <arc id="A4" source="T_Play" target="P_Played"><inscription><text>1</text></inscription></arc>

      <transition id="T_DiscardLate"/>
      <arc id="A5" source="P_LatePacket" target="T_DiscardLate"><inscription><text>1</text></inscription></arc>
      <arc id="A6" source="T_DiscardLate" target="P_Discarded"><inscription><text>1</text></inscription></arc>
    </page>
  </net>
</pnml>
