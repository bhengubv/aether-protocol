<?xml version="1.0" encoding="UTF-8"?>
<!-- SOS Flood — termination + coverage -->
<pnml xmlns="http://www.pnml.org/version-2009/grammar/pnml">
  <net id="sos-flood" type="http://www.pnml.org/version-2009/grammar/ptnet">
    <name><text>SOS Flood</text></name>
    <page id="page-main">

      <place id="P_SosToN1"><initialMarking><text>1</text></initialMarking></place>
      <place id="P_SosToN2"><initialMarking><text>0</text></initialMarking></place>
      <place id="P_SosToN3"><initialMarking><text>0</text></initialMarking></place>
      <place id="P_TTL"><initialMarking><text>3</text></initialMarking></place>

      <place id="P_N1_Alerted"><initialMarking><text>0</text></initialMarking></place>
      <place id="P_N2_Alerted"><initialMarking><text>0</text></initialMarking></place>
      <place id="P_N3_Alerted"><initialMarking><text>0</text></initialMarking></place>

      <transition id="T_N1_ReceiveAndForward"/>
      <arc id="A1" source="P_SosToN1" target="T_N1_ReceiveAndForward"><inscription><text>1</text></inscription></arc>
      <arc id="A2" source="P_TTL" target="T_N1_ReceiveAndForward"><inscription><text>1</text></inscription></arc>
      <arc id="A3" source="T_N1_ReceiveAndForward" target="P_N1_Alerted"><inscription><text>1</text></inscription></arc>
      <arc id="A4" source="T_N1_ReceiveAndForward" target="P_SosToN2"><inscription><text>1</text></inscription></arc>

      <transition id="T_N2_ReceiveAndForward"/>
      <arc id="A5" source="P_SosToN2" target="T_N2_ReceiveAndForward"><inscription><text>1</text></inscription></arc>
      <arc id="A6" source="P_TTL" target="T_N2_ReceiveAndForward"><inscription><text>1</text></inscription></arc>
      <arc id="A7" source="T_N2_ReceiveAndForward" target="P_N2_Alerted"><inscription><text>1</text></inscription></arc>
      <arc id="A8" source="T_N2_ReceiveAndForward" target="P_SosToN3"><inscription><text>1</text></inscription></arc>

      <transition id="T_N3_ReceiveOnly"/>
      <arc id="A9" source="P_SosToN3" target="T_N3_ReceiveOnly"><inscription><text>1</text></inscription></arc>
      <arc id="A10" source="P_TTL" target="T_N3_ReceiveOnly"><inscription><text>1</text></inscription></arc>
      <arc id="A11" source="T_N3_ReceiveOnly" target="P_N3_Alerted"><inscription><text>1</text></inscription></arc>

    </page>
  </net>
</pnml>
