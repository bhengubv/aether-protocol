{
  "metadata": [
    {
      "src": [
        {
          "files": [
            "src/AetherMesh.Core/AetherMesh.Core.csproj",
            "src/AetherMesh.Security/AetherMesh.Security.csproj",
            "src/AetherMesh.Messaging/AetherMesh.Messaging.csproj",
            "src/AetherMesh.Storage/AetherMesh.Storage.csproj",
            "src/AetherMesh.Transport/AetherMesh.Transport.csproj",
            "src/AetherMesh.Streaming/AetherMesh.Streaming.csproj",
            "src/AetherMesh.Voice/AetherMesh.Voice.csproj",
            "src/AetherMesh.Content/AetherMesh.Content.csproj",
            "src/AetherMesh.DependencyInjection/AetherMesh.DependencyInjection.csproj",
            "src/AetherMesh.Space/AetherMesh.Space.csproj",
            "src/AetherMesh.Forge/AetherMesh.Forge.csproj",
            "src/AetherMesh.Vault/AetherMesh.Vault.csproj",
            "src/AetherMesh.Market/AetherMesh.Market.csproj"
          ],
          "exclude": [
            "**/bin/**",
            "**/obj/**"
          ]
        }
      ],
      "dest": "docs/api",
      "outputFormat": "mref",
      "includePrivateMembers": false,
      "disableGitFeatures": false,
      "disableDefaultFilter": false,
      "noRestore": false,
      "filter": "filterConfig.yml",
      "memberLayout": "samePage",
      "EnumSortOrder": "alphabetic",
      "allowCompilationErrors": false
    }
  ],
  "build": {
    "content": [
      {
        "files": [
          "index.md",
          "toc.yml",
          "articles/**.md",
          "articles/**/toc.yml"
        ],
        "src": "docs"
      },
      {
        "files": [
          "api/**.yml",
          "api/index.md"
        ],
        "src": "docs"
      }
    ],
    "resource": [
      {
        "files": [
          "images/**"
        ],
        "src": "docs"
      }
    ],
    "overwrite": [],
    "globalMetadata": {
      "_appTitle": "Aether Protocol",
      "_appName": "Aether Protocol",
      "_appFooter": "&copy; 2026 The Other Bhengu (Pty) Ltd t/a The Geek. MIT licensed.",
      "_enableSearch": true,
      "_disableContribution": false,
      "_gitContribute": {
        "repo": "https://github.com/bhengubv/aether-protocol",
        "branch": "main"
      },
      "_appLogoPath": "images/logo.svg"
    },
    "dest": "_site",
    "globalMetadataFiles": [],
    "fileMetadataFiles": [],
    "template": [
      "default",
      "modern"
    ],
    "postProcessors": [],
    "keepFileLink": false,
    "disableGitFeatures": false
  }
}
