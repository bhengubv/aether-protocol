{
  "metadata": [
    {
      "src": [
        {
          "files": [
            "src/AetherNet.Core/AetherNet.Core.csproj",
            "src/AetherNet.Security/AetherNet.Security.csproj",
            "src/AetherNet.Messaging/AetherNet.Messaging.csproj",
            "src/AetherNet.Storage/AetherNet.Storage.csproj",
            "src/AetherNet.Transport/AetherNet.Transport.csproj",
            "src/AetherNet.Streaming/AetherNet.Streaming.csproj",
            "src/AetherNet.Voice/AetherNet.Voice.csproj",
            "src/AetherNet.Content/AetherNet.Content.csproj",
            "src/AetherNet.DependencyInjection/AetherNet.DependencyInjection.csproj",
            "src/AetherNet.Space/AetherNet.Space.csproj",
            "src/AetherNet.Forge/AetherNet.Forge.csproj",
            "src/AetherNet.Vault/AetherNet.Vault.csproj",
            "src/AetherNet.Market/AetherNet.Market.csproj"
          ],
          "exclude": [
            "**/bin/**",
            "**/obj/**"
          ]
        }
      ],
      "dest": "docs/api",
      "outputFormat": "mref",
      "includePrivateMembers": false,
      "disableGitFeatures": false,
      "disableDefaultFilter": false,
      "noRestore": false,
      "filter": "filterConfig.yml",
      "memberLayout": "samePage",
      "EnumSortOrder": "alphabetic",
      "allowCompilationErrors": false
    }
  ],
  "build": {
    "content": [
      {
        "files": [
          "index.md",
          "toc.yml",
          "articles/**.md",
          "articles/**/toc.yml"
        ],
        "src": "docs"
      },
      {
        "files": [
          "api/**.yml",
          "api/index.md"
        ],
        "src": "docs"
      }
    ],
    "resource": [
      {
        "files": [
          "images/**"
        ],
        "src": "docs"
      }
    ],
    "overwrite": [],
    "globalMetadata": {
      "_appTitle": "Aether Protocol",
      "_appName": "Aether Protocol",
      "_appFooter": "&copy; 2026 The Other Bhengu (Pty) Ltd t/a The Geek. MIT licensed.",
      "_enableSearch": true,
      "_disableContribution": false,
      "_gitContribute": {
        "repo": "https://github.com/bhengubv/aether-protocol",
        "branch": "main"
      },
      "_appLogoPath": "images/logo.svg"
    },
    "dest": "_site",
    "globalMetadataFiles": [],
    "fileMetadataFiles": [],
    "template": [
      "default",
      "modern"
    ],
    "postProcessors": [],
    "keepFileLink": false,
    "disableGitFeatures": false
  }
}
