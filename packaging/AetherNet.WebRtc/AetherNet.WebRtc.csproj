<Project Sdk="Microsoft.NET.Sdk">

  <!--
    The WebRTC transport, which nothing else in AetherNet references. Its own package because it brings
    SIPSorcery with it, and somebody who only wants to send a message over Bluetooth should not have to
    carry a media stack to do it.
  -->

  <PropertyGroup>
    <TargetFrameworks>net9.0;net10.0</TargetFrameworks>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>true</IsPackable>
    <Description>AetherNet.WebRtc — a WebRTC transport for AetherNet, over SIPSorcery. Optional.</Description>
    <PackageTags>aethernet;webrtc;transport;sipsorcery</PackageTags>

    <!-- The whole point: the assemblies of the referenced projects travel inside this package's lib/ folder, so one
         reference brings the lot. The projects stay exactly as they are; only the shape on NuGet changes.

         Only the ones named here, though. A project reference drags its own references along, so without this an
         optional bundle would carry a second copy of AetherNet.Core and a consumer who installed both would have
         the same assembly twice. The optional ones depend on AetherNet instead, and carry only what is theirs. -->
    <CarriedNames>;AetherNet.Transport.WebRtc;</CarriedNames>
    <TargetsForTfmSpecificBuildOutput>$(TargetsForTfmSpecificBuildOutput);CarryTheReferencedAssemblies</TargetsForTfmSpecificBuildOutput>
  </PropertyGroup>

  <Target Name="CarryTheReferencedAssemblies" DependsOnTargets="ResolveReferences">
    <ItemGroup>
      <_Carried Include="@(ReferenceCopyLocalPaths->WithMetadataValue('ReferenceSourceTarget','ProjectReference'))" />
      <BuildOutputInPackage
        Include="@(_Carried)"
        Condition="$(CarriedNames.Contains(';%(Filename);'))" />
    </ItemGroup>
  </Target>

  <ItemGroup>
    <ProjectReference Include="..\AetherNet\AetherNet.csproj" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\AetherNet.Transport.WebRtc\AetherNet.Transport.WebRtc.csproj" PrivateAssets="all" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="SIPSorcery" Version="10.0.17" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.12" />
  </ItemGroup>

</Project>
