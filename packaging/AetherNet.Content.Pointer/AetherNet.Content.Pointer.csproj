<Project Sdk="Microsoft.NET.Sdk">

  <!--
    AetherNet.Content is no longer a package of its own: its assembly ships inside AetherNet, which is one reference
    instead of thirty-two. This project exists so the id keeps moving anyway — anybody already
    depending on AetherNet.Content gets 3.1.1 and the code they expect, rather than a package that silently stopped
    at 3.0.0 with no upgrade path and no way to tell.

    It carries no lib/ of its own (IncludeBuildOutput=false). The assembly comes from AetherNet and only
    from there, so nothing ever ships twice.

    Named AetherNet.Content.Pointer because NuGet names a project by its PackageId and will not restore a graph holding
    two projects called AetherNet.Content. PackageId puts the real id back on the package.
  -->

  <!--
    AetherNet is referenced as a package rather than a project on purpose: a project reference would drag
    src/AetherNet.Content into this graph and bring the name collision back.
  -->

  <PropertyGroup>
    <TargetFrameworks>net9.0;net10.0</TargetFrameworks>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>true</IsPackable>
    <IncludeBuildOutput>false</IncludeBuildOutput>
    <!-- No assemblies means no symbols: asking for a .snupkg here produces an empty one. -->
    <IncludeSymbols>false</IncludeSymbols>
    <!-- NU5128 says there is a dependency for a framework with no lib/ beside it. That is the whole design of
         this package, so the warning is answered rather than silenced: the assembly is in AetherNet. -->
    <NoWarn>$(NoWarn);NU5128</NoWarn>
    <PackageId>AetherNet.Content</PackageId>
    <AssemblyName>AetherNet.Content.Pointer</AssemblyName>
    <Description>AetherNet.Content now ships inside AetherNet. This package points at it and carries no assemblies of its own; referencing either gives you the same code.</Description>
    <PackageTags>aethernet;mesh;p2p</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="AetherNet" Version="$(Version)" />
  </ItemGroup>

</Project>
