{
  "name": "@bhengubv/aethernet-protocol",
  "version": "1.1.0",
  "description": "TypeScript implementation of the Aether mesh networking protocol — offline-first P2P mesh via BLE, Wi-Fi Direct, LoRa, NFC, NearLink, and cellular relay",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "browser": "./dist/browser/index.js",
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist/",
    "src/",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc && npm run build:browser",
    "build:browser": "esbuild src/browser.ts --bundle --format=esm --platform=browser --outfile=dist/browser/index.js",
    "typecheck:browser": "tsc --noEmit -p tsconfig.browser.json",
    "dev": "tsx src/demo.ts",
    "test": "tsx --test",
    "bench": "tsx benchmarks/bench.ts",
    "clean": "rm -rf dist",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "mesh",
    "networking",
    "p2p",
    "encryption",
    "aether",
    "ble",
    "bluetooth",
    "offline"
  ],
  "author": "The Other Bhengu (Pty) Ltd t/a The Geek Network <engineering@thegeeknetwork.dev>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bhengubv/aether-protocol.git",
    "directory": "typescript"
  },
  "homepage": "https://github.com/bhengubv/aether-protocol#readme",
  "bugs": {
    "url": "https://github.com/bhengubv/aether-protocol/issues"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "dependencies": {
    "@noble/hashes": "^1.3.3",
    "tweetnacl": "^1.0.3",
    "uuid": "^14.0.1",
    "werift": "^0.23.0"
  },
  "devDependencies": {
    "@types/node": "^25.9.2",
    "@types/uuid": "^10.0.0",
    "esbuild": "^0.28.1",
    "fast-check": "^4.8.0",
    "tinybench": "^6.0.2",
    "tsx": "^4.22.4",
    "typescript": "^5.3.3"
  },
  "optionalDependencies": {
    "serialport": "^12.0.0"
  }
}
