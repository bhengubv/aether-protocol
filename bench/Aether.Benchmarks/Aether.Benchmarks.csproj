<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Aether.Benchmarks</RootNamespace>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <IsPackable>false</IsPackable>
    <!-- BenchmarkDotNet auto-spawns a Release-mode child process; running
         under Debug only emits a warning, but we lock to Release here so the
         intent matches the README and CI scripts. -->
    <Configuration Condition="'$(Configuration)' == ''">Release</Configuration>
    <ServerGarbageCollection>true</ServerGarbageCollection>
    <ConcurrentGarbageCollection>true</ConcurrentGarbageCollection>
    <Description>BenchmarkDotNet harness for the Aether crypto and serializer hot paths.</Description>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="BenchmarkDotNet" Version="0.15.8" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../../src/Aether.Core/Aether.Core.csproj" />
    <ProjectReference Include="../../src/Aether.Security/Aether.Security.csproj" />
    <ProjectReference Include="../../src/Aether.Messaging/Aether.Messaging.csproj" />
  </ItemGroup>

</Project>
